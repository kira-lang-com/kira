// The tokens of MSL source.
//
// Every word is a `Word`; the parser tells keywords from names by text, so
// the many contextual words of MSL (`vertex`, `access`, `sample`) need no
// token of their own. `lineStart` marks the first token of a line, which is
// where a `#` opens a directive.

enum TokenKind {
    Word
    IntegerLiteral
    FloatLiteral
    StringLiteral
    CharLiteral

    Hash
    LeftParen
    RightParen
    LeftBrace
    RightBrace
    LeftBracket
    RightBracket
    Semicolon
    Comma
    Dot
    Colon
    ColonColon
    Question
    Tilde
    Bang
    Plus
    Minus
    Star
    Slash
    Percent
    Caret
    Ampersand
    Pipe
    Equals
    Less
    Greater
    PlusPlus
    MinusMinus
    Arrow
    PlusEquals
    MinusEquals
    StarEquals
    SlashEquals
    PercentEquals
    AmpersandEquals
    PipeEquals
    CaretEquals
    LessLessEquals
    GreaterGreaterEquals
    EqualEqual
    BangEqual
    LessEqual
    GreaterEqual
    AmpersandAmpersand
    PipePipe
    LessLess
    GreaterGreater

    Unknown
    End
}

struct Token {
    let kind: TokenKind
    let text: String
    let span: Span
    let lineStart: Bool
}

// The words that never name a declaration.
function isReserved(word: String) -> Bool {
    match word {
        "struct" -> return true
        "class" -> return true
        "union" -> return true
        "enum" -> return true
        "typedef" -> return true
        "using" -> return true
        "namespace" -> return true
        "template" -> return true
        "typename" -> return true
        "const" -> return true
        "constexpr" -> return true
        "constant" -> return true
        "device" -> return true
        "thread" -> return true
        "threadgroup" -> return true
        "static" -> return true
        "inline" -> return true
        "if" -> return true
        "else" -> return true
        "for" -> return true
        "while" -> return true
        "do" -> return true
        "switch" -> return true
        "case" -> return true
        "default" -> return true
        "break" -> return true
        "continue" -> return true
        "return" -> return true
        "true" -> return true
        "false" -> return true
        "static_cast" -> return true
        "reinterpret_cast" -> return true
        "const_cast" -> return true
        "dynamic_cast" -> return true
        "sizeof" -> return true
        "operator" -> return true
        "goto" -> return true
        "auto" -> return true
        "void" -> return true
        "this" -> return true
        "new" -> return true
        "delete" -> return true
        "nullptr" -> return true
        else -> return false
    }
}
