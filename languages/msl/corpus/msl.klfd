construct Msl() extends Corpus {
    let oracle: [String] = []
    let compare: [String] = ["accept", "diagnostics"]
    // The languages whose outs this corpus's cases ask a target of, as paths
    // relative to this package. The driver the cases run against holds each of
    // them, so a case naming `--target hlsl` is answered by the HLSL out rather
    // than by a refusal that no out writes it.
    let shaderLanguages: [String] = ["../ksl", "../hlsl", "../wgsl"]
    let cases: [CorpusCase] = [
        CorpusCase { name = "blit", sources = ["accepted/Blit.metal"], accept = true },
