        CorpusCase { name = "depth-only", sources = ["accepted/DepthOnly.metal"], accept = true },
        CorpusCase { name = "reduce", sources = ["accepted/Reduce.metal"], arguments = ["--override", "scale=2"], accept = true },
        CorpusCase { name = "reduce-kept", sources = ["accepted/Reduce.metal"], arguments = ["--overrides", "keep", "--target", "spirv,msl,wgsl"], accept = true },
        CorpusCase { name = "packed", sources = ["accepted/Packed.metal"], arguments = ["--target", "spirv,msl,hlsl"], accept = true },
        CorpusCase { name = "flow", sources = ["accepted/Flow.metal"], accept = true },
        CorpusCase { name = "flow-ksl", sources = ["accepted/Flow.metal"], arguments = ["--target", "ksl"], accept = true },
        CorpusCase {
            name = "shadow-ksl", sources = ["accepted/Shadow.metal"], arguments = ["--target", "ksl"],
