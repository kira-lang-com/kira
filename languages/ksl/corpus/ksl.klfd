construct Ksl() extends Corpus {
    let oracle: [String] = []
    let compare: [String] = ["accept", "diagnostics"]
    let cases: [CorpusCase] = [
        CorpusCase { name = "loops", sources = ["accepted/Loops.ksl"], accept = true },
        CorpusCase { name = "loops-ksl", sources = ["accepted/Loops.ksl"], arguments = ["--target", "ksl"], accept = true },
        CorpusCase { name = "depth-only", sources = ["accepted/DepthOnly.ksl"], accept = true },
        CorpusCase { name = "depth-only-ksl", sources = ["accepted/DepthOnly.ksl"], arguments = ["--target", "ksl"], accept = true },
        CorpusCase { name = "derivatives", sources = ["accepted/Derivatives.ksl"], accept = true },
        CorpusCase { name = "derivatives-ksl", sources = ["accepted/Derivatives.ksl"], arguments = ["--target", "ksl"], accept = true },
        CorpusCase { name = "vertex-derivative", sources = ["rejected/VertexDerivative.ksl"], accept = false, diagnostics = ["2023:15"] },
        CorpusCase { name = "negative-constants", sources = ["accepted/NegativeConstants.ksl"], arguments = ["--target", "ksl"], accept = true },
        CorpusCase { name = "negative-uint", sources = ["rejected/NegativeUInt.ksl"], accept = false, diagnostics = ["2017:3"] }
