// A `UInt` has no negative, so negating one does not fold.

const count: UInt = -1

type VertexIn {
    @builtin(vertex_index)
    let vid: UInt
}

type VertexOut {
    @builtin(position)
    let clip_position: Float4
}

shader NegativeUInt {
    vertex {
        input VertexIn
        output VertexOut

        function entry(input: VertexIn) -> VertexOut {
            let out: VertexOut
            out.clip_position = Float4(0.0, 0.0, 0.0, 1.0)
            return out
        }
    }
}
