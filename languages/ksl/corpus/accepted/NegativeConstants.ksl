// Constants written negative, and a constant negating another: each folds
// to its value before any backend sees it.

const below: Float = -0.25
const above: Float = -below
const steps: Int = -3

type VertexIn {
    @builtin(vertex_index)
    let vid: UInt
}

type VertexOut {
    @builtin(position)
    let clip_position: Float4
}

shader NegativeConstants {
    vertex {
        input VertexIn
        output VertexOut

        function entry(input: VertexIn) -> VertexOut {
            let out: VertexOut
            out.clip_position = Float4(below, above, Float(steps), 1.0)
            return out
        }
    }
}
