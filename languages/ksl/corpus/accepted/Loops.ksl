// Nested `while` loops, a helper call and an atomic: shapes the KSL out
// writes back as KSL's own `while` and `atomicAdd`.

type Params {
    let count: Int
    let scale: Float
}

function accumulate(limit: Int, scale: Float) -> Float {
    let total = 0.0
    let i = 0
    while i < limit {
        if i % 2 == 0 {
            total = total + scale
        } else {
            total = total - 1.0
        }
        let j = 0
        while j < i {
            total = total + 0.5
            j = j + 1
        }
        i = i + 1
    }
    return total
}

shader Loops {
    group Frame {
        uniform params: Params
        storage read_write values: [Float]
        storage read_write counters: [UInt]
    }

    compute {
        threads(64, 1, 1)

        function entry() {
            let index = UInt(0)
            let limit = params.count
            let s = params.scale
            let r = accumulate(limit, s)
            values[index] = r
            atomicAdd(counters, UInt(0), UInt(1))
        }
    }
}
