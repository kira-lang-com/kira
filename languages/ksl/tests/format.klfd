import Testing

@Test
function formatsBlocksSpacingAndLongCalls() {
    expect!(formats("""
        type Camera {
        let viewProjection:Float4x4   // trailing
        }


        function f(limit:Int)->Float {
          let total=0.0
          while total<1.0 { if limit%2==0 { total=total+1.0 } else { total = total-1.0 } }
          let long = mul(Float4x4(Float4(1.0, 0.0, 0.0, 0.0), Float4(0.0, 1.0, 0.0, 0.0), Float4(0.0, 0.0, 1.0, 0.0)), Float4(total))
          return -total
        }

        """, """
        type Camera {
            let viewProjection: Float4x4 // trailing
        }

        function f(limit: Int) -> Float {
            let total = 0.0
            while total < 1.0 {
                if limit % 2 == 0 {
                    total = total + 1.0
                } else {
                    total = total - 1.0
                }
            }
            let long = mul(
                Float4x4(
                    Float4(1.0, 0.0, 0.0, 0.0),
                    Float4(0.0, 1.0, 0.0, 0.0),
                    Float4(0.0, 0.0, 1.0, 0.0)
                ),
                Float4(total)
            )
            return -total
        }

        """))
}
