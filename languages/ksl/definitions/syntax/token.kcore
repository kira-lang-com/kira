// The tokens of KSL source.
//
// Only the words that can never name a value are keywords. `input`,
// `output`, `texture`, `sampler`, `storage`, `uniform`, `read`, `write`,
// the stage words, `threads` and `entry` are identifiers the parser
// recognizes by position, so a shader may still name a local `sample` or
// `input`.

enum TokenKind {
    Identifier
    IntegerLiteral
    FloatLiteral

    Import
    As
    Type
    Const
    Enum
    Function
    Shader
    Group
    Option
    Let
    If
    Else
    While
    Return
    True
    False

    LeftParen
    RightParen
    LeftBrace
    RightBrace
    LeftBracket
    RightBracket
    Comma
    Dot
    Colon
    At
    Arrow

    Equals
    Plus
    Minus
    Star
    Slash
    Percent
    EqualEqual
    BangEqual
    Less
    LessEqual
    Greater
    GreaterEqual
    AmpersandAmpersand
    PipePipe
    Ampersand
    Pipe
    Caret
    LessLess
    GreaterGreater
    Bang

    Unknown
    End
}

struct Token {
    let kind: TokenKind
    let span: Span
}

function keyword(word: String) -> Optional<TokenKind> {
    match word {
        "import" -> return .Some(.Import)
        "as" -> return .Some(.As)
        "type" -> return .Some(.Type)
        "const" -> return .Some(.Const)
        "enum" -> return .Some(.Enum)
        "function" -> return .Some(.Function)
        "shader" -> return .Some(.Shader)
        "group" -> return .Some(.Group)
        "option" -> return .Some(.Option)
        "let" -> return .Some(.Let)
        "if" -> return .Some(.If)
        "else" -> return .Some(.Else)
        "while" -> return .Some(.While)
        "return" -> return .Some(.Return)
        "true" -> return .Some(.True)
        "false" -> return .Some(.False)
        else -> {
            let none: Optional<TokenKind> = .None
            return none
        }
    }
}
