// GLSL expressions: operators GLSL spells as functions on vectors, the
// truncating remainder of section 15.2, and combined-sampler sampling.

function glslBinary(op: String) -> String {
    match op {
        "add" -> return "+"
        "subtract" -> return "-"
        "multiply" -> return "*"
        "divide" -> return "/"
        "modulo" -> return "%"
        "equal" -> return "=="
        "not_equal" -> return "!="
        "less" -> return "<"
        "less_equal" -> return "<="
        "greater" -> return ">"
        "greater_equal" -> return ">="
        "and" -> return "&"
        "inclusive_or" -> return "|"
        "exclusive_or" -> return "^"
        "logical_and" -> return "&&"
        "logical_or" -> return "||"
        "shift_left" -> return "<<"
        "shift_right" -> return ">>"
        else -> return op
    }
}

function vectorComparison(op: String) -> String {
    match op {
        "equal" -> return "equal"
        "not_equal" -> return "notEqual"
        "less" -> return "lessThan"
        "less_equal" -> return "lessThanEqual"
        "greater" -> return "greaterThan"
        "greater_equal" -> return "greaterThanEqual"
        else -> return ""
    }
}

// The bits of a half-precision value, from the bits of the `f32` that
// holds it exactly.
function halfBits(single: Int) -> Int {
    let sign = single / 2147483648 % 2 * 32768
    let exponent = single / 8388608 % 256
    let mantissa = single % 8388608
    if exponent == 0 { return sign }
    if exponent == 255 { return sign + 31744 + mantissa / 8192 }
    let biased = exponent - 112
    if biased >= 1 { return sign + biased * 1024 + mantissa / 8192 }
    var value = 8388608 + mantissa
    for step in 0..(126 - exponent) {
        value = value / 2
    }
    return sign + value
}

extend TextOut {
    // A literal as Rust's `{:?}` writes it, for the refusal of one GLSL
    // 4.30 cannot spell.
    function literalDebug(borrow self, table: String, owner: Int, index: Int) -> String {
        let scalar = text(table, owner, index, "scalar")
        if scalar == "f16" {
            return joinText(["F16(", decimalText(halfBits(field(table, owner, index, "bits"))), ")"])
        }
        if scalar == "i64" { return joinText(["I64(", text(table, owner, index, "literal"), ")"]) }
        return joinText(["U64(", text(table, owner, index, "literal"), ")"])
    }

    function dialectLiteral(borrow self, table: String, owner: Int, index: Int) -> String {
        let value = text(table, owner, index, "literal")
        let scalar = text(table, owner, index, "scalar")
        if scalar == "bool" { return value }
        if scalar == "i32" {
            if value == "-2147483648" { return "(-2147483647 - 1)" }
            return signedText(value)
        }
        if scalar == "u32" { return joinText([value, "u"]) }
        if scalar == "f32" {
            if !flag(table, owner, index, "finite") {
                return joinText(["uintBitsToFloat(", decimalText(field(table, owner, index, "bits")), "u)"])
            }
            return signedText(floatOf(table, owner, index))
        }
        if scalar == "f64" { return signedText(joinText([text(table, owner, index, "float"), "lf"])) }
        return joinText(["/* unsupported ", literalDebug(table, owner, index), " */"])
    }

    function dialectCompose(borrow self, typeIndex: Int, parts: [String]) -> String {
        if typeKind(typeIndex) == "struct" { return structValue(typeIndex, parts) }
        var written = glslType(typeIndex)
        if failedText(written) { written = "" }
        return joinText([written, "(", joinWith(parts, ", "), ")"])
    }

    function lanesOf(borrow self, expression: Int) -> Int {
        if typeKindOf(expression) == "vector" { return typeField(typeOf(expression), "lanes") }
        return 0
    }

    function glslBinaryExpression(borrow self, expression: Int) -> String {
        let left = operandOf(expression, "left")
        let right = operandOf(expression, "right")
        let a = operand(left)
        let b = operand(right)
        let op = text("expressions", current, expression, "op")
        var lanes = lanesOf(left)
        if lanes == 0 { lanes = lanesOf(right) }
        let leftKind = scalarKind(scalarOf(left))
        let comparison = vectorComparison(op)
        if utf8Count(comparison) > 0 && lanes > 0 { return joinText([comparison, "(", a, ", ", b, ")"]) }
        if op == "modulo" && leftKind == "float" {
            return joinText(["(", a, " - ", b, " * trunc(", a, " / ", b, "))"])
        }
        if op == "modulo" && leftKind == "sint" { return joinText(["(", a, " - ", b, " * (", a, " / ", b, "))"]) }
        let bitwise = op == "and" || op == "inclusive_or" || op == "exclusive_or"
        if bitwise && leftKind == "bool" && lanes > 0 {
            let size = decimalText(lanes)
            return joinText(["bvec", size, "(uvec", size, "(", a, ") ", glslBinary(op), " uvec", size, "(", b, "))"])
        }
        if op == "and" && leftKind == "bool" { return joinText(["(", a, " && ", b, ")"]) }
        if op == "inclusive_or" && leftKind == "bool" { return joinText(["(", a, " || ", b, ")"]) }
        if op == "exclusive_or" && leftKind == "bool" { return joinText(["(", a, " ^^ ", b, ")"]) }
        if (op == "logical_and" || op == "logical_or") && lanes > 0 {
            refuse("a logical operator on vectors")
            return ""
        }
        return joinText(["(", a, " ", glslBinary(op), " ", b, ")"])
    }

    function glslSelect(borrow self, expression: Int) -> String {
        let condition = operandOf(expression, "condition")
        let accept = operandOf(expression, "accept")
        let c = operand(condition)
        let a = operand(accept)
        let r = operand(operandOf(expression, "reject"))
        let lanes = lanesOf(condition)
        if lanes == 0 { return joinText(["(", c, " ? ", a, " : ", r, ")"]) }
        if scalarKind(scalarOf(accept)) == "float" { return joinText(["mix(", r, ", ", a, ", ", c, ")"]) }
        var parts: [String] = []
        for lane in 0..lanes {
            let x = laneText(lane)
            parts.append(joinText(["(", c, ".", x, " ? ", a, ".", x, " : ", r, ".", x, ")"]))
        }
        return joinText([resultType(expression), "(", joinWith(parts, ", "), ")"])
    }

    function glslBitcast(borrow self, expression: Int) -> String {
        let inner = operandOf(expression, "expr")
        let value = operand(inner)
        let from = scalarKind(scalarOf(inner))
        let to = scalarKind(scalarOf(expression))
        var named = ""
        if from == "float" && to == "uint" {
            named = "floatBitsToUint"
        } else if from == "float" && to == "sint" {
            named = "floatBitsToInt"
        } else if from == "uint" && to == "float" {
            named = "uintBitsToFloat"
        } else if from == "sint" && to == "float" {
            named = "intBitsToFloat"
        } else {
            return joinText([resultType(expression), "(", value, ")"])
        }
        return joinText([named, "(", value, ")"])
    }

    // The integer coordinate of an image access, with the array layer.
    function integerCoordinate(borrow self, coordinate: Int, arrayIndex: Int) -> String {
        var size = lanesOf(coordinate)
        if size == 0 { size = 1 }
        let value = operand(coordinate)
        if arrayIndex >= 0 {
            return joinText(["ivec", decimalText(size + 1), "(", value, ", int(", operand(arrayIndex), "))"])
        }
        if size == 1 { return joinText(["int(", value, ")"]) }
        return joinText(["ivec", decimalText(size), "(", value, ")"])
    }

    function glslLoad(borrow self, expression: Int) -> String {
        let coordinates = integerCoordinate(operandOf(expression, "coordinate"), operandOf(expression, "array_index"))
        let image = operandOf(expression, "image")
        let texture = operand(image)
        let imageClass = typeText(typeOf(image), "class")
        if imageClass == "storage" { return joinText(["imageLoad(", texture, ", ", coordinates, ")"]) }
        var extra = "0"
        var chosen = operandOf(expression, "sample")
        if chosen < 0 { chosen = operandOf(expression, "level_value") }
        if chosen >= 0 { extra = joinText(["int(", operand(chosen), ")"]) }
        let fetched = joinText(["texelFetch(", texture, ", ", coordinates, ", ", extra, ")"])
        if imageClass == "depth" { return joinText([fetched, ".x"]) }
        return fetched
    }

    function glslQuery(borrow self, expression: Int) -> String {
        let image = operandOf(expression, "image")
        let texture = operand(image)
        let imageType = typeOf(image)
        let storage = typeText(imageType, "class") == "storage"
        let query = text("expressions", current, expression, "query")
        var size = ""
        if storage {
            size = joinText(["imageSize(", texture, ")"])
        } else if flag("types", -1, imageType, "multisampled") {
            size = joinText(["textureSize(", texture, ")"])
        } else {
            var level = "0"
            let levelIndex = operandOf(expression, "level_value")
            if query == "size" && levelIndex >= 0 { level = joinText(["int(", operand(levelIndex), ")"]) }
            size = joinText(["textureSize(", texture, ", ", level, ")"])
        }
        let dimension = typeText(imageType, "dimension")
        var components = 2
        if dimension == "1d" {
            components = 1
        } else if dimension == "3d" {
            components = 3
        }
        if query == "size" {
            var swizzle = ""
            if flag("types", -1, imageType, "arrayed") {
                var lanes: [String] = []
                for lane in 0..components {
                    lanes.append(laneText(lane))
                }
                swizzle = joinText([".", joinText(lanes)])
            }
            return joinText([resultType(expression), "(", size, swizzle, ")"])
        }
        if query == "layers" { return joinText(["uint(", size, ".", laneText(components), ")"]) }
        if query == "levels" { return joinText(["uint(textureQueryLevels(", texture, "))"]) }
        refuse("a sample count query needs GLSL 4.50")
        return ""
    }

    function dialectExpression(borrow self, expression: Int) -> String {
        let which = expressionKind(expression)
        match which {
            "literal" -> {
                let scalar = text("expressions", current, expression, "scalar")
                if scalar == "f16" || scalar == "i64" || scalar == "u64" {
                    refuse(joinText(["GLSL 4.30 has no literal ", literalDebug("expressions", current, expression)]))
                }
                return dialectLiteral("expressions", current, expression)
            }
            "constant" -> return constantNames[operandOf(expression, "constant")]
            "override" -> {
                refuse("a kept override")
                return ""
            }
            "zero" -> {
                let zero = zeroText(typeOf(expression))
                if failedText(zero) {
                    refuse(failureText(zero))
                    return ""
                }
                return zero
            }
            "compose" -> {
                var parts: [String] = []
                let items = fieldCount("expressions", current, expression, "items")
                for at in 0..items {
                    parts.append(operand(fieldItem("expressions", current, expression, "items", at)))
                }
                if typeKindOf(expression) == "struct" { return structValue(typeOf(expression), parts) }
                return joinText([resultType(expression), "(", joinWith(parts, ", "), ")"])
            }
            "access" -> return joinText([operand(operandOf(expression, "base")), "[",
                operand(operandOf(expression, "index")), "]"])
            "access_index" -> {
                let base = operandOf(expression, "base")
                let index = operandOf(expression, "index")
                let baseText = operand(base)
                var baseType = typeOf(base)
                if typeKind(baseType) == "pointer" { baseType = typeField(baseType, "base") }
                let shape = typeKind(baseType)
                if shape == "struct" { return joinText([baseText, ".", memberName(baseType, index)]) }
                if shape == "vector" { return joinText([baseText, ".", laneText(index)]) }
                return joinText([baseText, "[", decimalText(index), "]"])
            }
            "splat" -> return joinText([resultType(expression), "(", operand(operandOf(expression, "value")), ")"])
            "swizzle" -> return joinText([operand(operandOf(expression, "vector")), ".",
                text("expressions", current, expression, "pattern")])
            "arg" -> return argumentNames[operandOf(expression, "argument")]
            "global" -> return globalNames[operandOf(expression, "global")]
            "local" -> return localNames[operandOf(expression, "local")]
            "load" -> return operand(operandOf(expression, "pointer"))
            "image_sample" -> return glslSample(expression)
            "image_load" -> return glslLoad(expression)
            "image_query" -> return glslQuery(expression)
            "unary" -> {
                let inner = operandOf(expression, "expr")
                let value = operand(inner)
                let op = text("expressions", current, expression, "op")
                if op == "negate" { return joinText(["(-", value, ")"]) }
                if op == "not" && lanesOf(inner) > 0 { return joinText(["not(", value, ")"]) }
                if op == "not" { return joinText(["(!", value, ")"]) }
                return joinText(["(~", value, ")"])
            }
            "binary" -> return glslBinaryExpression(expression)
            "select" -> return glslSelect(expression)
            "derivative" -> {
                let control = text("expressions", current, expression, "control")
                if control != "none" { refuse(joinText(["a ", control, " derivative needs GLSL 4.50"])) }
                let axis = text("expressions", current, expression, "axis")
                var name = "fwidth"
                if axis == "x" {
                    name = "dFdx"
                } else if axis == "y" {
                    name = "dFdy"
                }
                return joinText([name, "(", operand(operandOf(expression, "expr")), ")"])
            }
            "relational" -> {
                let argument = operandOf(expression, "argument")
                let value = operand(argument)
                let fun = text("expressions", current, expression, "fun")
                let vector = lanesOf(argument) > 0
                if (fun == "all" || fun == "any") && vector { return joinText([fun, "(", value, ")"]) }
                if fun == "all" || fun == "any" { return value }
                if fun == "is_nan" { return joinText(["isnan(", value, ")"]) }
                return joinText(["isinf(", value, ")"])
            }
            "math" -> return glslMath(expression)
            "convert" -> return joinText([resultType(expression), "(", operand(operandOf(expression, "expr")), ")"])
            "bitcast" -> return glslBitcast(expression)
            "array_length" -> return joinText(["uint(", operand(operandOf(expression, "pointer")), ".length())"])
            else -> return joinText(["_ksir_unset", decimalText(expression)])
        }
    }

    function dialectTemporary(borrow self, name: String, expression: Int, value: String) -> String {
        return joinText([resultType(expression), " ", name, " = ", value, ";"])
    }

    function dialectNativeLoop(borrow self) -> Bool {
        return false
    }

    function dialectCaseBreak(borrow self) -> Bool {
        return true
    }

    function dialectCaseLabel(borrow self, value: String) -> String {
        return cLabel(value)
    }

    // A sampler travels inside its combined texture.
    function dialectKeepsArgument(borrow self, expression: Int) -> Bool {
        return typeKindOf(expression) != "sampler"
    }

    function dialectArgument(borrow self, expression: Int) -> String {
        return operand(expression)
    }

    function dialectCallArguments(borrow self, callee: Int) -> [String] {
        return []
    }

    function dialectBakeAlways(borrow self, expression: Int) -> Bool {
        return false
    }

    // GLSL names no files, so the source string is the file's index.
    function dialectLineDirective(borrow self, file: Int, lineNumber: Int) -> String {
        if !dialect.debug || lineNumber == 0 { return "" }
        return joinText(["#line ", decimalText(lineNumber), " ", decimalText(file)])
    }
}
