import Foundation

// VM-to-native return ownership regressions. Prefix: fvr / Fvr.
//
// These drive the shape where @Native code calls a @Runtime builder, receives a
// VM-built aggregate, and returns or embeds it. The returned values must be
// materialized for native layout exactly once and must not leak or double-free.

struct FvrBox {
    var x: Int
}

struct FvrFrame {
    var id: Int
    var box: FvrBox
}

class FvrClassBox {
    var x: Int
}

@Runtime
function fvrMakeBox(seed: Int) -> FvrBox {
    return FvrBox { x: seed + 1 }
}

@Runtime
function fvrMakeClassBox(seed: Int) -> FvrClassBox {
    return FvrClassBox { x: seed + 2 }
}

@Runtime
function fvrMakeArray(seed: Int) -> [Int] {
    var xs: [Int] = []
    xs.append(seed)
    xs.append(seed + 1)
    xs.append(seed + 2)
    return xs
}

function fvrNativeWrapBox(seed: Int) -> FvrBox {
    return fvrMakeBox(seed)
}

function fvrNativeWrapClassBox(seed: Int) -> FvrClassBox {
    return fvrMakeClassBox(seed)
}

function fvrNativeWrapArray(seed: Int) -> [Int] {
    return fvrMakeArray(seed)
}

function fvrNativeWrapFrame(seed: Int) -> FvrFrame {
    return FvrFrame { id: seed, box: fvrMakeBox(seed + 10) }
}

construct FvrNativeReturnsRuntimeStructLoop() extends Test {
    test {
        var total = 0
        for i in 0..20 {
            let box = fvrNativeWrapBox(i)
            total = total + box.x
        }
        return total
    }
    expect { let e: Result<Any, TestFailure> = .Ok(210) return e }
}

construct FvrNativeReturnsRuntimeClassLoop() extends Test {
    test {
        var total = 0
        for i in 0..20 {
            let box = fvrNativeWrapClassBox(i)
            total = total + box.x
        }
        return total
    }
    expect { let e: Result<Any, TestFailure> = .Ok(230) return e }
}

construct FvrNativeReturnsRuntimeArrayLoop() extends Test {
    test {
        var total = 0
        for i in 0..20 {
            let xs = fvrNativeWrapArray(i)
            total = total + xs[0] + xs[1] + xs[2]
        }
        return total
    }
    expect { let e: Result<Any, TestFailure> = .Ok(630) return e }
}

construct FvrNativeEmbedsRuntimeStructFieldLoop() extends Test {
    test {
        var total = 0
        for i in 0..20 {
            let frame = fvrNativeWrapFrame(i)
            total = total + frame.id + frame.box.x
        }
        return total
    }
    expect { let e: Result<Any, TestFailure> = .Ok(600) return e }
}
