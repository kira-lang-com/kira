// The full text a failed build prints, headline through help, for one
// diagnostic whose caret, label and help line are the contract (3050).
construct RenderedDiagnostics() extends Corpus {
    let compare: [String] = ["accept", "rendered"]
    let cases: [CorpusCase] = [
        CorpusCase {
            name = "unknown-type-help",
            sources = ["packages/type-error-help"],
            accept = false,
            rendered = "packages/type-error-help/app/main.kira:5:12: error[3050]: unknown type `Foo`\n  |\n5 |     let x: Foo = 3\n  |            ^^^ no type with this name is declared\n  = help: declare the type in this package, or import the package that declares it"
        }
    ]
}
