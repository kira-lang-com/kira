// The full text a failed build prints for an assignment the binding forbids
// (3025), where the binding's name is quoted in the headline.
construct RenderedAssignments() extends Corpus {
    let compare: [String] = ["accept", "rendered"]
    let cases: [CorpusCase] = [
        CorpusCase {
            name = "immutable-binding",
            sources = ["packages/immutable-binding"],
            accept = false,
            rendered = "packages/immutable-binding/app/main.kira:6:5: error[3025]: assignment to an immutable binding `count`\n  |\n6 |     count = 2\n  |     ^^^^^ declare the binding with `var` to assign to it\n  = help: declare the binding with `var` to assign to it"
        }
    ]
}
