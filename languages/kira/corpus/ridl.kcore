// RIDL between Kira binaries (KLF sections 20 to 25): a Kira library built
// on its own exports its public functions, and a program imports them through
// `@Ridl` declarations and links the library's archive. Either side may run
// on the VM: a program built for it calls a native library through the same
// entries, and a library built as an image is a plugin, loaded on a VM
// instance of its own by a program running natively or on the VM.
construct Ridl() extends Corpus {
    let compare: [String] = ["accept", "diagnostics", "stdout", "exit"]
    let cases: [CorpusCase] = [
        CorpusCase {
            name = "kira-imports-kira",
            sources = ["ridl/consumer"],
            kiraArchives = ["ridl/provider"],
            stdout = "42\ntrue\n4\n10\nabc\n3\nw2\n9\n0\n3.5\n11\n5\n5\n12\n6\n9\nhello ridl\n5\nodd\neven\nodd\n42\n",
            exit = 0
        },
        CorpusCase {
            name = "vm-imports-kira",
            sources = ["ridl/consumer"],
            kiraArchives = ["ridl/provider"],
            engine = "vm",
            stdout = "42\ntrue\n4\n10\nabc\n3\nw2\n9\n0\n3.5\n11\n5\n5\n12\n6\n9\nhello ridl\n5\nodd\neven\nodd\n42\n",
            exit = 0
        },
        CorpusCase {
            name = "vm-imports-plugin",
            sources = ["ridl/plugin-host"],
            kiraImages = ["ridl/provider"],
            engine = "vm",
            stdout = "42\ntrue\n4\n10\nabc\n3\nw2\n9\n0\n3.5\n11\n5\n5\n12\n6\n9\nhello ridl\n5\nodd\neven\nodd\n42\n",
            exit = 0
        },
        CorpusCase {
            name = "kira-imports-plugin",
            sources = ["ridl/plugin-host"],
            kiraImages = ["ridl/provider"],
            stdout = "42\ntrue\n4\n10\nabc\n3\nw2\n9\n0\n3.5\n11\n5\n5\n12\n6\n9\nhello ridl\n5\nodd\neven\nodd\n42\n",
            exit = 0
        },
        CorpusCase {
            name = "import-with-a-body",
            sources = ["ridl/import-body"],
            accept = false,
            diagnostics = ["3369:4"]
        }
    ]
}
