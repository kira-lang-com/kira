struct Flags {
    var ready: Bool
    let count: Int
}

@Main
function main() -> Int {
    var done = false
    var flags = Flags { ready = false, count = 3 }
    var total = 0
    for step in 0..5 {
        if step == 3 { done = true }
        if !done { total = total + 1 }
    }
    flags.ready = done
    let bonus = flags.ready ? 10 : 20
    return total + bonus + flags.count
}
