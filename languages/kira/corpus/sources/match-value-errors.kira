// What a `match` reports: a missing arm, a pattern of the wrong type, arms
// whose values disagree, an arm without a value and an arm twice.

import Foundation

enum Light {
    Red
    Green
}

function f(n: Int, light: Light, flag: Bool) -> Int {
    match n {
        1 -> return 1
    }
    match flag {
        true -> return 2
        1 -> return 3
    }
    match light {
        true -> return 4
        Red -> return 5
        Green -> return 6
    }
    let a = match n {
        0 -> 1
        else -> "two"
    }
    let b = match flag {
        true -> 1
        false -> {
            var x = 1
            x += 1
        }
    }
    let c = match flag {
        true -> 1
        true -> 2
        false -> 3
    }
    return a + b + c
}

@Main
function main() -> Int {
    return f(1, .Red, true)
}
