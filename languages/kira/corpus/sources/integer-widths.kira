function mix(byte: U8, wide: I32) -> Int {
    let a = Int(byte)
    let b = Int(wide)
    return a + b
}

@Main
function main() -> Int {
    let small: U8 = 200
    let medium: I32 = -150
    let total = mix(small, medium)
    let narrowed = U8(total)
    let flipped = wrappingAdd(small, U8(100))
    return Int(narrowed) + Int(flipped)
}
