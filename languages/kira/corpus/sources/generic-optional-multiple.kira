enum Optional<Value> {
    None
    Some(Value)
}

function integerValue(value: Int) -> Optional<Int> {
    return .Some(value)
}

function booleanValue(value: Bool) -> Optional<Bool> {
    return .Some(value)
}

@Main
function main() -> Int {
    let number = integerValue(42)
    let truth = booleanValue(true)
    match number {
        Some(value) -> {
            match truth {
                Some(yes) -> { return value + (yes ? 1 : 0) }
                None -> { return 0 }
            }
        }
        None -> { return 0 }
    }
}
