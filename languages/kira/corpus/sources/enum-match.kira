enum Shape {
    Square(Int)
    Rectangle(Int)
    Empty
}

function area(shape: borrow Shape) -> Int {
    match shape {
        Square(side) -> return side * side
        Rectangle(width) -> return width * 2
        Empty -> return 0
    }
}

@Main
function main() -> Int {
    let square: Shape = .Square(5)
    let empty: Shape = .Empty
    return area(square) + area(.Rectangle(7)) + area(empty)
}
