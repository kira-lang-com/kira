// Labels are part of a function's name, as in Swift: two declarations that
// take the same types under different labels are two functions, and a call
// reaches the one its labels name. A value reaches an optional parameter too.

import Foundation

function pick(first: Int) -> Int {
    return first + 1
}

function pick(second: Int) -> Int {
    return second + 100
}

struct Box {
    var width: Number = 0
    function sized(width: Number) -> Box { return Box { width: width } }
    function sized(min: Number? = .None, max: Number? = .None) -> Box {
        match max {
            Some(value) -> return Box { width: value }
            None -> return Box { width: -1 }
        }
    }
}

@Main
function main() -> Int {
    if pick(first: 1) != 2 { return 1 }
    if pick(second: 1) != 101 { return 2 }
    let box = Box {}
    if box.sized(60).width != 60 { return 3 }
    if box.sized(min: 10, max: 90).width != 90 { return 4 }
    return 42
}
