// Compound assignment: each operator, through fields and an index whose
// expression runs once, and on a String.

import Foundation

struct Box {
    var items: [Int]
    var total: Int
}

var calls = 0

function slot() -> Int {
    calls += 1
    return 1
}

@Main
function main() -> Int {
    var x = 5
    x += 3
    x -= 1
    x *= 4
    x /= 2
    x %= 9
    x <<= 2
    x >>= 1
    x |= 16
    x &= 23
    x ^= 1
    var b = Box { items = [1, 2, 3], total = 0 }
    b.items[slot()] += 10
    b.total += b.items[1]
    var s = "ab"
    s += "cd"
    if calls != 1 { return 1 }
    if b.items[1] != 12 || b.total != 12 { return 2 }
    if s != "abcd" { return 3 }
    return x
}
