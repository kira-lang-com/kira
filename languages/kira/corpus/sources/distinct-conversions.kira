distinct Handle = Int
distinct Wide = U64

function handle(raw: Int) -> Handle {
    return Handle(raw)
}

@Main
function main() -> Int {
    let h = Handle(30)
    var total = 0
    if Int(h) > 0 { total = Int(h) }
    let narrow = U8(handle(7))
    total = total + Int(narrow)
    let wide = Wide(5)
    total = total + Int(wide)
    return total
}
