// A struct's computed members, written as a construct's are: a block in
// place of a value, its type stated or taken from what the block ends with,
// and a `set` accessor that an assignment to the member calls.

import Foundation

struct Rectangle {
    var width: Int
    var height: Int

    var area: Int {
        return width * height
    }

    let perimeter {
        return 2 * (width + height)
    }

    var side: Int {
        get {
            return width
        }
        set(value) {
            width = value
            height = value
        }
    }
}

@Main
function main() -> Int {
    var shape = Rectangle { width: 3, height: 4 }
    if shape.area != 12 { return 1 }
    if shape.perimeter != 14 { return 2 }
    if shape.side != 3 { return 3 }
    shape.side = 5
    if shape.width != 5 || shape.height != 5 { return 4 }
    if shape.area != 25 { return 5 }
    return 42
}
