// `public` before a declaration or between its annotations and it, on each
// kind of top-level declaration.
import Foundation

public struct Point {
    let x: Int
    let y: Int
}

@Derive(Copy) public enum Mode {
    Off
    On
}

public distinct Meters = Int

public type Points = [Point]

public let base: Int = 30

public function sum(points: borrow Points) -> Int {
    var total = 0
    for point in points { total = total + point.x + point.y }
    return total
}

@Main
public function main() -> Int {
    let points: Points = [Point { x = 1, y = 2 }, Point { x = 3, y = 4 }]
    let mode = Mode.On
    match mode {
        Off -> return 0
        On -> return base + sum(points) + 2
    }
}
