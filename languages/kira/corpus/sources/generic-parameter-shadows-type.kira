import Foundation

// A program's own `Key`, `Value` and `Element` do not take over the names
// Foundation's templates bind as type parameters, nor this file's.
enum Key {
    Escape
}

enum Value {
    One
}

struct Element {
    let weight: Int
}

struct Shelf<Element> {
    let items: [Element]
}

function last<Element>(items: [Element], fallback: Element) -> Element {
    var found = fallback
    for item in items { found = item }
    return found
}

@Main
function main() -> Int {
    var table = Map<String, Int>()
    table.set("a", 30)
    let shelf = Shelf<Int> { items = filled(2, 6) }
    let heavy = last([Element { weight = 4 }, Element { weight = 6 }], Element { weight = 0 })
    return table.keys().count + 29 + last(shelf.items, 0) + heavy.weight
}
