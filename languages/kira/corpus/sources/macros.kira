macro square(value: expr) { expand { value * value } }
macro add3(a: expr, b: expr, c: expr) { expand { a + b + c } }
macro swap(a: place, b: place) {
    expand {
        let temporary = a
        a = b
        b = temporary
    }
}
function next(value: borrow mut Int) -> Int {
    value = value + 1
    return value
}
@Main
function main() -> Int {
    var count = 2
    let result = square!(next(count))
    var x = 10
    var y = 20
    swap!(x, y)
    let temporary = 100
    return result + count + x + y + temporary + add3!(1, 2, 3) + square!(square!(2))
}
