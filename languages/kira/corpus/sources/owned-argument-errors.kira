// A named local given bare to an owned or `copy` parameter. `Stage` carries a
// payload because an enum without one copies as its tag (KLF section 27.3).

import Foundation

enum Stage {
    Frame
    Draw(String)
}

function stageIndex(stage: Stage) -> Int {
    match stage {
        Frame -> return 0
        Draw(_) -> return 1
    }
}

function copied(text: copy String) -> Int { return text.count }

@Main
function main() -> Int {
    let stage = Stage.Draw("lines")
    let name = "kira"
    let first = stageIndex(stage)
    let second = copied(name)
    return first + second
}
