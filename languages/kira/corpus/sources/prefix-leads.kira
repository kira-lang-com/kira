import Foundation

// `dk` and `ui` are no words, so they read as prefixes. `box`, `key` and
// `on` are words: `boxValue`, `keyName` and `onClose` are plain names.
function dkSurfaces() -> Number { return 1 }
function uiDraw() -> Number { return 1 }
function boxValue() -> Number { return 1 }
function keyName() -> Number { return 1 }
function onClose() -> Number { return 1 }

@Main
function main() -> Int {
    return Int(dkSurfaces() + uiDraw() + boxValue() + keyName() + onClose())
}
