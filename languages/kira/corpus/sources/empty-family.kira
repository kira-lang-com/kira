// A family no declaration joins: its members still check, so code written
// against `Any Route` builds even when the program has no route.

import Foundation

construct Route {
    @Required function routeName() -> String
}

function described(values: borrow [Any Route]) -> Int {
    var total = 0
    for value in values {
        total = total + value.routeName().count
    }
    return total
}

@Main
function main() -> Int {
    let none: [Any Route] = []
    return described(none) + 7
}
