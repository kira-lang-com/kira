// A prefix a binding's value cannot take, and a `move` prefix moving.

import Foundation

enum Mode {
    On
    Off
}

@Main
function main() -> Int {
    let items: [Int] = [1]
    let a: borrow [Int] = items
    let m: Mode = .On
    let b: copy Mode = m
    let c: borrow mut Int = 3
    let d: move [Int] = items
    let e = items
    return 0
}
