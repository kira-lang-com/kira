import Foundation

// A value boxed as a family member before a generic member's instance is
// minted keeps its case: `Labeled<String>` sorts before `Square`, and the
// square made first must still measure as a square.

construct Shape {
    function measure() -> Number {
        return 0
    }
}

construct Square(side: Number) extends Shape {
    function measure() -> Number {
        return side * side
    }
}

construct Labeled<Value>(value: Value, width: Number) extends Shape {
    function measure() -> Number {
        return width
    }
}

function square() -> Any Shape {
    return Square(side = 6)
}

function labeled() -> Any Shape {
    return Labeled(value = "title", width = 6)
}

@Main
function main() -> Number {
    let first = square()
    let second = labeled()
    return first.measure() + second.measure()
}
