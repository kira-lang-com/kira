// `i++` and `i--` step a place by one, as `i += 1` and `i -= 1` do. `a--b`
// written together is still `a - -b`.

import Foundation

struct Counter {
    var value: Int
}

@Main
function main() -> Int {
    var i = 0
    for _ in 0..50 {
        i++
    }
    var counts = [0, 0]
    counts[1]++
    counts[1]++
    var counter = Counter { value = 10 }
    counter.value--
    i--
    let b = 3
    let difference = i--b
    return difference - counts[1] - counter.value + 1
}
