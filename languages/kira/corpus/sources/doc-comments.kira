//! The documentation corpus: every position a doc comment may take.
//! A second line of the module documentation.

import Foundation

//// A plain comment of four slashes is not documentation.

/// The number the program returns.
let answer = 42

/// A shape with its two sides.
///
/// The sides are the measures a caller passes.
public struct Shape {
    /// The width in metres.
    let width: Number
    // A plain comment between members is not documentation.
    /// The height in metres.
    var height: Number = 3

    /// The area of the shape.
    function area(borrow self) -> Number {
        return width * height
    }
}

/// The colour of a shape.
enum Colour {
    /// Nothing drawn.
    None
    /// A solid fill.
    Solid
}

/// Adds two numbers.
/// Works on any `Number`.
function add(first: Number, second: Number) -> Number {
    // Why: the sum is taken in `Number`, so no precision is lost.
    return first + second
}

/// The program's entry point.
@Main
function main() -> Int {
    let shape = Shape { width = 6, height = 7 }
    return Int(shape.area())
}
