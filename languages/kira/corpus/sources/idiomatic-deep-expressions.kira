import Foundation

function chooseIndex(flag: Bool) -> Int {
    if flag { return 0 }
    return 1
}

function apply(check: (Bool) -> Bool) -> Bool {
    return check(false)
}

function run(flag: Bool) {
    var values: [Int] = [0, 0]
    values[chooseIndex(flag == false)] = 3
    values[chooseIndex(flag == true)] += 4
    let applied = apply({ enabled in return enabled == false })
    print(applied)
}

@Main
function main() -> Int {
    run(false)
    return 0
}
