struct Point {
    var x: Int
    let y: Int

    function sum(borrow self) -> Int {
        return x + y
    }

    function shift(borrow mut self, by: Int) {
        x = x + by
    }

    function implicitShift(by: Int) { self.x = self.x + by }

    function forwardShift(by: Int) { return self.implicitShift(by) }
}

function scaled(point: borrow Point, factor: Int) -> Point {
    return Point { x = point.x * factor, y = point.y * factor }
}

@Main
function main() -> Int {
    var point = Point { x = 3, y = 4 }
    point.shift(1)
    point.forwardShift(1)
    let bigger = scaled(point, 3)
    let updated = bigger {
        let x = bigger.x + 1
    }
    if updated.x != 16 || updated.y != 12 || bigger.x != 15 { return 0 }
    return bigger.sum() + point.x
}
