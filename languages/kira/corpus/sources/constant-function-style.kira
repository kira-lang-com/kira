import Foundation

function chromeHeight() -> Number { return 33.0 }
function banner() -> String { return "kira" }
function enabled() -> Bool { return true }

public function stableApi() -> Number { return 5.0 }
function derivedHeight() -> Number { return 30.0 + 3.0 }
function passed(value: Number) -> Number { return 6.0 }
function absent() -> String? { return .None }

@Main
function main() -> Int {
    if chromeHeight() != 33 { return 1 }
    if banner() != "kira" { return 2 }
    if !enabled() { return 3 }
    if stableApi() != 5 { return 4 }
    if derivedHeight() != 33 { return 5 }
    if passed(6) != 6 { return 6 }
    return 0
}
