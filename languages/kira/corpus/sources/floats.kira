import Foundation

function adjust(value: F32) -> Float {
    return Float(value) + 0.5
}

@Main
function main() -> Int {
    if cbrt(-8.0) != -2.0 || clamp(3.0, 0.0, 1.0) != 1.0 || infinity <= 1000000000000.0 || infinity + 1.0 != infinity { return 0 }
    let small: F32 = 1.25
    let result = adjust(small)
    let zero: Float = 0.0
    let nan = zero / zero
    if result == 1.75 && nan != nan && -result < 0.0 {
        return Int(result * 4.0)
    }
    return 0
}
