// `borrow`, `copy` and `move` before a binding's type, where each can stand.

import Foundation

struct Point {
    let x: Int
}

@Main
function main() -> Int {
    let f: (Int) -> Int = { n in n + 1 }
    let g: borrow (Int) -> Int = f
    let p = Point { x = 40 }
    let q: copy Point = p
    let items: [Int] = [1]
    let moved: move [Int] = items
    return g(q.x) + moved[0]
}
