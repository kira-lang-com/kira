// Doc comments (docs/documentation.md): accepted where they document a
// declaration, and reported where they document nothing.

construct Documentation() extends Corpus {
    let compare: [String] = ["accept", "diagnostics", "exit"]
    let cases: [CorpusCase] = [
        CorpusCase {
            name = "doc-comments-attach",
            sources = ["sources/doc-comments.kira"],
            exit = 42
        },
        CorpusCase {
            name = "doc-comment-in-body",
            sources = ["sources/doc-comments-errors.kira"],
            accept = false,
            diagnostics = ["2101:5"]
        },
        CorpusCase {
            name = "doc-comment-at-end",
            sources = ["sources/doc-dangling-end.kira"],
            accept = false,
            diagnostics = ["2101:8"]
        },
        CorpusCase {
            name = "inner-doc-after-first-token",
            sources = ["sources/doc-inner-late.kira"],
            accept = false,
            diagnostics = ["2102:3"]
        },
        CorpusCase {
            name = "doc-comment-between-annotation",
            sources = ["sources/doc-after-annotation.kira"],
            accept = false,
            diagnostics = ["2101:4"]
        },
        CorpusCase {
            name = "doc-comments-on-members",
            sources = ["sources/doc-members.kira"]
        },
        CorpusCase {
            name = "doc-comment-before-trait-end",
            sources = ["sources/doc-trait-dangling.kira"],
            accept = false,
            diagnostics = ["2101:6"]
        },
        CorpusCase {
            name = "doc-comment-before-requires-block",
            sources = ["sources/doc-requires-block.kira"],
            accept = false,
            diagnostics = ["2101:4"]
        }
    ]
}
