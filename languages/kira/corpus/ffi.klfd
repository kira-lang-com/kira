// The C seam (KLF section 26) against kira's FFI fixture: every program
// links the fixture archive its package names and prints what kira prints.
// Almost every case runs on the VM as well as natively, which is what proves
// the VM needs no C compiler of its own; `ffi-variadic` says why one does not.
construct Ffi() extends Corpus {
    let compare: [String] = ["accept", "stdout", "exit"]
    let cases: [CorpusCase] = [
        CorpusCase {
            name = "ffi-all",
            sources = ["ffi/ffi-all"],
            cArchives = ["ffi/native/ffifixture.c"],
            engine = "vm",
            stdout = "42\n-5\n200\n-9\n40000\n4000000000\n1975\n5000000000\nfalse\n3.75\n1.75\n4\n42\n0\n7\nhello from C\nround trip\n|\nhello from C!\n1\n2\n",
