// The FFI fixture's declarations as a `.klffi` file: the package names it in
// its `NativeLibrary`, and the program calls them as its own functions.

@FFI.Extern { library: ffifixture, symbol: ffi_add_i32, abi: c }
function addI32(a: I32, b: I32) -> I32

@FFI.Extern { library: ffifixture, symbol: ffi_add_f64, abi: c }
function addF64(a: Float, b: Float) -> Float

@FFI.Extern { library: ffifixture, symbol: ffi_store, abi: c }
function storeCell(v: I32)

@FFI.Extern { library: ffifixture, symbol: ffi_load, abi: c }
function loadCell() -> I32
