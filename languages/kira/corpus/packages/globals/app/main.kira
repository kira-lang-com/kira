import Foundation

var counter: Int = 1
let greeting: String = "ready"
var values: [Int] = [1, 2]
let next: () -> Int = { in
    counter = counter + 1
    return counter
}

function adjust() -> Int {
    values.append(next())
    return values.count
}

@Main
function main() -> Int {
    let first = next()
    let count = adjust()
    return first + count + values[2] + greeting.count
}
