import Foundation

enum Failure {
    Gone
}

function fetch(n: Int) -> Result<Int, Failure> {
    if n > 0 { return .Ok(n) }
    return .Error(.Gone)
}

@Main
function main() -> Int {
    var total = 0
    match fetch(1) {
        Ok(value) -> { total = total + value }
        Error(_) -> {}
    }
    match fetch(2) {
        Ok(value) -> { total = total + value }
        Error -> {}
    }
    match fetch(3) {
        Ok(value) -> { total = total + value }
        else -> {}
    }
    return total
}
