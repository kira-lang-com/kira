import Foundation

public construct Shape {
    function measure(scale: Number, offset: Number) -> Number {
        return 0
    }
}

public construct Labeled<Value>(value: Value, width: Number) extends Shape {
    function measure(scale: Number, offset: Number) -> Number {
        return width * scale + offset
    }
}

public function measured(shape: Any Shape) -> Number {
    return shape.measure(4, 2)
}
