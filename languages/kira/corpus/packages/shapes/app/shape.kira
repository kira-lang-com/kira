// A class family whose calls this package's unit makes for subclasses only
// the program declares or names.
public class Shape {
    var label: String = "shape"

    function area() -> Number {
        return 0
    }
}

public class Tagged<Tag> extends Shape {
    var tag: Tag?

    override function area() -> Number {
        return 100
    }
}

public function tag<Tag>(value: Tag) -> Shape {
    let tagged = Tagged<Tag> { tag = .Some(move value) }
    return tagged
}

public function totalArea(shapes: [Shape]) -> Number {
    var total: Number = 0
    for shape in shapes { total += shape.area() }
    return total
}

public function labels(shapes: [Shape]) -> String {
    var joined = ""
    for shape in shapes { joined = joined + shape.label + " " }
    return joined
}
