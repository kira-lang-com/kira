import Foundation
import ScopeNearestLibrary

// A bare call inside a method reaches the sibling method before a free
// function an imported library declares under the same name, and a library's
// own type parameters and leading-dot arguments mean what it wrote.
struct Tally {
    let base: Number

    function total() -> Number {
        return base + 1
    }

    function doubled() -> Number {
        return total() * 2
    }
}

@Main
function main() -> Int {
    let tally = Tally { base: 9 }
    let pair = Pair { left: 10, right: 2 }
    let sum = pair.combined(0, { running, next in return running + next })
    let square = Square()
    let scaled = square.scaled(3, { held, size in return held * size })
    let gaps = Gap(spacing: 4).points() + Gap(spacing: .Length(5)).points()
    return Int(tally.doubled() + sum + Number(code(Value.Unused)) + scaled + gaps)
}
