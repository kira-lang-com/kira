import Foundation

@Main
function main() -> Int {
    let zero = ctfDescribe(0)
    let negative = ctfDescribe(-1)
    let positive = ctfDescribe(1)
    if zero != "zero" { return 1 }
    if negative != "negative" { return 2 }
    if positive != "positive" { return 3 }
    return ctfDouble(21) + ctfTriangular(10) + ctfComposed(5)
}
