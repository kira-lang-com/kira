import Shapes

struct Badge {
    let text: String
}

class Square extends Shape {
    var side: Number = 3

    override function area() -> Number {
        return self.side * self.side
    }
}

@Main
function main() {
    let square = Square()
    square.label = "square"
    let shapes: [Shape] = [Shape(), square, tag(Badge { text = "b" })]
    print(totalArea(copy shapes))
    print(labels(move shapes))
}
