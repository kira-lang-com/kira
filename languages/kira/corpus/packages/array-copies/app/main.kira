import Foundation

struct Box {
    var values: [Int]
}

@Main
function main() -> Int {
    let values: [Int] = [1, 2, 3]
    var original = Box { values = copy values }
    var duplicate = original
    duplicate.values[0] = 9
    var moved: [Int] = move duplicate.values
    moved.append(4)
    return values[0] + original.values[0] + moved[0] + moved[3]
}
