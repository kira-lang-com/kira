import ExtendLib

// A method of a type another package declares, with early returns and a final
// unconditional return: it always returns, so no missing-return error (3033).
extend Extent {
    function area() -> Number {
        if width == 0.0 || height == 0.0 {
            return 0.0
        }
        let scale = 1.0
        if scale == 1.0 {
            return width * height * scale
        }
        return width * height
    }
}

@Main
function main() -> Number {
    return Extent { width: 6.0, height: 7.0 }.area()
}
