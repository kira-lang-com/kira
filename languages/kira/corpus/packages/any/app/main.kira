import Foundation

struct Point {
    let x: Int
    let y: Int
}

struct Other {
    let x: Int
    let y: Int
}

@Main
function main() -> Int {
    let point: Any = Point(x: 4, y: 5)
    let same: Any = Point(y: 5, x: 4)
    let other: Any = Other(x: 4, y: 5)
    let number: Any = U8(7)
    let seven: Any = Int(7)
    let text: Any = "ok"
    let sequence: [Int] = [1, 2]
    let boxed: Any = copy sequence
    let sameArray: Any = [Int(1), Int(2)]
    let floating: Any = F32(2.5)
    let wide: Any = Float(2.5)
    let truth: Any = true
    var score = 0
    if point == same && point != other && point is Point && !(point is Other) {
        let back = point as Point
        score = score + back.x * 10 + back.y
    }
    if number == seven { score = score + (number as Int) }
    if (text as String) == "ok" { score = score + (text as String).count }
    if boxed == sameArray { score = score + (boxed as [Int]).count }
    if floating == wide { score = score + Int(floating as Float) }
    if truth as Bool { score = score + 1 }
    return score
}
