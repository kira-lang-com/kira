//! Shapes and their areas. This module links [`Shape`], [`Shape.area`] and
//! [`Links::Unit`], and names [`hidden`], which is private.

/// The unit a shape's area is measured in.
public enum Unit {
    /// Square metres.
    Metres
    /// Square feet.
    Feet
}

/// A square of [`Unit`]s, the one that [`area_of`] measures.
///
/// Its area comes from [`Shape.area`]. The link [`Links::Unit`] names the same
/// unit through the package's path.
///
/// # Examples
///
/// ```kira
/// let shape = Shape { sides = 2 }
/// # let unused = shape.area()
/// ```
public struct Shape {
    /// The length of one side.
    let sides: Number

    /// The area in square units: the side squared.
    ///
    /// The helper [`hidden`] is private, so its link shows as written.
    function area(borrow self) -> Number {
        return sides * sides
    }
}

/// The area of a square of side `side`, the same as [`Shape.area`] gives.
///
/// # Examples
///
/// ```compile_fail
/// let side: String = area_of(2)
/// ```
public function area_of(side: Number) -> Number {
    return side * side
}

/// A helper nothing outside the module calls.
function hidden() -> Number {
    return 1
}

