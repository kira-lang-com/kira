// An `@AtExit` function hears how the program ended, after a trap too.
@AtExit
function ending(reason: Int, detail: Int) {
    print(reason)
    print(detail)
}

@Main
function main() -> Int {
    var total: Int = 0
    for count in 1..4 {
        total = total + count
    }
    let zero = total - total
    return total / zero
}
