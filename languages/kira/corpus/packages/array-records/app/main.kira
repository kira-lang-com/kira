import Foundation

struct Item {
    var number: Int
    var extra: Int
}

@Main
function main() -> Int {
    var entries: [Item] = []
    for index in 0..4 {
        entries.append(Item { number = index, extra = index * 2 })
    }
    var duplicate: [Item] = copy entries
    duplicate[1].extra = 40
    return entries[1].extra + duplicate[1].extra + entries.count
}
