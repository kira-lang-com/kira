import Foundation

// A diamond at each level used to make nativeRecover traverse the preceding
// levels twice, producing 2^20 visits to the same handful of types.
struct Shared0 { var value: Int = 0 }
struct Shared1 { var left: [Shared0] = [] var right: [Shared0] = [] }
struct Shared2 { var left: [Shared1] = [] var right: [Shared1] = [] }
struct Shared3 { var left: [Shared2] = [] var right: [Shared2] = [] }
struct Shared4 { var left: [Shared3] = [] var right: [Shared3] = [] }
struct Shared5 { var left: [Shared4] = [] var right: [Shared4] = [] }
struct Shared6 { var left: [Shared5] = [] var right: [Shared5] = [] }
struct Shared7 { var left: [Shared6] = [] var right: [Shared6] = [] }
struct Shared8 { var left: [Shared7] = [] var right: [Shared7] = [] }
struct Shared9 { var left: [Shared8] = [] var right: [Shared8] = [] }
struct Shared10 { var left: [Shared9] = [] var right: [Shared9] = [] }
struct Shared11 { var left: [Shared10] = [] var right: [Shared10] = [] }
struct Shared12 { var left: [Shared11] = [] var right: [Shared11] = [] }
struct Shared13 { var left: [Shared12] = [] var right: [Shared12] = [] }
struct Shared14 { var left: [Shared13] = [] var right: [Shared13] = [] }
struct Shared15 { var left: [Shared14] = [] var right: [Shared14] = [] }
struct Shared16 { var left: [Shared15] = [] var right: [Shared15] = [] }
struct Shared17 { var left: [Shared16] = [] var right: [Shared16] = [] }
struct Shared18 { var left: [Shared17] = [] var right: [Shared17] = [] }
struct Shared19 { var left: [Shared18] = [] var right: [Shared18] = [] }
struct Shared20 { var left: [Shared19] = [] var right: [Shared19] = [] }

@Main
function main() -> Int {
    let handle = nativeState(Shared20 {})
    unsafe {
        let view = nativeRecover<Shared20>(nativeUserDataBorrow(handle))
        return view.left.count + view.right.count
    }
}