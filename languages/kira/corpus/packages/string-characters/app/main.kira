import Foundation

// `for c in text` walks text one character at a time; a character of several
// UTF-8 bytes stays whole.
@Main
function main() -> Int {
    var count = 0
    var joined = ""
    for character in "héllo" {
        count = count + 1
        joined.append(character)
    }
    if count == 5 && joined == "héllo" && "é".characters().count == 1 {
        return count
    }
    return 0
}
