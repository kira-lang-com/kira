// A generic construct of a family another package declares, minted in the
// program and reached only through the family's dispatch: its method is
// checked when minted, so lowering finds its parameters.

import Foundation
import FamilyGenericLib

construct Card(title: String) extends Shape {
    function inner() -> Any Shape {
        return Labeled(value = title, width = 10)
    }

    function measure(scale: Number, offset: Number) -> Number {
        return measured(inner())
    }
}

@Main
function main() -> Number {
    return measured(Card(title = "title"))
}
