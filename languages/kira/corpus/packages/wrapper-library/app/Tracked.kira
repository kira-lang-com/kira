import Foundation

// A property wrapper another module names: it reads its initial value, and
// says what is written through it, under the key it is given.
public struct Tracked<Value> {
    let wrappedValue: Value
    let key: String = ""
    let label: String = ""

    function get() -> Value {
        return copy wrappedValue
    }

    function set(value: Value) {
        print(label + " " + key + " written")
    }

    function projectedValue() -> String {
        return key
    }
}
