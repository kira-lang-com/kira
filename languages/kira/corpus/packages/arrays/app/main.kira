import Foundation

function makeValues() -> [Int] {
    var values: [Int] = []
    for index in 0..6 {
        values.append(index)
    }
    return values
}

@Main
function main() -> Int {
    var values: [Int] = makeValues()
    values[0] = 9
    values.append(12)
    return values[0] + values.count + values[6]
}
