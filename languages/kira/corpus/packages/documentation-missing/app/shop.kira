import Foundation

/// Documented as a whole, so only its members are checked.
public struct Price {
    let amount: Number
    /// The currency code.
    let currency: String

    function discounted(borrow self, rate: Number) -> Number {
        return amount - amount * rate
    }
}

public enum Display {
    Full
    /// Shown as the amount alone.
    Bare
}

public let limit = 1000

@Main
function main() -> Int {
    return 0
}
