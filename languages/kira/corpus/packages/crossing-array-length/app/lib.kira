import Foundation

public function grow(items: borrow mut [Number]) {
    items.append(1)
}

public function replace(items: borrow mut [Number]) {
    items = [1, 2]
}

public function rewrite(items: borrow mut [Number]) {
    items[0] = 2
}

function growInside(items: borrow mut [Number]) {
    items.append(1)
}
