import Foundation

class Base {
    let rate: Int = 2

    function cost(value: Int) -> Int {
        return rate * value
    }
}

class Derived extends Base {
    override let rate = 3

    override function cost(value: Int) -> Int {
        return Base.cost(value) + 1
    }
}

function throughBase(value: Base) -> Int {
    return value.cost(4)
}

@Main
function main() -> Int {
    let derived = Derived()
    let base: Base = derived
    return throughBase(move base)
}
