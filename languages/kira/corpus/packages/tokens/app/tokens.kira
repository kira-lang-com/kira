// Every default here names a function of this library. A consumer constructs
// these from any of its files, imported or not; the names stay this file's.

public function baseSpacing() -> Int {
    return 4
}

public function scaled(value: Int, factor: Int = baseSpacing()) -> Int {
    return value * factor
}

public struct Metrics {
    var spacing: Int = baseSpacing()
    var padding: Int = scaled(2)
}

public construct Style {
    @Required let metrics: Metrics
    let gap = baseSpacing()
}

public construct DefaultStyle() extends Style {
    let metrics = Metrics {}
}
