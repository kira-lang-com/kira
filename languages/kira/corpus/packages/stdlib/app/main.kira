import Foundation

function identity(value: Foundation.Optional<Int>) -> Foundation.Optional<Int> {
    return value
}

function answer(value: Int) -> Foundation.Result<Int, Int> {
    return .Ok(value)
}

@Main
function main() -> Int {
    let maybe: Foundation.Optional<Int> = identity(.Some(42))
    let bytes: RawPtr = Foundation.allocateBytes(8)
    Foundation.freeBytes(bytes)
    match maybe {
        Some(value) -> {
            match answer(7) {
                Ok(extra) -> { return value + extra }
                Error(failure) -> { return failure }
            }
        }
        None -> { return 0 }
    }
}
