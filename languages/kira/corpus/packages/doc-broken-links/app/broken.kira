//! Broken links: see [`Pirce`] and [`Shape.amount`].

/// The price of one item.
///
/// It is never more than [`Pirce`]; see [`Missing::Item`] for the other kind.
///
/// # Examples
///
/// ```kira
/// let oops: Number = "text"
/// ```
public struct Price {
    /// The amount, in whole units.
    let amount: Number

    /// The amount with a rate taken off.
    function reduced(borrow self, rate: Number) -> Number {
        return amount - amount * rate
    }
}

