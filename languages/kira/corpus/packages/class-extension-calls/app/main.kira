import Foundation

enum Outcome {
    Pending
    Malformed
}

class Decoder {
    var outcome: Outcome = .Pending
    var steps: Int = 0

    function fail(reason: Outcome) {
        self.outcome = reason
    }
}

@Main
function main() -> Int {
    let decoder = Decoder()
    decoder.read(3)
    match decoder.outcome {
        Pending -> return 1
        Malformed -> return 39 + decoder.steps
    }
}
