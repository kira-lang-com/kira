import Foundation

// The struct the header declares, read field by field.
function sum(record: autobind_record) -> Int {
    return Int(record.flags) + Int(record.origin.x) + Int(record.origin.y)
}

@Main
function main() -> Int {
    let one = Int(cos(0.0))
    return Int(AUTOBIND_BASE) + Int(AUTOBIND_NET) + one * 6
}
