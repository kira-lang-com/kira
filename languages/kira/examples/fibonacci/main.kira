// The Fibonacci numbers, computed twice: by recursion and by a loop.

function recursive(n: Int) -> Int {
    if n < 2 { return n }
    return recursive(n - 1) + recursive(n - 2)
}

function iterative(n: Int) -> Int {
    var previous = 0
    var current = 1
    for step in 0..n {
        let next = previous + current
        previous = current
        current = next
    }
    return previous
}

@Main
function main() -> Int {
    var agreed = 0
    for n in 0..20 {
        if recursive(n) == iterative(n) { agreed = agreed + 1 }
    }
    return agreed * 1000 + iterative(20) % 1000
}
