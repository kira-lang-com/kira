import Testing

// The example programs of the language. Each `main` returns the full value
// the corpus checked as an exit code, which is that value modulo 256.

@Test
function runsFibonacciExample() {
    expect!(runPath("examples/fibonacci/main.kira") == 20765)
}

@Test
function runsShapesExample() {
    expect!(runPath("examples/shapes/main.kira") == 31)
}

@Test
function runsChecksumExample() {
    expect!(runPath("examples/checksum/main.kira") == 15311)
}

@Test
function runsInventoryExample() {
    expect!(runPath("examples/inventory/main.kira") == 652)
}
