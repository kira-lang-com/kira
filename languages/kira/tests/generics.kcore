import Testing

// The programs of `corpus/generics.klfd` that compile without Foundation.

@Test
function specializesOptionalInt() {
    expect!(runPath("corpus/sources/generic-optional.kira") == 42)
}

@Test
function specializesOptionalsForSeveralTypes() {
    expect!(runPath("corpus/sources/generic-optional-multiple.kira") == 43)
}

@Test
function specializesGenericStructs() {
    expect!(runPath("corpus/sources/generic-struct-box.kira") == 42)
}
