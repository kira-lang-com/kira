import Foundation

// EnxGenericTests.kira — Deep Result<T, E> test suite.
// Covers: Result<Int,E>, Result<struct,E>, Result<enum,E>, Result<[Int],E>;
// both Ok and Error paths; chained matching; pipeline combinator; Results in
// struct fields; Results in array elements matched via borrow-param helper;
// error-code helpers; combined patterns; trap tests.
// All top-level names use prefix enxG / EnxG.

// ---------------------------------------------------------------------------
// T = owned array (Result<[Int], EnxGErr>) tests
// ---------------------------------------------------------------------------
// buildRange(5) -> Ok([0,3,6,9,12]) -> sum=30
@Test
function enxGRangeOk5() {
    let r = enxGBuildRange(5)
    var out = 0
    match r {
        Ok(xs) -> {
            for i in 0..xs.count {
                out = out + xs[i]
            }
        }
        Error(e) -> { out = enxGErrCode(e) }
    }
    expect!(out == 30)
}

// buildRange(10) -> Ok([0,3,6,...,27]) -> sum=3*(0+1+...+9)=3*45=135
@Test
function enxGRangeOk10() {
    let r = enxGBuildRange(10)
    var out = 0
    match r {
        Ok(xs) -> {
            for i in 0..xs.count {
                out = out + xs[i]
            }
        }
        Error(e) -> { out = enxGErrCode(e) }
    }
    expect!(out == 135)
}

// buildRange(0) -> Error(Empty) -> -4
@Test
function enxGRangeErrEmpty() {
    let r = enxGBuildRange(0)
    var out = 0
    match r {
        Ok(xs) -> { out = xs.count }
        Error(e) -> { out = enxGErrCode(e) }
    }
    expect!(out == 0 - 4)
}

// buildRange(-1) -> Error(Empty) -> -4
@Test
function enxGRangeErrNeg() {
    let r = enxGBuildRange(0 - 1)
    var out = 0
    match r {
        Ok(xs) -> { out = xs.count }
        Error(e) -> { out = enxGErrCode(e) }
    }
    expect!(out == 0 - 4)
}

// buildRange(200) -> Error(Overflow) -> -2
@Test
function enxGRangeErrOverflow() {
    let r = enxGBuildRange(200)
    var out = 0
    match r {
        Ok(xs) -> { out = xs.count }
        Error(e) -> { out = enxGErrCode(e) }
    }
    expect!(out == 0 - 2)
}

// sum buildRange(m) for m=1..6:
// 0 + 3 + 9 + 18 + 30 + 45 = 105
@Test
function enxGRangeSumFold() {
    var total = 0
    for m in 1..7 {
        let r = enxGBuildRange(m)
        match r {
            Ok(xs) -> {
                for i in 0..xs.count {
                    total = total + xs[i]
                }
            }
            Error(e) -> { total = total + enxGErrCode(e) }
        }
    }
    expect!(total == 105)
}

// buildRange(3) -> count = 3
@Test
function enxGRangeCount() {
    let r = enxGBuildRange(3)
    var out = 0
    match r {
        Ok(xs) -> { out = xs.count }
        Error(e) -> { out = enxGErrCode(e) }
    }
    expect!(out == 3)
}

// buildRange(1) -> Ok([0]) -> sum=0
@Test
function enxGRangeSingleElem() {
    let r = enxGBuildRange(1)
    var out = 0
    match r {
        Ok(xs) -> { out = xs[0] }
        Error(e) -> { out = enxGErrCode(e) }
    }
    expect!(out == 0)
}

// ---------------------------------------------------------------------------
// Chained matching tests
// ---------------------------------------------------------------------------

// chain3(100, 5, 4):
// r1=Ok(20); r2=safeDiv(30,4)=Ok(7); r3=safeDiv(12,2)=Ok(6); return 20+7+6=33
@Test
function enxGChain3Success() {
    expect!(enxGChain3(100, 5, 4) == 33)
}

// chain3(100, 0, 4): r1=Error(DivByZero) -> -1
@Test
function enxGChain3ErrStep1() {
    expect!(enxGChain3(100, 0, 4) == 0 - 1)
}

// chain3(100, 5, 0): r1=Ok(20); r2=safeDiv(30,0)=Error(DivByZero) -> -1
@Test
function enxGChain3ErrStep2() {
    expect!(enxGChain3(100, 5, 0) == 0 - 1)
}

// chain3(0, 5, 4): r1=Ok(0); r2=safeDiv(10,4)=Ok(2); r3=safeDiv(7,2)=Ok(3); return 0+2+3=5
@Test
function enxGChain3ZeroSeed() {
    expect!(enxGChain3(0, 5, 4) == 5)
}

// chain3(-1, 5, 4): r1=Error(BadInput) -> -5
@Test
function enxGChain3BadInput() {
    expect!(enxGChain3(0 - 1, 5, 4) == 0 - 5)
}

// sum chain3 results for multiple inputs: 33 + (-1) + (-1) + 5 = 36
@Test
function enxGChain3SumFold() {
    let v1 = enxGChain3(100, 5, 4)
    let v2 = enxGChain3(100, 0, 4)
    let v3 = enxGChain3(100, 5, 0)
    let v4 = enxGChain3(0, 5, 4)
    expect!(v1 + v2 + v3 + v4 == 36)
}

// ---------------------------------------------------------------------------
// Pipeline combinator tests
// ---------------------------------------------------------------------------

// pipeline(12, 4, 2, 3):
// r0=Ok(12); r1=step(12,4)=safeDiv(16,4)=Ok(4);
// r2=step(4,2)=safeDiv(6,2)=Ok(3); r3=step(3,3)=safeDiv(6,3)=Ok(2); return 2
@Test
function enxGPipelineSuccess() {
    expect!(enxGPipeline(12, 4, 2, 3) == 2)
}

// pipeline(20, 0, 3, 5): k1=0 causes DivByZero at step1, propagates -> -1
@Test
function enxGPipelineErrPropagates() {
    expect!(enxGPipeline(20, 0, 3, 5) == 0 - 1)
}

// pipeline(6, 3, 2, 4):
// r0=Ok(6); r1=safeDiv(9,3)=Ok(3); r2=safeDiv(5,2)=Ok(2); r3=safeDiv(6,4)=Ok(1); return 1
@Test
function enxGPipelineSmallValues() {
    expect!(enxGPipeline(6, 3, 2, 4) == 1)
}

// Two-step manual pipeline using enxGStep
// r0=safeDiv(10,1)=Ok(10); r1=step(Ok(10),5)=safeDiv(15,5)=Ok(3);
// r2=step(Ok(3),3)=safeDiv(6,3)=Ok(2); final=2
@Test
function enxGStepTwoSteps() {
    let r0 = enxGSafeDiv(10, 1)
    let r1 = enxGStep(move r0, 5)
    let r2 = enxGStep(move r1, 3)
    var out = 0
    match r2 {
        Ok(v) -> { out = v }
        Error(e) -> { out = enxGErrCode(e) }
    }
    expect!(out == 2)
}

// ---------------------------------------------------------------------------
// Result stored in struct fields, matched via borrow
// ---------------------------------------------------------------------------

// slot{10, Ok(5)} -> 5+10=15
@Test
function enxGSlotOk() {
    let slot = EnxGSlot { tag: 10, r: .Ok(5) }
    expect!(enxGSlotVal(slot) == 15)
}

// slot{10, Error(DivByZero)} -> 10+(-1)=9
@Test
function enxGSlotErr() {
    let slot = EnxGSlot { tag: 10, r: .Error(.DivByZero) }
    expect!(enxGSlotVal(slot) == 9)
}

// slot{0, Error(BadInput)} -> 0+(-5)=-5
@Test
function enxGSlotErrBadInput() {
    let slot = EnxGSlot { tag: 0, r: .Error(.BadInput) }
    expect!(enxGSlotVal(slot) == 0 - 5)
}

// Fold slots: s=0..9, slot{s, safeDiv(200,s+1)} (all Ok, b>=1>0, a=200>=0)
// enxGSlotVal = 200/(s+1) + s
// s=0:200, s=1:101, s=2:68, s=3:53, s=4:44, s=5:38, s=6:34, s=7:32, s=8:30, s=9:29
// sum=629
@Test
function enxGSlotFold() {
    var acc = 0
    for s in 0..10 {
        let slot = EnxGSlot { tag: s, r: enxGSafeDiv(200, s + 1) }
        acc = acc + enxGSlotVal(slot)
    }
    expect!(acc == 629)
}

// Mixed slots: some Ok, some Error, fold values
// [slot{1,Ok(10)}, slot{2,Error(DivByZero)}, slot{3,Ok(20)}, slot{4,Error(Empty)}]
// values: 10+1=11, 2-1=1, 20+3=23, 4-4=0 -> sum=35
@Test
function enxGSlotMixedFold() {
    var slots: [EnxGSlot] = []
    slots.append(EnxGSlot { tag: 1, r: .Ok(10) })
    slots.append(EnxGSlot { tag: 2, r: .Error(.DivByZero) })
    slots.append(EnxGSlot { tag: 3, r: .Ok(20) })
    slots.append(EnxGSlot { tag: 4, r: .Error(.Empty) })
    var acc = 0
    for j in 0..slots.count {
        acc = acc + enxGSlotVal(slots[j])
    }
    expect!(acc == 35)
}

// ---------------------------------------------------------------------------
// Result stored in array elements, matched via borrow-param helper
// ---------------------------------------------------------------------------

// Build [Result<Int,EnxGErr>]: i=0..9, i%3==2 -> Error(NotFound), else Ok(i*5)
// i=0:Ok(0), i=1:Ok(5), i=2:Err(-3), i=3:Ok(15), i=4:Ok(20),
// i=5:Err(-3), i=6:Ok(30), i=7:Ok(35), i=8:Err(-3), i=9:Ok(45)
// sum=0+5-3+15+20-3+30+35-3+45=141
@Test
function enxGResultArrayFold() {
    var results: [Result<Int, EnxGErr>] = []
    for i in 0..10 {
        if i % 3 == 2 {
            let errItem: Result<Int, EnxGErr> = .Error(.NotFound)
            results.append(move errItem)
        } else {
            let okItem: Result<Int, EnxGErr> = .Ok(i * 5)
            results.append(move okItem)
        }
    }
    var acc = 0
    for j in 0..results.count {
        acc = acc + enxGResultIntVal(results[j])
    }
    expect!(acc == 141)
}

// Build results from safeDiv, then sum: safeDiv(100, j+1) for j=0..5 (all Ok)
// 100/1+100/2+100/3+100/4+100/5+100/6 = 100+50+33+25+20+16 = 244
@Test
function enxGResultArrayDivFold() {
    var results: [Result<Int, EnxGErr>] = []
    for j in 0..6 {
        results.append(enxGSafeDiv(100, j + 1))
    }
    var acc = 0
    for k in 0..results.count {
        acc = acc + enxGResultIntVal(results[k])
    }
    expect!(acc == 244)
}

// Mix Ok and Error in result array, count errors
// safeDiv(i-5, 2) for i=0..9: i<5 -> BadInput (-5 each); i>=5 -> Ok
// errors: i=0,1,2,3,4 -> 5 errors
@Test
function enxGResultArrayCountErrors() {
    var results: [Result<Int, EnxGErr>] = []
    for i in 0..10 {
        results.append(enxGSafeDiv(i - 5, 2))
    }
    var errCount = 0
    for j in 0..results.count {
        errCount = errCount + enxGIsError(results[j])
    }
    expect!(errCount == 5)
}

// ---------------------------------------------------------------------------
// Additional combinations
// ---------------------------------------------------------------------------

// Combine T=Int and T=struct in one test
// safeDiv(100,5)=Ok(20) plus makeRect(4,5)->area=20; total=40
@Test
function enxGCombineIntAndRect() {
    let ri = enxGSafeDiv(100, 5)
    let rr = enxGMakeRect(4, 5)
    var vi = 0
    match ri {
        Ok(x) -> { vi = x }
        Error(e) -> { vi = enxGErrCode(e) }
    }
    var vr = 0
    match rr {
        Ok(rect) -> { vr = rect.area() }
        Error(e) -> { vr = enxGErrCode(e) }
    }
    expect!(vi + vr == 40)
}

// Combine T=enum and T=array
// colorResult(2)->Ok(Neutral)->300 + sum of buildRange(3)->[0,3,6]=9; total=309
@Test
function enxGCombineToneAndRange() {
    let tone = enxGToneResultVal(enxGColorResult(2))
    let rng = enxGBuildRange(3)
    var rngSum = 0
    match rng {
        Ok(xs) -> {
            for i in 0..xs.count {
                rngSum = rngSum + xs[i]
            }
        }
        Error(e) -> { rngSum = enxGErrCode(e) }
    }
    expect!(tone + rngSum == 309)
}

// Error path combines: DivByZero(-1)+BadInput(-5)+Overflow/Rect(-5)+Empty(-4)=-15
@Test
function enxGCombineAllErrors() {
    let e1 = enxGResultIntVal(enxGSafeDiv(10, 0))
    let e2 = enxGResultIntVal(enxGSafeDiv(0 - 5, 1))
    let e3 = enxGRectResultArea(enxGMakeRect(0, 5))
    var e4 = 0
    let r4 = enxGBuildRange(0)
    match r4 {
        Ok(xs) -> { e4 = xs.count }
        Error(e) -> { e4 = enxGErrCode(e) }
    }
    expect!(e1 + e2 + e3 + e4 == 0 - 15)
}

// Nested Ok: chain feeds rect
// safeDiv(15,3)=Ok(5) -> makeRect(5,4)=Ok->area=20
@Test
function enxGChainFeedsRect() {
    let r1 = enxGSafeDiv(15, 3)
    var out = 0
    match r1 {
        Ok(x) -> {
            let r2 = enxGMakeRect(x, 4)
            match r2 {
                Ok(rect) -> { out = rect.area() }
                Error(e) -> { out = enxGErrCode(e) }
            }
        }
        Error(e) -> { out = enxGErrCode(e) }
    }
    expect!(out == 20)
}

// Multiple independent results combined
// safeDiv(100,4)=Ok(25) + safeDiv(60,3)=Ok(20) + safeDiv(0-10,5)=Error(BadInput)->-5
// 25+20-5=40
@Test
function enxGMultipleResults() {
    let v1 = enxGResultIntVal(enxGSafeDiv(100, 4))
    let v2 = enxGResultIntVal(enxGSafeDiv(60, 3))
    let v3 = enxGResultIntVal(enxGSafeDiv(0 - 10, 5))
    expect!(v1 + v2 + v3 == 40)
}

// Pipeline result feeding into rect creation
// pipeline(12,4,2,3)=2 -> makeRect(2,3)=Ok->area=6
@Test
function enxGPipelineFeedsRect() {
    let w = enxGPipeline(12, 4, 2, 3)
    let r = enxGMakeRect(w, 3)
    var out = 0
    match r {
        Ok(rect) -> { out = rect.area() }
        Error(e) -> { out = enxGErrCode(e) }
    }
    expect!(out == 6)
}

// A trap test: `expectTrap!` names the trap it expects, and the body runs in a child that traps.

// Direct divide by zero
@Test
function enxGTrapDivZero() {
    expectTrap!("")
        let a = 42
        let b = 0
        let _ = a / b
}

// Direct mod by zero
@Test
function enxGTrapModZero() {
    expectTrap!("")
        let a = 100
        let b = 0
        let _ = a % b
}

// Match Ok of range array, then index OOB
@Test
function enxGTrapOOBOnOkArray() {
    expectTrap!("")
    let r = enxGBuildRange(3)
    var out = 0
    match r {
        Ok(xs) -> {
            let _ = xs[100]
            out = 0
        }
        Error(e) -> { out = enxGErrCode(e) }
    }
}

// OOB on empty array
@Test
function enxGTrapOOBEmpty() {
    expectTrap!("")
    let xs: [Int] = []
    let _ = xs[0]
}

// OOB on result array after building it
@Test
function enxGTrapResultArrayOOB() {
    expectTrap!("")
    var results: [Result<Int, EnxGErr>] = []
    results.append(enxGSafeDiv(10, 2))
    results.append(enxGSafeDiv(20, 4))
    let _ = enxGResultIntVal(results[10])
}

// Div by zero derived from an Ok value: safeDiv(0,1)=Ok(0), then 5 / that value
@Test
function enxGTrapDivByOkValue() {
    expectTrap!("")
        let r = enxGSafeDiv(0, 1)
        var divisor = 1
        match r {
            Ok(x) -> { divisor = x }
            Error(e) -> { divisor = 1 }
        }
        let _ = 5 / divisor
}

// Mod by zero derived from Ok value
@Test
function enxGTrapModByOkValue() {
    expectTrap!("")
        let r = enxGSafeDiv(0, 5)
        var d = 1
        match r {
            Ok(x) -> { d = x }
            Error(e) -> { d = 1 }
        }
        let _ = 42 % d
}

// OOB via loop scanning result array past end
@Test
function enxGTrapResultArrayLoopOOB() {
    expectTrap!("")
    var results: [Result<Int, EnxGErr>] = []
    for i in 0..3 {
        results.append(enxGSafeDiv(i * 10, 2))
    }
    var acc = 0
    for j in 0..10 {
        acc = acc + enxGResultIntVal(results[j])
    }
}
