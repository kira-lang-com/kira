import Foundation

// Compile-time functions are ordinary Kira evaluated before semantic lowering.
// Keeping these as Test declarations proves both ends of the feature: the
// evaluator computes the call and the resulting literal still reaches the
// test runner on every backend.

comptime function ctfDouble(value: Int) -> Int {
    return value * 2
}

comptime function ctfTriangular(limit: Int) -> Int {
    var total = 0
    for i in 1..limit + 1 {
        total = total + i
    }
    return total
}

comptime function ctfComposed(value: Int) -> Int {
    return ctfDouble(ctfDouble(value)) + 1
}

comptime function ctfDescribe(value: Int) -> String {
    if value < 0 {
        return "negative"
    }
    if value == 0 {
        return "zero"
    }
    return "positive"
}

@Test
function ctfFunctionComputesAValue() {
    let got = ctfDouble(21)
    expect!(got == 42)
}

@Test
function ctfFunctionRunsAWhileLoop() {
    let got = ctfTriangular(10)
    expect!(got == 55)
}

@Test
function ctfFunctionCallsAnotherFunction() {
    let got = ctfComposed(5)
    expect!(got == 21)
}

@Test
function ctfFunctionRunsBranches() {
    let got = ctfDescribe(0)
    expect!(got == "zero")
}

// `targetPlatform!()` folds to the build target's `TargetPlatform` case during
// expansion. The harness builds for the host it runs on — macOS, Linux, or
// Windows — so the one thing true on every such build is that the case is a
// known one, never `.Unknown`. Proving that proves the macro expanded and the
// enum reached the runner on every backend.
function ctfPlatformIsKnown() -> Int {
    var known = 0
    match targetPlatform!() {
        Linux -> { known = 1 }
        Tessera -> { known = 1 }
        Android -> { known = 1 }
        MacOS -> { known = 1 }
        Windows -> { known = 1 }
        Ios -> { known = 1 }
        Wasm -> { known = 1 }
        Unknown -> { known = 0 }
    }
    return known
}

@Test
function ctfPlatformCurrentFoldsToAKnownPlatform() {
    let got = ctfPlatformIsKnown()
    expect!(got == 1)
}
