import Foundation

// EmxTests.kira — corpus migration of tests/pass/run/{enum_basic_parity,
// enum_equality_tag_compare, enum_kind_split_cache_parity,
// enum_payload_move_chain_parity, enum_result_parity,
// enum_var_reassign_return, nested_enum_payload_parity,
// copyable_payload_enum_field_reuse, fieldless_enum_is_copy,
// attempt_handle_payloadless_variant, attempt_try_handle} into the
// `kira test` @Test format. All top-level names use prefix
// emx / Emx.

// ---------------------------------------------------------------------------
// enum_basic_parity
// ---------------------------------------------------------------------------

enum EmxParseError {
    InvalidFormat: String = "Not the expected format"
    UnexpectedEnd
    EmptyInput
}

@Test
function emxParseErrorInvalidText() {
    let invalid: EmxParseError = .InvalidFormat
    var out = ""
    match invalid {
        InvalidFormat(text) -> { out = text }
        UnexpectedEnd -> { out = "unexpected" }
        EmptyInput -> { out = "empty" }
    }
    let got = out
    expect!(got == "Not the expected format")
}

@Test
function emxParseErrorEndedBranch() {
    let ended: EmxParseError = .UnexpectedEnd
    var out = ""
    match ended {
        InvalidFormat(text) -> { out = text }
        UnexpectedEnd -> { out = "end" }
        EmptyInput -> { out = "empty" }
    }
    let got = out
    expect!(got == "end")
}

@Test
function emxParseErrorEmptyBranch() {
    let empty: EmxParseError = .EmptyInput
    var out = ""
    match empty {
        InvalidFormat(text) -> { out = text }
        UnexpectedEnd -> { out = "end" }
        EmptyInput -> { out = "empty" }
    }
    let got = out
    expect!(got == "empty")
}

// ---------------------------------------------------------------------------
// enum_equality_tag_compare
// ---------------------------------------------------------------------------

enum EmxColor { Red Green Blue }

struct EmxBox { let c: EmxColor }

function emxRank(c: EmxColor) -> Int {
    if c == .Red {
        return 1
    }
    if c == .Green {
        return 2
    }
    return 3
}

function emxIsBlue(b: borrow EmxBox) -> Bool {
    return b.c == .Blue
}

@Test
function emxEqualityTagCompareTotal() {
    var total = emxRank(.Red) + emxRank(.Green) + emxRank(.Blue)
    let red: EmxColor = .Red
    let green: EmxColor = .Green
    if red != green {
        total = total + 10
    }
    let blueBox = EmxBox { c: .Blue }
    let blueResult = emxIsBlue(blueBox)
    if blueResult == true {
        total = total + 100
    }
    let got = total
    expect!(got == 116)
}

// ---------------------------------------------------------------------------
// enum_kind_split_cache_parity
// ---------------------------------------------------------------------------

construct EmxShape {
    @Required let area: Int
}

construct EmxCircle() extends EmxShape {
    let r: Int = 1
    let area: Int {
        r
    }
}

construct EmxSquare() extends EmxShape {
    let s: Int = 1
    let area: Int {
        s
    }
}

enum EmxCell {
    Filled(some EmxShape)
    Empty
}

struct EmxGrid {
    var cells: [EmxCell]
}

function emxAreaOf(c: borrow EmxCell) -> Int {
    match c {
        Filled(shape) -> return shape.area
        Empty -> return 0
    }
}

function emxTotalArea(grid: borrow EmxGrid) -> Int {
    var sum = 0
    for index in 0..grid.cells.count {
        sum = sum + emxAreaOf(grid.cells[index])
    }
    return sum
}

@Test
function emxEnumKindSplitCacheParity() {
    let cells: [EmxCell] = [.Filled(EmxCircle(r: 3)), .Empty, .Filled(EmxSquare(s: 4))]
    let grid = EmxGrid { cells: move cells }
    var out = grid.cells.count
    out = out * 100 + emxTotalArea(grid)
    let got = out
    expect!(got == 307)
}

// ---------------------------------------------------------------------------
// enum_payload_move_chain_parity
// ---------------------------------------------------------------------------

enum EmxInner {
    A: String = "a"
    B: String = "b"
}

enum EmxWrap {
    One(EmxInner)
    Two(EmxInner)
}

function emxRewrap(w: EmxWrap) -> EmxWrap {
    match w {
        One(failure) -> { return .Two(move failure) }
        Two(failure) -> { return .One(move failure) }
    }
}

@Test
function emxPayloadMoveChainParity() {
    let original: EmxWrap = .One(.A("payload"))
    let swapped = emxRewrap(move original)
    var out = ""
    match swapped {
        One(failure) -> {
            match failure {
                A(reason) -> { out = reason }
                B(reason) -> { out = reason }
            }
        }
        Two(failure) -> {
            match failure {
                A(reason) -> { out = reason }
                B(reason) -> { out = reason }
            }
        }
    }
    let got = out
    expect!(got == "payload")
}

// ---------------------------------------------------------------------------
// enum_result_parity
// ---------------------------------------------------------------------------

enum EmxResultParseError {
    InvalidFormat: String = "bad"
    UnexpectedEnd
}

@Test
function emxResultParitySuccess() {
    let success: Result<String, EmxResultParseError> = .Ok("ok")
    var out = ""
    match success {
        Ok(text) -> { out = text }
        Error(err) -> { out = "err" }
    }
    let got = out
    expect!(got == "ok")
}

@Test
function emxResultParityFailureText() {
    let failure: Result<String, EmxResultParseError> = .Error(.InvalidFormat)
    var out = ""
    match failure {
        Ok(text) -> { out = text }
        Error(err) -> {
            match err {
                InvalidFormat(t) -> { out = t }
                UnexpectedEnd -> { out = "end" }
            }
        }
    }
    let got = out
    expect!(got == "bad")
}

// ---------------------------------------------------------------------------
// enum_var_reassign_return
// ---------------------------------------------------------------------------

enum EmxShade { Light Dark Mid }

function emxShadeWeight(s: borrow EmxShade) -> Int {
    match s {
        Light -> { return 1 }
        Dark -> { return 2 }
        Mid -> { return 3 }
    }
}

function emxShadeFor(i: Int) -> EmxShade {
    var s: EmxShade = .Light
    if (i % 3) == 0 {
        s = .Light
    } else if (i % 3) == 1 {
        s = .Dark
    } else if (i % 3) == 2 {
        s = .Mid
    } else {
        s = .Light
    }
    return s
}

enum EmxValBox { Empty Val(Int) }

function emxBoxVal(b: borrow EmxValBox) -> Int {
    match b {
        Empty -> { return 0 }
        Val(v) -> { return v }
    }
}

function emxPick(i: Int) -> EmxValBox {
    var b: EmxValBox = .Empty
    if i % 2 == 0 {
        b = .Val(i * 10)
    }
    if i % 3 == 0 {
        b = .Val(i * 100)
    }
    return b
}

@Test
function emxVarReassignReturn() {
    var acc = 0
    for i in 0..60 {
        acc = acc + emxShadeWeight(emxShadeFor(i))
    }
    for j in 0..20 {
        acc = acc + emxBoxVal(emxPick(j))
    }
    let got = acc
    expect!(got == 6960)
}

// ---------------------------------------------------------------------------
// nested_enum_payload_parity (also reused by attempt_try_handle below)
// ---------------------------------------------------------------------------

enum EmxRenderFailure {
    MissingNode: String = "missing"
    InvalidState: String = "invalid"
}

function emxFailWith(useMissing: Bool) -> Result<Int, EmxRenderFailure> {
    if useMissing {
        return .Error(.MissingNode("boom"))
    }
    return .Error(.InvalidState("halt"))
}

function emxReportReason(r: Result<Int, EmxRenderFailure>) -> String {
    var out = ""
    match r {
        Ok(value) -> { out = "ok" }
        Error(failure) -> {
            match failure {
                MissingNode(reason) -> { out = reason }
                InvalidState(reason) -> { out = reason }
            }
        }
    }
    return out
}

@Test
function emxNestedEnumPayloadParityMissing() {
    let got = emxReportReason(emxFailWith(true))
    expect!(got == "boom")
}

@Test
function emxNestedEnumPayloadParityInvalid() {
    let got = emxReportReason(emxFailWith(false))
    expect!(got == "halt")
}

// ---------------------------------------------------------------------------
// copyable_payload_enum_field_reuse
// ---------------------------------------------------------------------------

enum EmxDimension {
    Fixed(Float)
    Fill
    Bounded(Float)
}

struct EmxSizeBox {
    let width: EmxDimension
    let height: EmxDimension
}

function emxConsume(d: EmxDimension) -> Int {
    match d {
        Fill -> return 1
        Fixed(_) -> return 0
        Bounded(_) -> return 0
    }
}

function emxCheck(box: EmxSizeBox) -> Int {
    let a = emxConsume(box.width)
    let b = emxConsume(box.width)
    return a + b
}

@Test
function emxCopyablePayloadEnumFieldReuse() {
    let box = EmxSizeBox { width: .Fill, height: .Fixed(3.0) }
    let got = emxCheck(move box)
    expect!(got == 2)
}

// ---------------------------------------------------------------------------
// fieldless_enum_is_copy
// ---------------------------------------------------------------------------

enum EmxAxis {
    Horizontal
    Vertical
}

function emxCode(axis: EmxAxis) -> Int {
    if axis == .Horizontal {
        return 1
    }
    return 2
}

struct EmxDescriptor {
    let axis: EmxAxis
    let weight: Int
}

function emxScore(descriptor: EmxDescriptor) -> Int {
    let first = emxCode(descriptor.axis)
    let second = emxCode(descriptor.axis)
    return first + second + descriptor.weight
}

@Test
function emxFieldlessEnumIsCopy() {
    let descriptor = EmxDescriptor { axis: .Vertical, weight: 5 }
    let got = emxScore(move descriptor)
    expect!(got == 9)
}

// ---------------------------------------------------------------------------
// attempt_handle_payloadless_variant
// ---------------------------------------------------------------------------

enum EmxClampError {
    TooSmall
    TooBig
}

function emxClamp(n: Int) -> Result<Int, EmxClampError> {
    if n < 0 {
        return .Error(.TooSmall)
    }
    if n > 100 {
        return .Error(.TooBig)
    }
    return .Ok(n)
}

function emxProcess(n: Int) -> Int {
    attempt {
        let v = try emxClamp(n)
        return v * 2
    } handle {
        TooSmall { return 0 - 1 }
        TooBig { return 0 - 2 }
    }
}

function emxBump(x: Int) -> Int {
    let f: (Int) -> Int = { v in return v + 1 }
    return f(x)
}

@Test
function emxAttemptHandlePayloadlessVariantOk() {
    let got = emxProcess(50)
    expect!(got == 100)
}

@Test
function emxAttemptHandlePayloadlessVariantTooSmall() {
    let got = emxProcess(0 - 5)
    expect!(got == 0 - 1)
}

@Test
function emxAttemptHandlePayloadlessVariantTooBig() {
    let got = emxProcess(200)
    expect!(got == 0 - 2)
}

@Test
function emxAttemptHandlePayloadlessVariantBump() {
    let got = emxBump(41)
    expect!(got == 42)
}

// ---------------------------------------------------------------------------
// attempt_try_handle
// ---------------------------------------------------------------------------

function emxRenderOk() -> Result<Int, EmxRenderFailure> {
    return .Ok(42)
}

function emxRenderFail() -> Result<Int, EmxRenderFailure> {
    return .Error(.MissingNode("boom"))
}

function emxAttemptTryHandleValue() -> Int {
    attempt {
        let value = try emxRenderOk()
        return value
    } handle {
        MissingNode(reason) { return 0 - 1 }
        InvalidState(reason) { return 0 - 2 }
    }
}

function emxAttemptTryHandleFailReason() -> String {
    attempt {
        let value = try emxRenderFail()
        return "ok"
    } handle {
        MissingNode(reason) { return reason }
        InvalidState(reason) { return reason }
    }
}

@Test
function emxAttemptTryHandleOk() {
    let got = emxAttemptTryHandleValue()
    expect!(got == 42)
}

@Test
function emxAttemptTryHandleFail() {
    let got = emxAttemptTryHandleFailReason()
    expect!(got == "boom")
}
