import Foundation

// ColxCollectionTests.kira
// Deep array test suite. All top-level names use colx / Colx prefix.
// ~85 tests (including ~20 trap tests).

// ---------------------------------------------------------------------------
// GROUP I - ColxGrid
// ---------------------------------------------------------------------------
@Test
function colxGridSum5() {
    var cells: [Int] = []
    cells.append(1)
    cells.append(2)
    cells.append(3)
    cells.append(4)
    cells.append(5)
    let grid = ColxGrid { cells: move cells }
    expect!(grid.sum() == 15)
}

@Test
function colxGridCellCount7() {
    var cells: [Int] = []
    for i in 0..7 {
        cells.append(i)
    }
    let grid = ColxGrid { cells: move cells }
    expect!(grid.cellCount() == 7)
}

// 0+1+...+99 = 4950
@Test
function colxGridLarge100() {
    var cells: [Int] = []
    for i in 0..100 {
        cells.append(i)
    }
    let grid = ColxGrid { cells: move cells }
    expect!(grid.sum() == 4950)
}

// r=0: 0+1+2+3=6, r=1: 4+5+6+7=22, r=2: 8+9+10+11=38 -> 66
@Test
function colxGridMultiRowSum() {
    // 3 grids with 4 cells each: grid r has cells r*4, r*4+1, r*4+2, r*4+3
    var total = 0
    for r in 0..3 {
        var cells: [Int] = []
        for c in 0..4 {
            cells.append(r * 4 + c)
        }
        let grid = ColxGrid { cells: move cells }
        total = total + grid.sum()
    }
    expect!(total == 66)
}

@Test
function colxGridEmptySum() {
    let cells: [Int] = []
    let grid = ColxGrid { cells: move cells }
    expect!(grid.sum() == 0)
}

@Test
function colxGridEmptyCount() {
    let cells: [Int] = []
    let grid = ColxGrid { cells: move cells }
    expect!(grid.cellCount() == 0)
}

// 0+1+...+9 = 45
@Test
function colxGridRangeSum() {
    let cells = colxBuildRange(10)
    let grid = ColxGrid { cells: move cells }
    expect!(grid.sum() == 45)
}

// 0+1+4+9+16+25+36+49 = 140
@Test
function colxGridSquaresSum() {
    let cells = colxBuildSquares(8)
    let grid = ColxGrid { cells: move cells }
    expect!(grid.sum() == 140)
}

// ---------------------------------------------------------------------------
// GROUP J - Allocation churn
// ---------------------------------------------------------------------------

// 10 per round * 100 = 1000
@Test
function colxChurnRange100() {
    var total = 0
    for round in 0..100 {
        let xs = colxBuildRange(5)
        total = total + colxSum(xs)
    }
    expect!(total == 1000)
}

// 285 per round * 50 = 14250
@Test
function colxChurnSquares50() {
    var total = 0
    for round in 0..50 {
        let xs = colxBuildSquares(10)
        total = total + colxSum(xs)
    }
    expect!(total == 14250)
}

// 33 per round * 30 = 990
@Test
function colxChurnFib30() {
    var total = 0
    for round in 0..30 {
        let xs = colxBuildFib(8)
        total = total + colxSum(xs)
    }
    expect!(total == 990)
}

// rev[0]=7 per round, 7*20=140
@Test
function colxChurnReverse20() {
    var total = 0
    for round in 0..20 {
        let xs = colxBuildRange(8)
        let rev = colxReverse(xs)
        total = total + rev[0]
    }
    expect!(total == 140)
}

// sum x = 10 per round * 40 = 400
@Test
function colxChurnStructs40() {
    var total = 0
    for round in 0..40 {
        var pts: [ColxPt] = []
        for i in 0..5 {
            pts.append(ColxPt { x: i, y: 0 })
        }
        var s = 0
        for j in 0..pts.count {
            s = s + pts[j].x
        }
        total = total + s
    }
    expect!(total == 400)
}

// r-th round sum=3r+3; total=sum(3r+3 for r=0..24)=3*(0+...+24)+3*25=3*300+75=975
@Test
function colxChurnGrids25() {
    var total = 0
    for r in 0..25 {
        var cells: [Int] = []
        cells.append(r)
        cells.append(r + 1)
        cells.append(r + 2)
        let grid = ColxGrid { cells: move cells }
        total = total + grid.sum()
    }
    expect!(total == 975)
}

// sum(i^2 for i=0..19)=19*20*39/6=2470; 2470*200=494000
@Test
function colxChurnLarge200() {
    var total = 0
    for round in 0..200 {
        let xs = colxBuildSquares(20)
        total = total + colxSum(xs)
    }
    expect!(total == 494000)
}

// range(5)=10, squares(5)=30, fib(5)=[0,1,1,2,3]=7; 47*30=1410
@Test
function colxChurnMixed30() {
    var total = 0
    for round in 0..30 {
        let a = colxBuildRange(5)
        let b = colxBuildSquares(5)
        let c = colxBuildFib(5)
        total = total + colxSum(a) + colxSum(b) + colxSum(c)
    }
    expect!(total == 1410)
}

// A trap test: `expectTrap!` names the trap it expects, and the body runs in a child that traps.

@Test
function colxTrapDivByZero() {
    expectTrap!("")
    let x = 10 / 0
}

@Test
function colxTrapModByZero() {
    expectTrap!("")
    let x = 10 % 0
}

@Test
function colxTrapDivByZeroVar() {
    expectTrap!("")
    var xs: [Int] = []
    xs.append(0)
    let result = 100 / xs[0]
}

@Test
function colxTrapModByZeroVar() {
    expectTrap!("")
    var xs: [Int] = []
    xs.append(0)
    let result = 100 % xs[0]
}

@Test
function colxTrapIndexAtCount() {
    expectTrap!("")
    let xs = colxBuildRange(5)
    let _ = xs[xs.count]
}

@Test
function colxTrapLoopOOB() {
    expectTrap!("")
    var xs: [Int] = []
    xs.append(1)
    xs.append(2)
    xs.append(3)
    var acc = 0
    for i in 0..(xs.count + 1) {
        acc = acc + xs[i]
    }
}

@Test
function colxTrapWriteOOB() {
    expectTrap!("")
    var xs: [Int] = []
    xs.append(1)
    xs.append(2)
    xs[2] = 99
}

@Test
function colxTrapFibOOBDirect() {
    expectTrap!("")
    let xs = colxBuildFib(5)
    let _ = xs[5]
}

// ---------------------------------------------------------------------------
// Nested arrays ([[T]]): the inner-array element teardown/clone leak. Array
// elements are tag-5 RAW_PTR bridge values, so a [[Int]]/[[String]]'s boxed
// inner arrays are freed by a per-element wrapper (kira_destroy_arr_<[T]>); the
// overwrite path drops the replaced inner array through the ARRAY's element
// destructor, and a struct copy deep-clones the outer nested array so box and
// copy own independent inner arrays. String payloads prove the inner OWNED
// contents (byte buffers) free too. Guards the fix under the harness leak run
// (a per-iteration inner-array box + storage leak scales) and cross-backend
// parity (the checksum must be byte-identical on vm/llvm/hybrid).
// ---------------------------------------------------------------------------

struct ColxNestBox {
    var rows: [[Int]]
}

function colxSumNest(b: borrow ColxNestBox) -> Int {
    var total = 0
    for gi in 0..b.rows.count {
        for gj in 0..b.rows[gi].count {
            total = total + b.rows[gi][gj]
        }
    }
    return total
}

// per iteration: 2*214 + 3 + 2 + 2 = 435; 200 * 435 = 87000
@Test
function colxNestedArrayFree() {
    var total = 0
    for i in 0..200 {
        // [[Int]]: build 4x4, move inner arrays in.
        var grid: [[Int]] = []
        for r in 0..4 {
            var row: [Int] = []
            for c in 0..4 {
                row.append(r * 4 + c)
            }
            grid.append(move row)
        }
        // Overwrite/replace an inner array (the drop-replaced element path).
        var repl: [Int] = []
        repl.append(100)
        grid[0] = move repl
        // A struct copy deep-clones the outer nested array (independent inners).
        let box = ColxNestBox { rows: move grid }
        let copy = box
        total = total + colxSumNest(box) + colxSumNest(copy)
        // [[String]]: inner arrays own heap string buffers that must free too.
        var words: [[String]] = []
        for w in 0..3 {
            var line: [String] = []
            line.append("a" + "b")
            line.append("c" + "d")
            words.append(move line)
        }
        total = total + words.count + words[0].count + words[0][0].count
    }
    expect!(total == 87000)
}
