import Foundation

// Foundation geometry is deliberately exercised through its public methods and
// the arithmetic operators that desugar to them. The values and named algebra
// remain backend-independent.

function fndScaled(value: Float, digits: Int) -> Int {
    var scale = 1
    for i in 0..digits {
        scale = scale * 10
    }
    return Int(value * Float(scale))
}

function fndMakeVec2() -> Vec2 {
    return Vec2(1.0, 2.0)
}

@Test
function foundationOperatorsAcceptTemporaryValues() {
    let left = fndMakeVec2() + Vec2(3.0, 4.0)
    let right = Vec2(3.0, 4.0) + fndMakeVec2()
    let scaled = fndMakeVec2() * 2.0
    let got = Int(left.x) + Int(right.y) + Int(scaled.x)
    expect!(got == 12)
}

@Test
function foundationVec2Operations() {
    let value = Vec2(3.0, 4.0)
    let other = Vec2(1.0, 2.0)
    let sum = value + other
    let difference = value - other
    let scaled = value * 2.0
    let halved = value / 2.0
    let unit = value.normalize()
    let got = Int(value.length()) + Int(value.dot(other)) + Int(sum.x) + Int(difference.y)
        + Int(scaled.x) + Int(halved.y) + fndScaled(unit.x, 1)
    expect!(got == 36)
}

@Test
function foundationVec3CrossAndNormalize() {
    let x = Vec3(1.0, 0.0, 0.0)
    let y = Vec3(0.0, 1.0, 0.0)
    let cross = x.cross(y)
    let value = Vec3(2.0, 0.0, 0.0)
    let unit = value.normalize()
    let scaled = value * 2.0
    let halved = value / 2.0
    let got = Int(cross.z) + fndScaled(unit.x, 1) + Int(value.dot(value))
        + Int(scaled.x) + Int(halved.x)
    expect!(got == 20)
}

@Test
function foundationVec4Operations() {
    let value = Vec4(1.0, 2.0, 2.0, 4.0)
    let other = Vec4(2.0, 1.0, 0.0, 1.0)
    let sum = value + other
    let difference = value - other
    let scaled = value * 2.0
    let halved = value / 2.0
    let got = Int(value.dot(other)) + Int(sum.w) + Int(difference.x) + Int(value.length())
        + Int(scaled.w) + Int(halved.w)
    expect!(got == 27)
}

function foundationRectBoundariesAnswer() -> Number {
    let rect = Rect(10.0, 20.0, 30.0, 40.0)
    let inside = rect.contains(Point(25.0, 50.0))
    let edge = rect.contains(Point(40.0, 60.0))
    let outside = rect.contains(Point(41.0, 60.0))
    if inside && edge && outside == false {
        return Int(rect.minX()) + Int(rect.minY()) + Int(rect.maxX()) + Int(rect.maxY())
    }
    return 0
}

@Test
function foundationRectBoundaries() {
    expect!(foundationRectBoundariesAnswer() == 130)
}
@Test
function foundationMatrixComposition() {
    let offset = Vec3(2.0, 3.0, 4.0)
    let amount = Vec3(5.0, 6.0, 7.0)
    let translated = mat4Translate(offset)
    let scaled = mat4Scale(amount)
    let combined = translated * scaled
    let got = Int(translated.m03) + Int(translated.m13) + Int(translated.m23)
        + Int(scaled.m00) + Int(scaled.m11) + Int(scaled.m22)
        + Int(combined.m03) + Int(combined.m13) + Int(combined.m23)
    expect!(got == 36)
}

@Test
function foundationQuaternionRotation() {
    let axis = Vec3(0.0, 0.0, 1.0)
    let quarter = quaternionFromAxisAngle(axis, 1.5707963267948966)
    let matrix = quarter.toMat4()
    let rotated = mat4Identity().rotate(axis, 1.5707963267948966)
    let got = fndScaled(matrix.m01, 0) + fndScaled(matrix.m10, 0)
        + fndScaled(rotated.m01, 0) + fndScaled(rotated.m10, 0)
    expect!(got == 0)
}

@Test
function foundationQuaternionComposition() {
    let identity = Quaternion()
    let value = Quaternion(1.0, 2.0, 3.0, 4.0)
    let same = identity.multiply(value)
    let zero = Quaternion(0.0, 0.0, 0.0, 0.0).normalize()
    let got = Int(same.x) + Int(same.y) + Int(same.z) + Int(same.w) + Int(zero.w)
    expect!(got == 11)
}

@Test
function foundationPerspectiveAndLookAt() {
    let perspective = mat4Perspective(1.5707963267948966, 1.0, 1.0, 100.0)
    let eye = Vec3(0.0, 0.0, 1.0)
    let target = Vec3(0.0, 0.0, 0.0)
    let up = Vec3(0.0, 1.0, 0.0)
    let view = mat4LookAt(eye, target, up)
    let got = fndScaled(perspective.m00, 0) + fndScaled(perspective.m11, 0)
        + Int(view.m00) + Int(view.m11) + Int(view.m22) + Int(view.m23)
    expect!(got == 4)
}

@Test
function foundationZeroNormalizesToTheIdentityFallback() {
    let vector = Vec3(0.0, 0.0, 0.0).normalize()
    let quaternion = Quaternion(0.0, 0.0, 0.0, 0.0).normalize()
    let got = Int(vector.x) + Int(vector.y) + Int(vector.z) + Int(quaternion.w)
    expect!(got == 1)
}

@Test
function foundationRotatesAboutEachAxis() {
    let quarter = 1.5707963267948966
    let x = mat4RotateX(quarter)
    let y = mat4RotateY(quarter)
    let z = mat4RotateZ(quarter)
    // Each turns its next axis onto the one after: y onto z, z onto x,
    // x onto y. The sines are 1 to the last digit, the cosines 0.
    let got = fndScaled(x.m21, 3) + fndScaled(y.m02, 3) + fndScaled(z.m10, 3)
        + fndScaled(x.m11, 3) + fndScaled(y.m00, 3) + fndScaled(z.m00, 3)
    expect!(got == 3000)
}

@Test
function foundationLengthHoldsForLargeValues() {
    let got = Int(Vec3(0.0, 0.0, 10000.0).length() + 0.5)
    expect!(got == 10000)
}
