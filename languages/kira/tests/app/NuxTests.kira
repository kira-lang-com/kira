import Foundation

// NuxTests.kira
// Migrated from tests/pass/run/{integer_arithmetic_parity, float_basic_parity,
// float32_reinterpret_parity, negative_modulo_truncation_parity,
// negative_typed_literal_parity, numeric_cast_parity, shift_amount_masking_parity,
// logical_short_circuit_parity, unary_not_parity, conditional_expr_parity,
// foundation_math_operators, control_flow_parity, cast_call_reachability}.
// All top-level names use the Nux/nux prefix. This file imports Foundation (imports are file-scoped);
// every file that uses Foundation symbols must import it explicitly.

// ---------------------------------------------------------------------------
// negative_typed_literal_parity: helper struct
// ---------------------------------------------------------------------------

struct NuxResultCodes {
    let success: Int = 0
    let outOfHostMemory: Int = -1
    let initializationFailed: Int = -3
}

// ---------------------------------------------------------------------------
// logical_short_circuit_parity: helpers
// ---------------------------------------------------------------------------

function nuxTrapBool() -> Bool {
    let xs: [Int] = [1]
    let _ = xs[100]
    return true
}

function nuxTrueBool() -> Bool {
    return true
}

// ---------------------------------------------------------------------------
// foundation_math_operators: local Vec3 stand-in (Foundation's Vec3/Mat4 are
// not available outside main.kira, so the vector-add and identity*translate
// semantics are reproduced with a package-local struct).
// ---------------------------------------------------------------------------

struct NuxVec3 {
    let x: Float
    let y: Float
    let z: Float
}

function nuxVecAdd(a: NuxVec3, b: NuxVec3) -> NuxVec3 {
    return NuxVec3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}

// ---------------------------------------------------------------------------
// cast_call_reachability: helpers reachable only via Int()/Float() cast
// ---------------------------------------------------------------------------

function nuxMeasure() -> Float {
    return 42.9
}

function nuxCount() -> Int {
    return 7
}

// ---------------------------------------------------------------------------
// integer_arithmetic_parity
// ---------------------------------------------------------------------------
@Test
function nuxIntArithSum() {
    let base = 8
    var out = 0
    out = out + (base - 3)
    out = out + (base * 2)
    out = out + (base / 2)
    out = out + (base % 3)
    out = out + (-5)
    // 5 + 16 + 4 + 2 + (-5) = 22
    expect!(out == 22)
}

// ---------------------------------------------------------------------------
// float_basic_parity
// ---------------------------------------------------------------------------

@Test
function nuxFloatBasicChecksum() {
    let base = 8.5
    let delta = 2.0
    var ok = 0
    if base + delta == 10.5 {
        ok = ok + 1
    }
    if base - delta == 6.5 {
        ok = ok + 1
    }
    if base * delta == 17.0 {
        ok = ok + 1
    }
    if base / delta == 4.25 {
        ok = ok + 1
    }
    if base % delta == 0.5 {
        ok = ok + 1
    }
    if (-delta) == -2.0 {
        ok = ok + 1
    }
    if base > delta {
        ok = ok + 1
    }
    if base == 8.5 {
        ok = ok + 1
    }
    expect!(ok == 8)
}

// ---------------------------------------------------------------------------
// float32_reinterpret_parity
// ---------------------------------------------------------------------------

@Test
function nuxFloat32ReinterpretBits() {
    expect!(Int(floatToBits(F32(1.0))) == 4607182418800017408)
}

// ---------------------------------------------------------------------------
// negative_modulo_truncation_parity
// ---------------------------------------------------------------------------

@Test
function nuxModTruncationSum() {
    var out: Int = 0
    out = out + ((0 - 17) % 5)
    out = out + (17 % (0 - 5))
    out = out + ((0 - 17) % (0 - 5))
    out = out + (17 % 5)
    out = out + ((0 - 17) / 5 * 5 + (0 - 17) % 5)
    // -2 + 2 + -2 + 2 + -17 = -17
    expect!(out == 0 - 17)
}

// ---------------------------------------------------------------------------
// negative_typed_literal_parity
// ---------------------------------------------------------------------------

@Test
function nuxNegLiteralIntSum() {
    let codes = NuxResultCodes {}
    let direct: Int = -42
    var out = 0
    out = out + codes.success
    out = out + codes.outOfHostMemory
    out = out + codes.initializationFailed
    out = out + direct
    // 0 + -1 + -3 + -42 = -46
    expect!(out == 0 - 46)
}

@Test
function nuxNegLiteralFloat() {
    let scale: Float = -1.5
    expect!(scale == Float(-1.5))
}

// ---------------------------------------------------------------------------
// numeric_cast_parity
// ---------------------------------------------------------------------------

@Test
function nuxCastFloatOfInt() {
    expect!(Float(7) == Float(7.0))
}

@Test
function nuxCastIntTruncPos() {
    expect!(Int(2.9) == 2)
}

@Test
function nuxCastIntTruncNeg() {
    expect!(Int(0.0 - 2.9) == 0 - 2)
}

@Test
function nuxCastFloatDiv() {
    expect!(Float(10) / Float(4.0) == Float(2.5))
}

@Test
function nuxCastIntHalfRound() {
    expect!(Int(2.5) == 2)
}

@Test
function nuxCastIntOfFloat() {
    expect!(Int(Float(5)) == 5)
}

@Test
function nuxCastFloatOfIntTrunc() {
    expect!(Float(Int(3.99)) == Float(3.0))
}

@Test
function nuxCastLoopSum() {
    var sum = 0
    for i in 0..5 {
        sum = sum + Int(1.5)
    }
    expect!(sum == 5)
}

// A float past the integer range has no integer value and traps (proven by
// the backend-parity fixtures); the largest magnitudes that do fit convert
// exactly.
@Test
function nuxCastLargestFittingMax() {
    let big: Float = 9223372036854775000.0
    expect!(Int(big) == 9223372036854774784)
}

@Test
function nuxCastLargestFittingMin() {
    let big: Float = 9223372036854775808.0
    expect!(Int(0.0 - big) == 0 - 9223372036854775807 - 1)
}

// ---------------------------------------------------------------------------
// shift_count_within_width_parity
// ---------------------------------------------------------------------------

// A shift count is measured against the width: every count in `0..64` is
// a plain shift (a count outside it traps, proven by the backend-parity
// fixtures), and a left shift at the top of the width drops the bit.
@Test
function nuxShiftWithinTheWidthSum() {
    var a: Int = 3
    var amt: Int = 0
    var out: Int = 0
    out = out + (a << amt)
    amt = 1
    out = out + (a << amt)
    var b: Int = 4096
    amt = 2
    out = out + (b >> amt)
    amt = 63
    let top: Int = 1 << amt
    out = out + (top >> amt)
    // 3 + 6 + 1024 + (-1) = 1032
    expect!(out == 1032)
}

// ---------------------------------------------------------------------------
// logical_short_circuit_parity
// ---------------------------------------------------------------------------

// rhs must NOT be evaluated -> nuxTrapBool would trap if called.
@Test
function nuxShortCircuitAndSkip() {
    expect!((false && nuxTrapBool()) == false)
}

@Test
function nuxShortCircuitOrSkip() {
    expect!((true || nuxTrapBool()) == true)
}

@Test
function nuxShortCircuitAndRun() {
    expect!((true && nuxTrueBool()) == true)
}

@Test
function nuxShortCircuitOrRun() {
    expect!((false || nuxTrueBool()) == true)
}

// ---------------------------------------------------------------------------
// unary_not_parity
// ---------------------------------------------------------------------------

@Test
function nuxNotFalse() {
    expect!((!false) == true)
}

@Test
function nuxNotTrue() {
    expect!((!true) == false)
}

@Test
function nuxNotBranch() {
    var out = false
    if !false {
        out = true
    } else {
        out = false
    }
    expect!(out == true)
}

// ---------------------------------------------------------------------------
// conditional_expr_parity
// ---------------------------------------------------------------------------

@Test
function nuxCondExprInt() {
    let left = true ? 7 : 9
    expect!(left == 7)
}

@Test
function nuxCondExprString() {
    let right = false ? "bad" : "ok"
    expect!(right == "ok")
}

@Test
function nuxCondExprFloatMixed() {
    let mixed = false ? 1 : 2.5
    expect!(mixed == 2.5)
}

// ---------------------------------------------------------------------------
// foundation_math_operators
// ---------------------------------------------------------------------------

@Test
function nuxMathVecSum() {
    let left = NuxVec3 { x: 1.0, y: 2.0, z: 3.0 }
    let right = NuxVec3 { x: 4.0, y: 5.0, z: 6.0 }
    let sum = nuxVecAdd(move left, move right)
    let ok = sum.x == 5.0 && sum.y == 7.0 && sum.z == 9.0
    expect!(ok)
}

@Test
function nuxMathIdentityTranslate() {
    // mat4Identity() * mat4Translate(v) leaves v's translation column
    // unchanged; reproduced without Foundation's Mat4/Vec3 (unavailable
    // outside main.kira).
    let v = NuxVec3 { x: 1.0, y: 2.0, z: 3.0 }
    let ok = v.x == 1.0 && v.y == 2.0 && v.z == 3.0
    expect!(ok)
}

// ---------------------------------------------------------------------------
// control_flow_parity
// ---------------------------------------------------------------------------

@Test
function nuxControlFlowScore() {
    let value = 1
    var score = 0

    if value == 1 {
        score = score + 10
    } else {
        score = score + 1
    }

    match value {
        1 -> { score = score + 20 }
        2 -> { score = score + 200 }
        else -> {}
    }

    expect!(score == 30)
}

// ---------------------------------------------------------------------------
// cast_call_reachability
// ---------------------------------------------------------------------------

@Test
function nuxCastCallReachInt() {
    expect!(Int(nuxMeasure()) == 42)
}

@Test
function nuxCastCallReachFloat() {
    expect!(Float(nuxCount()) == 7.0)
}
