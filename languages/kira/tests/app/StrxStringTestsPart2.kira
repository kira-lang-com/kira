import Foundation

// StrxStringTests.kira — deep string coverage for `kira test`.
// PREFIX: strx / Strx  (all top-level names use this prefix).
// This file imports Foundation (imports are file-scoped); harness flat namespace already has it.

// ---------------------------------------------------------------------------
// Array of structs with String fields
// ---------------------------------------------------------------------------
@Test
function strxBoxArrCount() {
    var boxes: [StrxBox] = []
    for i in 0..8 {
        let nm = strxPk(i)
        boxes.append(StrxBox { name: move nm, code: i })
    }
    expect!(boxes.count == 8)
}

@Test
function strxBoxArrSum() {
    var boxes: [StrxBox] = []
    for i in 0..10 {
        let nm = strxPk(i)
        boxes.append(StrxBox { name: move nm, code: 0 })
    }
    var total = 0
    for j in 0..boxes.count {
        total = total + boxes[j].nameLen()
    }
    // 2 periods of 15 = 30
    expect!(total == 30)
}

@Test
function strxBoxArrIdx3() {
    var boxes: [StrxBox] = []
    for i in 0..10 {
        let nm = strxPk(i)
        boxes.append(StrxBox { name: move nm, code: i })
    }
    // i=3 -> strxPk(3) = "by" = 2
    expect!(boxes[3].name.count == 2)
}

@Test
function strxBoxArrIdxCode() {
    var boxes: [StrxBox] = []
    for i in 0..6 {
        let nm = strxPk(i)
        boxes.append(StrxBox { name: move nm, code: i * 10 })
    }
    // i=4 -> code = 40
    expect!(boxes[4].code == 40)
}

// ---------------------------------------------------------------------------
// Nested struct with String field
// ---------------------------------------------------------------------------

@Test
function strxOutLen1() {
    let o = StrxBoxOuter { inner: StrxBoxInner { word: "hello" }, tag: "ab", n: 10 }
    // 5 + 2 + 10 = 17
    expect!(strxOutLen(o) == 17)
}

@Test
function strxOutLen2() {
    let o = StrxBoxOuter { inner: StrxBoxInner { word: "" }, tag: "xyz", n: 0 }
    // 0 + 3 + 0 = 3
    expect!(strxOutLen(o) == 3)
}

@Test
function strxOutDirect() {
    let o = StrxBoxOuter { inner: StrxBoxInner { word: "abcd" }, tag: "xy", n: 5 }
    // "abcd" = 4
    expect!(o.inner.word.count == 4)
}

@Test
function strxOutTagCount() {
    let o = StrxBoxOuter { inner: StrxBoxInner { word: "test" }, tag: "kira", n: 0 }
    // "kira" = 4
    expect!(o.tag.count == 4)
}

@Test
function strxOutTwoFields() {
    let o = StrxBoxOuter { inner: StrxBoxInner { word: "abcde" }, tag: "xy", n: 3 }
    // 5 + 2 = 7
    expect!(o.inner.word.count + o.tag.count == 7)
}

@Test
function strxInnerWordLen() {
    let inn = StrxBoxInner { word: "hello" }
    // 5
    expect!(inn.word.count == 5)
}

// ---------------------------------------------------------------------------
// String-payload enum
// ---------------------------------------------------------------------------

@Test
function strxLblNamed() {
    let l: StrxLbl = .Named("hello")
    expect!(strxLblLen(l) == 5)
}

@Test
function strxLblEmpty() {
    let l: StrxLbl = .Empty
    expect!(strxLblLen(l) == 0)
}

@Test
function strxLblNamedZero() {
    let l: StrxLbl = .Named("")
    expect!(strxLblLen(l) == 0)
}

@Test
function strxLblFor0() {
    let l = strxLblFor(0)
    // Named("hello") = 5
    expect!(strxLblLen(l) == 5)
}

@Test
function strxLblFor1() {
    let l = strxLblFor(1)
    // Empty = 0
    expect!(strxLblLen(l) == 0)
}

@Test
function strxLblFor2() {
    let l = strxLblFor(2)
    // Named("ok") = 2
    expect!(strxLblLen(l) == 2)
}

@Test
function strxLblFor3() {
    let l = strxLblFor(3)
    // 3 % 3 = 0 -> Named("hello") = 5
    expect!(strxLblLen(l) == 5)
}

@Test
function strxLblLoopSum() {
    var total = 0
    for i in 0..30 {
        let l = strxLblFor(i)
        total = total + strxLblLen(l)
    }
    // 10 periods of (5+0+2) = 70
    expect!(total == 70)
}

@Test
function strxLblArrBuild() {
    var lbls: [StrxLbl] = []
    for i in 0..15 {
        lbls.append(strxLblFor(i))
    }
    var total = 0
    for j in 0..lbls.count {
        total = total + strxLblLen(lbls[j])
    }
    // 5 periods of 7 = 35
    expect!(total == 35)
}

@Test
function strxLblArrCount() {
    var lbls: [StrxLbl] = []
    for i in 0..9 {
        lbls.append(strxLblFor(i))
    }
    expect!(lbls.count == 9)
}

// ---------------------------------------------------------------------------
// String arrays — literal and built
// ---------------------------------------------------------------------------

@Test
function strxArrLitIdx0() {
    let arr = ["one", "two", "three"]
    // "one" = 3
    expect!(arr[0].count == 3)
}

@Test
function strxArrLitIdx2() {
    let arr = ["one", "two", "three"]
    // "three" = 5
    expect!(arr[2].count == 5)
}

@Test
function strxArrLitForIn() {
    let ws = ["cat", "dog", "fish", ""]
    var total = 0
    for w in ws {
        total = total + w.count
    }
    // 3+3+4+0 = 10
    expect!(total == 10)
}

@Test
function strxArrLitCount() {
    let arr = ["a", "b", "c"]
    expect!(arr.count == 3)
}

@Test
function strxArrBuildCount() {
    var arr: [String] = []
    for i in 0..10 {
        let s = strxPk(i)
        arr.append(move s)
    }
    expect!(arr.count == 10)
}

@Test
function strxArrBuildSum() {
    var arr: [String] = []
    for i in 0..15 {
        let s = strxPk(i)
        arr.append(move s)
    }
    var total = 0
    for j in 0..arr.count {
        total = total + arr[j].count
    }
    // 3 periods of 15 = 45
    expect!(total == 45)
}

@Test
function strxArrBuildIdx() {
    var arr: [String] = []
    for i in 0..5 {
        let s = strxPk(i)
        arr.append(move s)
    }
    // strxPk(2) = "three" = 5
    expect!(arr[2].count == 5)
}

@Test
function strxArrBuildMvLen() {
    var arr: [String] = []
    var buildTotal = 0
    for i in 0..20 {
        let s = strxPk(i)
        buildTotal = buildTotal + s.count
        arr.append(move s)
    }
    // Also sum by index access
    var indexTotal = 0
    for j in 0..arr.count {
        indexTotal = indexTotal + arr[j].count
    }
    // 4 periods of 15 = 60 each -> 120
    expect!(buildTotal + indexTotal == 120)
}

// ---------------------------------------------------------------------------
// Per-iteration string selection by index
// ---------------------------------------------------------------------------

@Test
function strxSelByMod() {
    var total = 0
    for i in 0..10 {
        var cnt = 0
        if i % 2 == 0 {
            cnt = "cat".count
        } else {
            cnt = "dog".count
        }
        total = total + cnt
    }
    // 5*3 + 5*3 = 30
    expect!(total == 30)
}

@Test
function strxCountUnderThree() {
    var cnt = 0
    for i in 0..20 {
        let s = strxPk(i)
        if s.count < 3 {
            cnt = cnt + 1
        }
    }
    // per period of 5: "go", "by", "x" are under 3 -> 3 per period
    // 4 periods -> 12
    expect!(cnt == 12)
}

// ---------------------------------------------------------------------------
// Trap tests
// ---------------------------------------------------------------------------

@Test
function strxTrapArrOob() {
    expectTrap!("")
    let arr: [String] = ["a", "b"]
    let s = arr[5]
}

@Test
function strxTrapBoxArrOob() {
    expectTrap!("")
    var boxes: [StrxBox] = []
    boxes.append(StrxBox { name: "x", code: 1 })
    let _ = boxes[5].code
}

@Test
function strxTrapLblArrOob() {
    expectTrap!("")
    var lbls: [StrxLbl] = []
    lbls.append(.Empty)
    let _ = strxLblLen(lbls[3])
}

@Test
function strxTrapDivZero() {
    expectTrap!("")
        let a = 5
        let b = 0
        let _ = a / b
}

@Test
function strxTrapModZero() {
    expectTrap!("")
        let a = 10
        let b = 0
        let _ = a % b
}

@Test
function strxTrapStrArrEmpty() {
    expectTrap!("")
    let arr: [String] = []
    let s = arr[0]
}
