// floor(100/7) = 14
@Test
function cfxRecursionCountDiv() {
    expect!(cfxCountDiv(100, 7) == 14)
}

// ---------------------------------------------------------------------------
// Early-return patterns
// ---------------------------------------------------------------------------

// Body of the early-return loop, kept as a function so the test can compare its result.
function cfxFirstSquareAtLeast200() -> Int {
    for i in 0..100 {
        if i * i >= 200 {
            return i
        }
    }
    return 0 - 1
}

// i=15: 225>=200 => 15
@Test
function cfxEarlyReturnFromBranch() {
    expect!(cfxFirstSquareAtLeast200() == 15)
}

function cfxFirstPositiveMultipleOfSeven() -> Int {
    for i in 0..50 {
        var hit = false
        if (i % 7) == 0 {
            hit = true
        } else {
            hit = false
        }
        if hit && i > 0 {
            return i
        }
    }
    return 0 - 1
}

// first positive multiple of 7 = 7
@Test
function cfxEarlyReturnSwitch() {
    expect!(cfxFirstPositiveMultipleOfSeven() == 7)
}

function cfxFirstAboveSeven() -> Int {
    let xs: [Int] = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]
    for v in xs {
        if v > 7 {
            return v
        }
    }
    return 0 - 1
}

// 9 is first > 7
@Test
function cfxEarlyReturnForIn() {
    expect!(cfxFirstAboveSeven() == 9)
}
