import Foundation

// StrxClosureTests.kira — deep closure coverage for `kira test`.
// PREFIX: strx / Strx  (all top-level names use this prefix).
// This file imports Foundation (imports are file-scoped); already in scope.

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function strxCAdd(a: Int, b: Int) -> Int {
    return a + b
}

function strxCMul(a: Int, b: Int) -> Int {
    return a * b
}

function strxCSub(a: Int, b: Int) -> Int {
    return a - b
}

function strxCApply(f: (Int) -> Int, x: Int) -> Int {
    return f(x)
}

function strxCApplyTwice(f: (Int) -> Int, x: Int) -> Int {
    return f(f(x))
}

function strxCApplyN(f: (Int) -> Int, x: Int, n: Int) -> Int {
    var res = x
    for i in 0..n {
        res = f(res)
    }
    return res
}

function strxCReduce(xs: borrow [Int], f: (Int) -> Int) -> Int {
    var total = 0
    for i in 0..xs.count {
        total = total + f(xs[i])
    }
    return total
}

function strxCFold(xs: borrow [Int], f: (Int, Int) -> Int, init: Int) -> Int {
    var acc = init
    for i in 0..xs.count {
        acc = f(acc, xs[i])
    }
    return acc
}

// ---------------------------------------------------------------------------
// Named function references passed as values
// ---------------------------------------------------------------------------
@Test
function strxClNamedAdd() {
    let f: (Int, Int) -> Int = strxCAdd
    // 42
    expect!(f(10, 32) == 42)
}

@Test
function strxClNamedMul() {
    let f: (Int, Int) -> Int = strxCMul
    // 42
    expect!(f(6, 7) == 42)
}

@Test
function strxClNamedSub() {
    let f: (Int, Int) -> Int = strxCSub
    // 42
    expect!(f(50, 8) == 42)
}

@Test
function strxClNamedToApply() {
    let inc: (Int) -> Int = { x in return x + 1 }
    // 42
    expect!(strxCApply(move inc, 41) == 42)
}

// ---------------------------------------------------------------------------
// Inline closure literals
// ---------------------------------------------------------------------------

@Test
function strxClInlineAdd() {
    let f: (Int) -> Int = { x in return x + 10 }
    // 42
    expect!(f(32) == 42)
}

@Test
function strxClInlineMul() {
    let f: (Int) -> Int = { x in return x * 3 }
    // 42
    expect!(f(14) == 42)
}

@Test
function strxClInlineNeg() {
    let f: (Int) -> Int = { x in return 0 - x }
    // 0 - 42
    expect!(f(42) == 0 - 42)
}

@Test
function strxClInlineId() {
    let f: (Int) -> Int = { x in return x }
    expect!(f(99) == 99)
}

@Test
function strxClInlineSq() {
    let f: (Int) -> Int = { x in return x * x }
    // 49
    expect!(f(7) == 49)
}

@Test
function strxClInlineHalf() {
    let f: (Int) -> Int = { x in return x / 2 }
    // 50
    expect!(f(100) == 50)
}

@Test
function strxClInlineMod() {
    let f: (Int) -> Int = { x in return x % 7 }
    // 23 % 7 = 2
    expect!(f(23) == 2)
}

@Test
function strxClInlineExpr() {
    let f: (Int) -> Int = { x in return (x + 3) * 2 - 1 }
    // (5+3)*2-1 = 15
    expect!(f(5) == 15)
}

@Test
function strxClInlineExpr2() {
    let g: (Int) -> Int = { x in return x * x + x + 1 }
    // 16+4+1 = 21
    expect!(g(4) == 21)
}

@Test
function strxClInlineTernary() {
    let f: (Int) -> Int = { x in return x > 5 ? 100 : 0 }
    // 100
    expect!(f(7) == 100)
}

@Test
function strxClInlineTernaryFalse() {
    let f: (Int) -> Int = { x in return x > 5 ? 100 : 0 }
    // 0
    expect!(f(3) == 0)
}

// ---------------------------------------------------------------------------
// Higher-order: apply, applyTwice, applyN
// ---------------------------------------------------------------------------

@Test
function strxClApplyTwiceInc() {
    let inc: (Int) -> Int = { x in return x + 1 }
    // 10+1+1 = 12
    expect!(strxCApplyTwice(move inc, 10) == 12)
}

@Test
function strxClApplyTwiceSq() {
    let sq: (Int) -> Int = { x in return x * x }
    // sq(sq(3)) = sq(9) = 81
    expect!(strxCApplyTwice(move sq, 3) == 81)
}

@Test
function strxClApplyTwiceDbl() {
    let dbl: (Int) -> Int = { x in return x * 2 }
    // 5*2*2 = 20
    expect!(strxCApplyTwice(move dbl, 5) == 20)
}

@Test
function strxClApplyN5() {
    let dbl: (Int) -> Int = { x in return x * 2 }
    // 2^5 = 32
    expect!(strxCApplyN(move dbl, 1, 5) == 32)
}

@Test
function strxClApplyN0() {
    let inc: (Int) -> Int = { x in return x + 1 }
    // 0 applications -> 5
    expect!(strxCApplyN(move inc, 5, 0) == 5)
}

@Test
function strxClApplyNInc10() {
    let inc: (Int) -> Int = { x in return x + 1 }
    // 100 + 50 = 150
    expect!(strxCApplyN(move inc, 100, 50) == 150)
}

// ---------------------------------------------------------------------------
// Higher-order: reduce
// ---------------------------------------------------------------------------

@Test
function strxClReduceSquares() {
    let xs: [Int] = [1, 2, 3, 4, 5]
    let sq: (Int) -> Int = { x in return x * x }
    // 1+4+9+16+25 = 55
    expect!(strxCReduce(xs, move sq) == 55)
}

@Test
function strxClReduceDouble() {
    let xs: [Int] = [1, 2, 3, 4, 5, 6]
    let dbl: (Int) -> Int = { x in return x * 2 }
    // 2+4+6+8+10+12 = 42
    expect!(strxCReduce(xs, move dbl) == 42)
}

@Test
function strxClReduceIds() {
    let xs: [Int] = [1, 2, 3, 4, 5, 6, 7]
    let id: (Int) -> Int = { x in return x }
    // 28
    expect!(strxCReduce(xs, move id) == 28)
}

@Test
function strxClReduceAdd1() {
    let xs: [Int] = [10, 20, 30, 40]
    let add1: (Int) -> Int = { x in return x + 1 }
    // 11+21+31+41 = 104
    expect!(strxCReduce(xs, move add1) == 104)
}

@Test
function strxClReduceWithBonus() {
    let xs: [Int] = [1, 2, 3, 4, 5]
    let bonus = 50
    let f: (Int) -> Int = { x in return x + bonus }
    // 51+52+53+54+55 = 265
    expect!(strxCReduce(xs, move f) == 265)
}

@Test
function strxClReduceHalf() {
    let xs: [Int] = [5, 10, 15, 20]
    let half: (Int) -> Int = { x in return x / 2 }
    // 2+5+7+10 = 24
    expect!(strxCReduce(xs, move half) == 24)
}

// ---------------------------------------------------------------------------
// Higher-order: fold with 2-arg closures
// ---------------------------------------------------------------------------

@Test
function strxClFoldAdd() {
    let xs: [Int] = [10, 20, 30]
    let add: (Int, Int) -> Int = strxCAdd
    // 60
    expect!(strxCFold(xs, move add, 0) == 60)
}

@Test
function strxClFoldMul() {
    let xs: [Int] = [1, 2, 3, 4, 5]
    let mul: (Int, Int) -> Int = strxCMul
    // 120
    expect!(strxCFold(xs, move mul, 1) == 120)
}

@Test
function strxClFoldSub() {
    let xs: [Int] = [1, 2, 3, 4]
    let sub: (Int, Int) -> Int = strxCSub
    // 20-1-2-3-4 = 10
    expect!(strxCFold(xs, move sub, 20) == 10)
}

@Test
function strxClFoldAddInit() {
    let xs: [Int] = [1, 2, 3, 4, 5]
    let add: (Int, Int) -> Int = strxCAdd
    // 100+1+2+3+4+5 = 115
    expect!(strxCFold(xs, move add, 100) == 115)
}

@Test
function strxClFoldSmall() {
    let xs: [Int] = [3, 1, 4, 1, 5, 9]
    let add: (Int, Int) -> Int = strxCAdd
    // 23
    expect!(strxCFold(xs, move add, 0) == 23)
}

@Test
function strxClFoldMulSmall() {
    let xs: [Int] = [2, 3, 4]
    let mul: (Int, Int) -> Int = strxCMul
    // 24
    expect!(strxCFold(xs, move mul, 1) == 24)
}

// ---------------------------------------------------------------------------
// Immutable by-value captures
// ---------------------------------------------------------------------------

@Test
function strxClCapImm1() {
    let base = 100
    let f: (Int) -> Int = { x in return x + base }
    // 142
    expect!(f(42) == 142)
}

@Test
function strxClCapImm2() {
    let mult = 7
    let f: (Int) -> Int = { x in return x * mult }
    // 42
    expect!(f(6) == 42)
}

@Test
function strxClCapImmLoop() {
    let base = 1000
    let f: (Int) -> Int = { x in return x + base }
    var acc = 0
    for i in 0..10 {
        acc = acc + f(i)
    }
    // sum(i+1000 for i in 0..9) = 45 + 10000 = 10045
    expect!(acc == 10045)
}

@Test
function strxClCapImmPow2() {
    let factor = 2
    let xs: [Int] = [1, 2, 3, 4, 5]
    let f: (Int) -> Int = { x in return x * factor }
    // 2+4+6+8+10 = 30
    expect!(strxCReduce(xs, move f) == 30)
}

@Test
function strxClCapImmSub() {
    let offset = 5
    let f: (Int) -> Int = { x in return x - offset }
    // 7
    expect!(f(12) == 7)
}

@Test
function strxClCapImmMul3() {
    let factor = 3
    let f: (Int) -> Int = { x in return x * factor }
    var acc = 0
    for i in 1..7 {
        acc = acc + f(i)
    }
    // 3*(1+2+3+4+5+6) = 63
    expect!(acc == 63)
}

@Test
function strxClCapImmTop() {
    let top = 100
    let f: (Int) -> Int = { x in return top - x }
    var acc = 0
    for i in 0..5 {
        acc = acc + f(i)
    }
    // (100+99+98+97+96) = 490
    expect!(acc == 490)
}

@Test
function strxClCapImmDiv() {
    let divisor = 4
    let f: (Int) -> Int = { x in return x / divisor }
    var acc = 0
    for i in 0..8 {
        acc = acc + f(i * 4)
    }
    // i*4/4 = i; sum(0..7) = 28
    expect!(acc == 28)
}
