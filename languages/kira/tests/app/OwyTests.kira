}

// ---- ownership_free_state_moveout_return_parity ----

struct OwyAcc6 {
    var ids: [Int] = []
    var total: Int = 0
}

struct OwyScratch6 {
    var acc: OwyAcc6 = OwyAcc6 {}
}

struct OwyTree6 {
    var nodes: [Int] = []
    var generation: Int = 0
}

function owyBorrowedSegments6(t: borrow OwyTree6) -> [Int] {
    return t.nodes
}

function owyRebuild6(tree: OwyTree6) -> OwyTree6 {
    var next = move tree
    let previous = next.nodes
    next.nodes = []
    for i in 0..previous.count {
        next.nodes.append(previous[i] + 1)
    }
    next.generation = next.generation + 1
    return next
}

@Test
function owyFreeStateMoveoutReturnParity() {
    var okFlag = 1
    let state = nativeState(OwyScratch6 {})
    let handle = nativeUserData(state)
    for frame in 0..10 {
        var scratch = nativeRecover<OwyScratch6>(handle)
        var fresh = OwyAcc6 {}
        fresh.total = frame
        fresh.ids.append(frame)
        scratch.acc = move fresh
        let acc = scratch.acc
        if acc.total != frame {
            okFlag = 0
        }
    }

    var tree = OwyTree6 {}
    tree.nodes.append(1)
    tree.nodes.append(2)
    for r in 0..10 {
        tree = owyRebuild6(move tree)
    }

    var sum = 0
    for k in 0..10 {
        let segs = owyBorrowedSegments6(tree)
        sum = sum + segs.count
    }

    nativeUserDataRelease(handle)
    let combined = tree.nodes[0] * 100000 + tree.nodes[1] * 1000 + tree.generation * 100 + sum * 10 + tree.nodes.count
    let got = okFlag * combined
    expect!(got == 1113202)
}

// ---- ownership_let_field_alias_if_partial_move ----

struct OwyBag7 {
    var items: [Int]
}

function owyLeak7(flag: Bool, bag: OwyBag7) -> Int {
    if flag {
        let alias = bag.items
        return alias.count
    }
    return 0
}

@Test
function owyLetFieldAliasIfPartialMove() {
    let bag = OwyBag7 { items: [1, 2, 3] }
    let got = owyLeak7(true, move bag)
    expect!(got == 3)
}

// ---- ownership_let_field_alias_partial_move ----

struct OwyBag8 {
    var items: [Int]
}

function owyLeak8(bag: OwyBag8) -> Int {
    let alias = bag.items
    return alias.count
}

@Test
function owyLetFieldAliasPartialMove() {
    let bag = OwyBag8 { items: [1, 2, 3] }
    let got = owyLeak8(move bag)
    expect!(got == 3)
}

// ---- ownership_let_field_alias_partial_move ----

struct OwyBag9 {
    var items: [Int]
}

function owyLeak9(value: Int, bag: OwyBag9) -> Int {
    if value == 0 {
        let alias = bag.items
        return alias.count
    } else {
        return 0
    }
}

@Test
function owyLetFieldAliasSwitchPartialMove() {
    let bag = OwyBag9 { items: [1, 2, 3] }
    let got = owyLeak9(0, move bag)
    expect!(got == 3)
}

// ---- ownership_let_field_alias_while_partial_move ----

struct OwyBag10 {
    var items: [Int]
}

function owyLeak10(flag: Bool, bag: OwyBag10) -> Int {
    while true {
        if !flag { break }
        let alias = bag.items
        return alias.count
    }
    return 0
}

@Test
function owyLetFieldAliasWhilePartialMove() {
    let bag = OwyBag10 { items: [1, 2, 3] }
    let got = owyLeak10(true, move bag)
    expect!(got == 3)
}

// ---- ownership_multi_closure_copy_capture ----

function owyCallTwice11(first: () -> Int, second: () -> Int) -> Int {
    let a = first()
    let b = second()
    return a * 100 + b
}

@Test
function owyMultiClosureCopyCapture() {
    let seed = 4
    let adder: () -> Int = { in
        return seed + 1
    }
    let multiplier: () -> Int = { in
        return seed * 10
    }
    let direct = seed + 0
    let combined = owyCallTwice11(move adder, move multiplier)
    let got = combined * 10 + direct
    expect!(got == 5404)
}

// ---- ownership_partial_move_scope_exit_parity ----

construct OwyPmNode12 {
    @Required let tag: Int
}

construct OwyPmLeaf12(value: Int) extends OwyPmNode12 {
    let tag: Int {
        value
    }
}

enum OwyStatus12 {
    Ready: String = "ready"
    Blocked: String = "blocked"
}

function owyBuildNode12(tag: Int) -> some OwyPmNode12 {
    return OwyPmLeaf12(value: tag)
}

struct OwyHolder12 {
    var ids: [Int] = []
    var status: OwyStatus12 = .Ready("ok")
    var node: some OwyPmNode12
    var kept: [Int] = []
}

function owyStatusText12(s: borrow OwyStatus12) -> String {
    match s {
        Ready(text) -> { return text }
        Blocked(text) -> { return text }
    }
    return ""
}

function owyConsume12(holder: OwyHolder12) -> Int {
    let ids = holder.ids
    let status = holder.status
    let node = holder.node
    var total = ids.count
    total = total + owyStatusText12(status).count
    total = total + node.tag
    return total
}

@Test
function owyPartialMoveScopeExitParity() {
    var total = 0
    for round in 0..10 {
        var holder = OwyHolder12 { node: owyBuildNode12(round) }
        holder.ids.append(round)
        holder.ids.append(round + 1)
        holder.status = .Blocked("waiting")
        holder.kept.append(round)
        total = total + owyConsume12(move holder)
    }
    let got = total
    expect!(got == 135)
}
