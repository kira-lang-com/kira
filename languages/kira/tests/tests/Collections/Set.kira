import Foundation

// `Set` keeps the order elements were first inserted, and a re-inserted element
// keeps its original slot until it is removed.

@Test
function setKeepsFirstInsertion() {
    var seen = Set<String>()
    seen.insert("x")
    seen.insert("y")
    seen.insert("x")
    let dropped = seen.remove("y")
    seen.insert("z")
    seen.insert("y")
    expect!((traceText(seen.elements())) == ("[\"x\", \"z\", \"y\"]"))
    expect!((traceText(dropped)) == ("true"))
    expect!((traceText(seen.remove("w"))) == ("false"))
}
