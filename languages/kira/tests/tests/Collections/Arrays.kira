import Foundation

// Arrays: literals, append in loops, indexing, iteration, nesting, and arrays
// of structs. Exercises the handle-based array runtime under allocation churn.

struct ColPoint {
    var x: Number
    var y: Number
}

struct ColRow {
    var cells: [Number]
}

function colSumArray(xs: borrow [Number]) -> Number {
    var total: Number = 0
    for i in 0..xs.count {
        total = total + xs[i]
    }
    return total
}

function colBuild(n: Number) -> [Number] {
    var xs: [Number] = []
    for i in 0..n {
        xs.append(i * i)
    }
    return xs
}

@Test
function buildAndSumChurnsArrayAllocations() {
    var total: Number = 0
    for round in 0..200 {
        let xs = colBuild(40)
        total = total + colSumArray(xs)
    }
    expect!((total) == (4108000))
}

@Test
function forInIteratesALiteral() {
    var total: Number = 0
    for v in [3, 5, 7, 11, 13] {
        total = total + v
    }
    expect!((total) == (39))
}

@Test
function arrayOfOwnedRowsSumsEveryCell() {
    var grid: [ColRow] = []
    for r in 0..8 {
        var row: [Number] = []
        for c in 0..8 {
            row.append(r * 8 + c)
        }
        grid.append(ColRow { cells: move row })
    }
    var total: Number = 0
    for gi in 0..grid.count {
        total = total + colSumArray(grid[gi].cells)
    }
    expect!((total) == (2016))
    expect!((grid.count) == (8))
}

@Test
function arrayOfStructsMutatesByIndex() {
    var pts: [ColPoint] = []
    for p in 0..50 {
        pts.append(ColPoint { x: p, y: p * 2 })
    }
    var total: Number = 0
    for pi in 0..pts.count {
        total = total + pts[pi].x + pts[pi].y
    }
    expect!((total) == (3675))
    expect!((pts[49].y) == (98))
}
