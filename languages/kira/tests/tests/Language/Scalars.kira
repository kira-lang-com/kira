import Foundation

// Scalar arithmetic, comparisons, boolean logic, control flow, and recursion.

function scalarFactorial(n: Number) -> Number {
    if n <= 1 {
        return 1
    }
    return n * scalarFactorial(n - 1)
}

function scalarFib(n: Number) -> Number {
    if n < 2 {
        return n
    }
    return scalarFib(n - 1) + scalarFib(n - 2)
}

function scalarGcd(a: Number, b: Number) -> Number {
    var x = a
    var y = b
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    return x
}

function scalarClassify(n: Number) -> Number {
    var r: Number = 0
    if (n % 3) == 0 {
        r = 100
    } else if (n % 3) == 1 {
        r = 200
    } else if (n % 3) == 2 {
        r = 300
    } else {
        r = 0
    }
    return r
}

@Test
function integerLoopMixesEveryOperator() {
    var total: Number = 0
    for i in 1..51 {
        total = total + (i * 3) - trunc(i / 2) + (i % 7)
    }
    expect!((total) == (3348))
}

@Test
function factorialFibonacciAndGcdAreExact() {
    expect!((scalarFactorial(10)) == (3628800))
    expect!((scalarFib(20)) == (6765))
    expect!((scalarGcd(1071, 462)) == (21))
}

@Test
function booleanSelectionAndClassifyLoop() {
    var total: Number = 0
    for j in 0..40 {
        let even = j % 2 == 0
        let big = j > 20
        let pick = (even && big) || (!even && !big)
        total = total + (pick ? j : (0 - j))
        total = total + scalarClassify(j)
    }
    expect!((total) == (7860))
}

@Test
function floatChecksumIsExactAtThirty() {
    var f: Number = 0
    for k in 0..30 {
        f = f + 1.5 * 2.0 - 0.5
    }
    expect!((f) == (75))
}

@Test
function unaryMinusAndNestedGrouping() {
    let g = 0 - (3 * (4 + 5))
    expect!((g) == (-27))
}
