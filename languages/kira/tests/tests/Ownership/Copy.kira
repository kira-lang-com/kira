import Foundation

// The `copy` operator: a second, independent holder of a Copyable value,
// leaving the original usable.

struct OwzPoint {
    var x: Number = 0
    var y: Number = 0
}

function owzTakePoint(p: OwzPoint) -> Number {
    return p.x * 10 + p.y
}

function owzTakeText(t: String) -> Number {
    return t.count
}

function owzTwice(n: copy Number) -> Number {
    return n * 2
}

@Test
function copyOfAStructLeavesTheOriginalUsable() {
    var p = OwzPoint()
    p.x = 3
    p.y = 4
    let first = owzTakePoint(copy p)
    p.y = 5
    expect!((first) == (34))
    expect!((owzTakePoint(move p)) == (35))
}

@Test
function copyOfAStringLeavesTheOriginalUsable() {
    let s = "hello"
    let first = owzTakeText(copy s)
    expect!((first) == (5))
    expect!((s.count) == (5))
}

@Test
function copyParameterTakesAScalar() {
    let n: Number = 21
    expect!((owzTwice(copy n)) == (42))
    expect!((n) == (21))
}

@Test
function copyIsIndependentOfLaterWrites() {
    var p = OwzPoint()
    p.x = 1
    let snapshot = copy p
    p.x = 9
    expect!((snapshot.x) == (1))
    expect!((p.x) == (9))
}
