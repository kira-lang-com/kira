import Testing

// The programs of `corpus/core.klfd` that run to a value without Foundation.
// Each program's `main` returns the value the corpus checked as an exit code.

@Test
function mainReturnsItsValue() {
    expect!(runPath("corpus/sources/main.kira") == 42)
}

@Test
function callsFunctions() {
    expect!(runPath("corpus/sources/function-call.kira") == 42)
}

@Test
function loopsWhileConditionHolds() {
    expect!(runPath("corpus/sources/while-loop.kira") == 45)
}

@Test
function loopsOverRanges() {
    expect!(runPath("corpus/sources/range-loop.kira") == 10)
}

@Test
function recursesIntoItself() {
    expect!(runPath("corpus/sources/recursion.kira") == 55)
}

@Test
function callsStructMethods() {
    expect!(runPath("corpus/sources/struct-methods.kira") == 32)
}

@Test
function matchesEnumCases() {
    expect!(runPath("corpus/sources/enum-match.kira") == 39)
}

@Test
function computesIntegerWidths() {
    expect!(runPath("corpus/sources/integer-widths.kira") == 94)
}

@Test
function dividesUnsignedValues() {
    // The corpus checked the low byte of this value, 217.
    expect!(runPath("corpus/sources/unsigned-division.kira") == 571428569)
}

@Test
function computesBooleans() {
    expect!(runPath("corpus/sources/booleans.kira") == 16)
}

@Test
function returnsEarly() {
    expect!(runPath("corpus/sources/early-return.kira") == 42)
}
