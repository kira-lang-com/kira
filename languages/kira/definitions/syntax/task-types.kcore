function taskReferenceType(declared: FunctionDeclaration) -> TypeReference {
    var result: TypeReference = TypeReference {
        qualifier = .None, name = Identifier { text = "Int", span = declared.name.span },
        arguments = [], modes = [], instanceName = "Int"
    }
    match declared.result {
        Some(valueType) -> {
            if valueType.name.text != "Void" { result = valueType }
        }
        None -> {}
    }
    let arguments: [TypeReference] = [result]
    return TypeReference {
        qualifier = .None, name = Identifier { text = "Task", span = declared.name.span },
        arguments = arguments, modes = [], instanceName = genericInstanceName("Task", arguments)
    }
}
