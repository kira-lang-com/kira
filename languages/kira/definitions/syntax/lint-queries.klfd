extend ExpressionKind {
    function binaryOperands(borrow self, wanted: BinaryOperator) -> Optional<Operands> {
        match self {
            Binary(operator, left, right) -> {
                if operator == wanted { return .Some(Operands { left = left, right = right }) }
                return .None
            }
            IntegerLiteral -> return .None
            FloatLiteral -> return .None
            BooleanLiteral -> return .None
            StringLiteral -> return .None
            ArrayLiteral -> return .None
            Index -> return .None
            Transfer -> return .None
            Labelled -> return .None
            TypeQuery -> return .None
            Name -> return .None
            Member -> return .None
            Quote -> return .None
            ExpandedMacro -> return .None
            MacroCall -> return .None
            Call -> return .None
            GenericCall -> return .None
            MethodCall -> return .None
            IndirectCall -> return .None
            Lambda -> return .None
            KeyPath -> return .None
            Task -> return .None
            Try -> return .None
            Variant -> return .None
            StructLiteral -> return .None
            Unary -> return .None
            Conditional -> return .None
            MatchValue -> return .None
            Content -> return .None
        }
    }

    function called(borrow self) -> Optional<TaskCallSyntax> {
        return taskCall()
    }
}
