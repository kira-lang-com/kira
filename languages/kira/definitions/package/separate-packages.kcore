// The package dependency graph is indexed once per program. Its graph nodes
// provide both dependencies-first loading and reverse consumer discovery.

struct PackageModuleEntry {
    let manifest: Int
    let module: Int
}

struct PackageModuleIndex {
    var buckets: [[PackageModuleEntry]]
    var bucketCount: Int
    var entryCount: Int

    function set(borrow mut self, manifest: Int, module: Int) {
        let bucket = manifest % bucketCount
        for entry in buckets[bucket] {
            if entry.manifest == manifest { return }
        }
        buckets[bucket].append(PackageModuleEntry { manifest = manifest, module = module })
        entryCount += 1
        if entryCount > bucketCount * 4 { resize(bucketCount * 2) }
    }

    function value(borrow self, manifest: Int) -> Optional<Int> {
        let bucket = manifest % bucketCount
        for entry in buckets[bucket] {
            if entry.manifest == manifest { return .Some(entry.module) }
        }
        return .None
    }

    function resize(borrow mut self, size: Int) {
        var grown: [[PackageModuleEntry]] = []
        for bucket in 0..size {
            let empty: [PackageModuleEntry] = []
            grown.append(empty)
        }
        for bucket in buckets {
            for entry in bucket { grown[entry.manifest % size].append(entry) }
        }
        buckets = grown
        bucketCount = size
    }
}

function emptyPackageModuleIndex(n: Int) -> PackageModuleIndex {
    var buckets: [[PackageModuleEntry]] = []
    let initialBucketCount = 32 + n / 4
    for bucket in 0..initialBucketCount {
        let empty: [PackageModuleEntry] = []
        buckets.append(empty)
    }
    return PackageModuleIndex { buckets = buckets, bucketCount = initialBucketCount, entryCount = 0 }
}


struct ModuleSet {
    var values: [Int]
    var buckets: [[Int]]
    var bucketCount: Int
    var indexed: Bool

    function contains(borrow self, value: Int) -> Bool {
        if !indexed {
            for earlier in values { if earlier == value { return true } }
            return false
        }
        for earlier in buckets[value % bucketCount] {
            if earlier == value { return true }
        }
        return false
    }

    function insert(borrow mut self, value: Int) {
        if self.contains(value) { return }
        values.append(value)
        if !indexed {
            if values.count > 16 { self.resize(32) }
            return
        }
        buckets[value % bucketCount].append(value)
        if values.count > bucketCount * 4 { self.resize(bucketCount * 2) }
    }

    function resize(borrow mut self, size: Int) {
        var grown: [[Int]] = []
        for bucket in 0..size {
            let empty: [Int] = []
            grown.append(empty)
        }
        for value in values { grown[value % size].append(value) }
        buckets = grown
        bucketCount = size
        indexed = true
    }
}

function emptyModuleSet() -> ModuleSet {
    return ModuleSet { values = [], buckets = [], bucketCount = 0, indexed = false }
}


struct DependencyNameSet {
    var values: [String]
    var buckets: [[String]]
    var bucketCount: Int
    var indexed: Bool

    function contains(borrow self, value: String) -> Bool {
        if !indexed {
            for earlier in values { if earlier == value { return true } }
            return false
        }
        for earlier in buckets[nameHash(value) % bucketCount] {
            if earlier == value { return true }
        }
        return false
    }

    function insert(borrow mut self, value: String) {
        if self.contains(value) { return }
        values.append(value)
        if !indexed {
            if values.count > 16 { self.resize(32) }
            return
        }
        buckets[nameHash(value) % bucketCount].append(value)
        if values.count > bucketCount * 4 { self.resize(bucketCount * 2) }
    }

    function resize(borrow mut self, size: Int) {
        var grown: [[String]] = []
        for bucket in 0..size {
            let empty: [String] = []
            grown.append(empty)
        }
        for value in values { grown[nameHash(value) % size].append(value) }
        buckets = grown
        bucketCount = size
        indexed = true
    }
}

function emptyDependencyNameSet() -> DependencyNameSet {
    return DependencyNameSet { values = [], buckets = [], bucketCount = 0, indexed = false }
}

struct PackageGraphNode {
    let path: String
    let package: PackageRoot
    var dependencies: [Int]
    var consumers: [Int]
    var program: Bool
    var related: Bool
    var consumerVisited: Bool
    var dependencyVisited: Bool
}

struct PackageDependencyIndex {
    var nodes: [PackageGraphNode]
    var buckets: [[Int]]
    var pending: [Int]
    var bucketCount: Int

    function resize(borrow mut self, size: Int) {
        var grown: [[Int]] = []
        for bucket in 0..size {
            let empty: [Int] = []
            grown.append(empty)
        }
        for node in 0..nodes.count {
            grown[nameHash(nodes[node].path) % size].append(node)
        }
        self.buckets = grown
        self.bucketCount = size
    }

    function position(borrow self, path: String) -> Optional<Int> {
        let bucket = nameHash(path) % bucketCount
        for node in buckets[bucket] {
            if nodes[node].path == path { return .Some(node) }
        }
        return .None
    }

    function enqueue(borrow mut self, package: PackageRoot, path: String, program: Bool) -> Int {
        let bucket = nameHash(path) % bucketCount
        for node in buckets[bucket] {
            if nodes[node].path == path {
                if program && !nodes[node].program { nodes[node].program = true }
                return node
            }
        }
        let node = nodes.count
        nodes.append(PackageGraphNode {
            path = path, package = package, dependencies = [], consumers = [],
            program = program, related = false, consumerVisited = false,
            dependencyVisited = false
        })
        buckets[bucket].append(node)
        pending.append(node)
        if nodes.count > bucketCount * 4 { resize(bucketCount * 2) }
        return node
    }

    function pathAt(borrow self, node: Int) -> String {
        return nodes[node].path
    }

    function packageAt(borrow self, node: Int) -> PackageRoot {
        return nodes[node].package
    }

    function dependenciesFor(borrow self, node: Int) -> [Int] {
        return nodes[node].dependencies
    }

    function consumersFor(borrow self, node: Int) -> [Int] {
        return nodes[node].consumers
    }

    function addConsumer(borrow mut self, dependency: Int, consumer: Int) {
        nodes[dependency].consumers.append(consumer)
    }

    function programRoot(borrow self, node: Int) -> Bool {
        return nodes[node].program
    }

    function isRelated(borrow self, node: Int) -> Bool {
        return nodes[node].related
    }

    function markRelated(borrow mut self, node: Int) {
        nodes[node].related = true
    }

    function consumerVisited(borrow self, node: Int) -> Bool {
        return nodes[node].consumerVisited
    }

    function markConsumerVisited(borrow mut self, node: Int) {
        nodes[node].consumerVisited = true
    }

    function dependencyVisited(borrow self, node: Int) -> Bool {
        return nodes[node].dependencyVisited
    }

    function markDependencyVisited(borrow mut self, node: Int) {
        nodes[node].dependencyVisited = true
    }
}

function emptyPackageDependencyIndex(expectedNodes: Int) -> PackageDependencyIndex {
    var buckets: [[Int]] = []
    let initialBucketCount = 32 + expectedNodes / 4
    for bucket in 0..initialBucketCount {
        let empty: [Int] = []
        buckets.append(empty)
    }
    return PackageDependencyIndex { nodes = [], buckets = buckets, pending = [], bucketCount = initialBucketCount }
}

function directPackageDependencies(session: Session, package: PackageRoot, packagePath: String, packageNode: Int, borrow mut sources: PackageSourceIndex, borrow mut index: PackageDependencyIndex) {
    match readCachedManifest(session, package.manifest, sources) {
        Ok(manifest) -> {
            let imported = packageImports(session, package.directory, sources)
            for dependency in manifest.dependencies {
                if dependency.source != .Path { continue }
                match imported {
                    Some(names) -> { if !importsDependency(session, package.directory, names, dependency, sources) { continue } }
                    None -> {}
                }
                let named = normalizedPath(joinPath(package.directory, dependency.path))
                if named == packagePath { continue }
                match index.position(named) {
                    Some(dependencyNode) -> {
                        if dependencyNode != packageNode {
                            index.nodes[packageNode].dependencies.append(dependencyNode)
                            index.addConsumer(dependencyNode, packageNode)
                        }
                        continue
                    }
                    None -> {}
                }
                match resolvePackagePath(session, named, sources) {
                    Some(resolved) -> {
                        let dependencyNode = index.enqueue(resolved, resolved.directory, false)
                        if dependencyNode != packageNode {
                            index.nodes[packageNode].dependencies.append(dependencyNode)
                            index.addConsumer(dependencyNode, packageNode)
                        }
                    }
                    None -> {}
                }
            }
        }
        Error(failure) -> {}
    }
}

function packageDependencyGraph(session: Session, packages: [PackageRoot], own: PackageRoot, borrow mut sources: PackageSourceIndex) -> PackageDependencyIndex {
    var index = emptyPackageDependencyIndex(packages.count + 2)
    for package in packages { index.enqueue(package, normalizedPath(package.directory), true) }
    index.enqueue(own, normalizedPath(own.directory), false)
    let std = stdRoot(session)
    if utf8Count(std) > 0 {
        let directory = joinPath(std, "Foundation")
        let manifest = readFile(session, joinPath(directory, "package.kira"))
        if manifest >= 0 && manifest != own.manifest {
            index.enqueue(PackageRoot { directory = directory, manifest = manifest }, normalizedPath(directory), false)
        }
    }
    var cursor = 0
    while cursor < index.pending.count {
        let node = index.pending[cursor]
        cursor += 1
        let package = index.packageAt(node)
        let path = index.pathAt(node)
        directPackageDependencies(session, package, path, node, sources, index)
    }
    return index
}

function appendIndexedDependencies(
    borrow mut index: PackageDependencyIndex,
    root: Int,
    output: borrow mut [PackageRoot]
) {
    var stackRoots: [Int] = [root]
    var nextDependencies: [Int] = [0]
    index.markDependencyVisited(root)
    var depth = 1
    while depth > 0 {
        let frame = depth - 1
        let current = stackRoots[frame]
        let dependencies = index.dependenciesFor(current)
        let childIndex = nextDependencies[frame]
        if childIndex < dependencies.count {
            let child = dependencies[childIndex]
            nextDependencies[frame] = childIndex + 1
            if index.dependencyVisited(child) { continue }
            index.markDependencyVisited(child)
            if depth < stackRoots.count {
                stackRoots[depth] = child
                nextDependencies[depth] = 0
            } else {
                stackRoots.append(child)
                nextDependencies.append(0)
            }
            depth += 1
            continue
        }
        depth -= 1
        if current == root { continue }
        output.append(index.packageAt(current))
    }
}

function indexedPackageDependencies(session: Session, borrow mut index: PackageDependencyIndex, root: PackageRoot) -> [PackageRoot] {
    var order: [PackageRoot] = []
    let rootPath = normalizedPath(root.directory)
    match index.position(rootPath) {
        Some(rootNode) -> index.markDependencyVisited(rootNode)
        None -> return order
    }
    let std = stdRoot(session)
    if utf8Count(std) > 0 {
        let directory = joinPath(std, "Foundation")
        let manifest = readFile(session, joinPath(directory, "package.kira"))
        let normalized = normalizedPath(directory)
        if manifest >= 0 && manifest != root.manifest {
            match index.position(normalized) {
                Some(foundation) -> {
                    if !index.dependencyVisited(foundation) {
                        appendIndexedDependencies(index, foundation, order)
                        order.append(index.packageAt(foundation))
                    }
                }
                None -> {}
            }
        }
    }
    match index.position(rootPath) {
        Some(rootNode) -> appendIndexedDependencies(index, rootNode, order)
        None -> {}
    }
    return order
}

function relatedPackages(session: Session, packages: [PackageRoot], own: PackageRoot, borrow mut sources: PackageSourceIndex) -> [PackageRoot] {
    var graphPackages = packages
    let bundled = bundledRoot(session, own.directory)
    if bundled { graphPackages = [] }
    var index = packageDependencyGraph(session, graphPackages, own, sources)
    var related: [PackageRoot] = [own]
    for dependency in indexedPackageDependencies(session, index, own) { related.append(dependency) }
    if bundled { return related }
    var queue: [Int] = []
    for package in related {
        let path = normalizedPath(package.directory)
        match index.position(path) {
            Some(node) -> {
                index.markRelated(node)
                if bundledRoot(session, path) || index.consumerVisited(node) { continue }
                index.markConsumerVisited(node)
                queue.append(node)
            }
            None -> {}
        }
    }
    var cursor = 0
    while cursor < queue.count {
        let dependency = queue[cursor]
        cursor += 1
        let consumers = index.consumersFor(dependency)
        for consumer in consumers {
            if index.consumerVisited(consumer) { continue }
            index.markConsumerVisited(consumer)
            queue.append(consumer)
            if !index.programRoot(consumer) || index.isRelated(consumer) { continue }
            index.markRelated(consumer)
            related.append(index.packageAt(consumer))
        }
    }
    return related
}

function resolvePackagePath(session: Session, named: String, borrow mut sources: PackageSourceIndex) -> Optional<PackageRoot> {
    match sources.packagePath(named) {
        Some(cached) -> return cached.package
        None -> {}
    }
    let manifestFile = readFile(session, joinPath(named, "package.kira"))
    if manifestFile < 0 {
        sources.insertPackagePath(named, .None)
        return .None
    }
    let directory = normalizedPath(bundledDirectory(session, named, manifestFile, sources))
    let file = packageManifestFile(session, named, manifestFile, directory)
    let resolved = PackageRoot { directory = directory, manifest = file }
    sources.insertPackagePath(named, .Some(resolved))
    return .Some(resolved)
}

function bundledDirectory(session: Session, directory: String, file: Int, borrow mut sources: PackageSourceIndex) -> String {
    let std = stdRoot(session)
    if utf8Count(std) == 0 { return directory }
    match readCachedManifest(session, file, sources) {
        Ok(manifest) -> {
            let bundled = normalizedPath(joinPath(std, manifest.moduleRoot))
            if bundled == normalizedPath(directory) { return directory }
            match packageBundleManifestFile(session, manifest.moduleRoot, bundled, sources) {
                Some(shipped) -> {
                    if shipped == file || fileText(session, shipped as SourceFile) == fileText(session, file as SourceFile) {
                        return bundled
                    }
                }
                None -> {}
            }
        }
        Error(_) -> {}
    }
    return directory
}

function bundledPackage(session: Session, root: String, name: String, manifest: Int) -> Bool {
    let std = stdRoot(session)
    if utf8Count(std) == 0 { return false }
    if directoryOf(normalizedPath(root)) == normalizedPath(std) { return true }
    return readFile(session, joinPath(joinPath(std, name), "package.kira")) == manifest
}

function listsText(texts: [String], wanted: String) -> Bool {
    for text in texts {
        if text == wanted { return true }
    }
    return false
}

// The input program has one compilation unit. Package roots remain separate
// modules in its shared compilation graph.
function programUnits(session: Session, entries: [SourceFile]) -> [Unit] {
    if entries.count == 0 { return [] }
    return [definition_unit(session, entries[0])]
}


function packageManifestFile(session: Session, named: String, manifest: Int, directory: String) -> Int {
    if normalizedPath(named) == normalizedPath(directory) { return manifest }
    return readFile(session, joinPath(directory, "package.kira"))
}
                                                                                                                                                                                                                                             
