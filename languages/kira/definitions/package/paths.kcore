// Paths as the driver spells them, absolute or relative to the directory the
// driver runs in. `/` separates their parts, and so does `\` as Windows
// writes them; a path made here uses `/`. An absolute path starts with `/` or
// with a drive, `C:/` or `C:\`.

// Whether `byte` separates a path's parts.
function isSeparator(byte: Int) -> Bool {
    return byte == 47 || byte == 92
}

// How long the root of `path` is: 1 for `/`, 3 for a drive, 0 for a relative
// path.
function rootLength(path: String) -> Int {
    let count = utf8Count(path)
    if count > 0 && isSeparator(utf8Byte(path, 0)) { return 1 }
    if count > 2 && utf8Byte(path, 1) == 58 && isSeparator(utf8Byte(path, 2)) { return 3 }
    return 0
}

// The directory holding `path`: `.` for a bare name, its root for a
// top-level one.
function directoryOf(path: String) -> String {
    var slash = -1
    for index in 0..utf8Count(path) {
        if isSeparator(utf8Byte(path, index)) { slash = index }
    }
    if slash < 0 { return "." }
    let root = rootLength(path)
    if slash < root { return utf8Slice(path, 0, root) }
    if slash == 0 { return "/" }
    return utf8Slice(path, 0, slash)
}

// `relative` read from `directory`. An absolute `relative` stands alone.
function joinPath(directory: String, relative: String) -> String {
    if rootLength(relative) > 0 { return relative }
    if directory == "." { return relative }
    let count = utf8Count(directory)
    if count > 0 && isSeparator(utf8Byte(directory, count - 1)) { return joinText([directory, relative]) }
    return joinText([directory, "/", relative])
}

// `path` with its `.` segments and each `name/..` pair removed, and every
// separator a `/`, so two spellings of one directory compare equal.
function normalizedPath(path: String) -> String {
    let root = rootLength(path)
    let absolute = root > 0
    var segments: [String] = []
    var start = root
    for index in root..(utf8Count(path) + 1) {
        if index < utf8Count(path) && !isSeparator(utf8Byte(path, index)) { continue }
        let segment = utf8Slice(path, start, index)
        start = index + 1
        match segment {
            "", "." -> continue
            ".." -> {
                if segments.count > 0 && segments[segments.count - 1] != ".." {
                    var shorter: [String] = []
                    for kept in 0..(segments.count - 1) { shorter.append(segments[kept]) }
                    segments = shorter
                    continue
                }
                if absolute { continue }
            }
            else -> {}
        }
        segments.append(segment)
    }
    var parts: [String] = []
    if root == 1 { parts.append("/") }
    if root == 3 { parts.append(joinText([utf8Slice(path, 0, 2), "/"])) }
    for index in 0..segments.count {
        if index > 0 { parts.append("/") }
        parts.append(segments[index])
    }
    if parts.count == 0 { return "." }
    return joinText(parts)
}

// The directory every one of `inputs` lies under: the directory the driver
// was given, whose files it expanded them from.
function inputsDirectory(session: Session, inputs: [SourceFile]) -> String {
    var directory = directoryOf(fileName(session, inputs[0]))
    var settled = false
    while !settled {
        settled = true
        for input in inputs {
            if !startsWithText(fileName(session, input), joinPath(directory, "")) {
                settled = false
            }
        }
        if !settled {
            let parent = directoryOf(directory)
            if parent == directory { return directory }
            directory = parent
        }
    }
    return directory
}

struct PackageRootCacheEntry {
    let directory: String
    let package: Optional<PackageRoot>
}

struct PackageRootCache {
    var buckets: [[PackageRootCacheEntry]]
    var bucketCount: Int
    var entryCount: Int

    function value(borrow self, directory: String) -> Optional<PackageRootCacheEntry> {
        let bucket = nameHash(directory) % bucketCount
        for entry in buckets[bucket] {
            if entry.directory == directory { return .Some(entry) }
        }
        return .None
    }

    function insertMissing(borrow mut self, directory: String, package: Optional<PackageRoot>) {
        let bucket = nameHash(directory) % bucketCount
        buckets[bucket].append(PackageRootCacheEntry { directory = directory, package = package })
        entryCount += 1
        if entryCount > bucketCount * 4 { resize(bucketCount * 2) }
    }

    function resize(borrow mut self, size: Int) {
        var grown: [[PackageRootCacheEntry]] = []
        for index in 0..size {
            let empty: [PackageRootCacheEntry] = []
            grown.append(empty)
        }
        for bucket in buckets {
            for entry in bucket {
                grown[nameHash(entry.directory) % size].append(entry)
            }
        }
        buckets = grown
        bucketCount = size
    }
}

function emptyPackageRootCache() -> PackageRootCache {
    var buckets: [[PackageRootCacheEntry]] = []
    let initialBucketCount = 32
    for index in 0..initialBucketCount {
        let empty: [PackageRootCacheEntry] = []
        buckets.append(empty)
    }
    return PackageRootCache { buckets = buckets, bucketCount = initialBucketCount, entryCount = 0 }
}

function packageSearchTop(directory: String) -> String {
    let root = rootLength(directory)
    if root == 1 { return "/" }
    if root == 3 { return utf8Slice(directory, 0, root) }
    return "."
}

// The nearest package root for a file, within `top`, or none.
function packageRootOf(session: Session, path: String, top: String, borrow mut cache: PackageRootCache) -> Optional<String> {
    match packageRootDirectoryOf(session, directoryOf(path), top, cache) {
        Some(package) -> return .Some(package.directory)
        None -> return .None
    }
}

// The package `directory` belongs to: the nearest directory at or under `top`
// holding a `package.kira`, or none. Checked directories and manifest IDs are
// reused for the rest of this input set.
function packageRootDirectoryOf(session: Session, start: String, top: String, borrow mut cache: PackageRootCache) -> Optional<PackageRoot> {
    var directory = start
    var checked: [String] = []
    while true {
        match cache.value(directory) {
            Some(cached) -> {
                for earlier in checked { cache.insertMissing(earlier, cached.package) }
                return cached.package
            }
            None -> {}
        }
        let manifest = readFile(session, joinPath(directory, "package.kira"))
        if manifest >= 0 {
            let package: Optional<PackageRoot> = .Some(PackageRoot { directory = directory, manifest = manifest })
            cache.insertMissing(directory, package)
            for earlier in checked { cache.insertMissing(earlier, package) }
            return package
        }
        checked.append(directory)
        if directory == top {
            for earlier in checked { cache.insertMissing(earlier, .None) }
            return .None
        }
        let parent = directoryOf(directory)
        if parent == directory {
            for earlier in checked { cache.insertMissing(earlier, .None) }
            return .None
        }
        directory = parent
    }
    return .None
}

// One unit for each program root among `inputs`, named by its first file
// under that package's `app/`. Package dependencies stay in that root's graph.
// None when a file lies
// outside every package, or a package has no `app/` file.
// The nearest directory at or above `directory` holding a `package.kira`, or
// `directory` itself when none does.
function enclosingPackageDirectory(session: Session, directory: String) -> String {
    var current = directory
    while true {
        if readFile(session, joinPath(current, "package.kira")) >= 0 { return current }
        let parent = directoryOf(current)
        if parent == current || parent == "." { return directory }
        current = parent
    }
    return directory
}

function packageUnits(session: Session, inputs: [SourceFile], top: String) -> Optional<[Unit]> {
    var roots: [String] = []
    var entries: [SourceFile] = []
    var rootIndex = emptyNameSet()
    var rootCache = emptyPackageRootCache()
    for input in inputs {
        let name = fileName(session, input)
        var root = ""
        match packageRootOf(session, name, top, rootCache) {
            Some(found) -> root = found
            None -> return .None
        }
        if normalizedPath(name) == normalizedPath(joinPath(root, "package.kira")) { continue }
        // A package's `tests/` belong to its test builds, which read them
        // themselves (`loader.klfd`), so a library unit leaves them out.
        let tests = joinPath(normalizedPath(joinPath(root, "tests")), "")
        if startsWithText(normalizedPath(name), tests) { continue }
        let app = joinPath(normalizedPath(joinPath(root, "app")), "")
        if !startsWithText(normalizedPath(name), app) { return .None }
        root = normalizedPath(root)
        if !rootIndex.contains(root) {
            rootIndex.insert(root)
            roots.append(root)
            entries.append(input)
        }
    }
    let needed = packagesNeededByAnother(session, roots, rootIndex)
    var kept: [SourceFile] = []
    for index in 0..roots.count {
        if !needed.contains(roots[index]) { kept.append(entries[index]) }
    }
    if kept.count == 0 { return .None }
    return .Some(programUnits(session, kept))
}

// Index path dependencies among the input packages in one manifest pass.
// A manifest that does not read is left to the package's own load to report.
function packagesNeededByAnother(session: Session, roots: [String], rootIndex: NameSet) -> NameSet {
    var needed = emptyNameSet()
    for root in roots {
        let file = readFile(session, joinPath(root, "package.kira"))
        if file < 0 { continue }
        match readManifest(fileText(session, file as SourceFile), file) {
            Ok(manifest) -> {
                for dependency in manifest.dependencies {
                    let target = normalizedPath(joinPath(root, dependency.path))
                    if target != root && rootIndex.contains(target) { needed.insert(target) }
                }
            }
            Error(failure) -> {}
        }
    }
    return needed
}
                                                                                                                                                                                                              