// Loading a program: the package the compiled file belongs to, every source
// in its `app/` directory, and the libraries those sources import.
//
// A package is the directory holding `package.kira`, found by walking up from
// the file the driver was given. Every `.kira` file under its `app/` is one
// module: the files see each other's declarations with no import. `import
// Name` reaches a library, the package among the manifest's dependencies whose
// module name is `Name`; with `--sdk`, a dependency whose name is a framework
// of the SDK is that framework instead. A dependency is loaded the same way, with its own
// dependencies, once however many packages depend on it. A name no
// dependency answers may name a package the toolchain bundles: the std's
// `<stdRoot>/Name/package.kira` whose module name is `Name`, which is how
// `import Foundation` resolves anywhere. A name neither answers may name a
// framework of the SDK the driver was given with `--sdk` (KLF-RIDL section
// 27.7): `<sdk>/System/Library/Frameworks/Name.framework`, else the same in
// `PrivateFrameworks`, read from the `.ridl` contract under its `Resources/`
// and linked dynamically. A lone file with no package above it is a program
// of its own and imports only bundled packages and frameworks.

struct PackageRoot {
    let directory: String
    let manifest: Int
}

// The nearest `package.kira` at or above `directory`.
function findPackage(session: Session, directory: String) -> Optional<PackageRoot> {
    var current = directory
    while true {
        let manifest = readFile(session, joinPath(current, "package.kira"))
        if manifest >= 0 { return .Some(PackageRoot { directory = current, manifest = manifest }) }
        let parent = directoryOf(current)
        if parent == current { break }
        current = parent
    }
    return .None
}

// Program lists the source files in this build unit.
function loadProgram(session: Session, unit: Unit, entry: String, program: [SourceFile]) -> Result<SyntaxTree, Failure> {
    var loader = Loader {
        session = session, tree = SyntaxTree.empty(), separate = [],
        compileTime = ["Foundation"], loadedRoots = emptyNameSet(),
        loadedModules = emptyPackageModuleIndex(program.count), nativeLibraryNames = emptyNameSet(),
        packageSources = emptyPackageSourceIndex(program.count), pendingPackages = [],
        deferPackageDependencies = false
    }
    loader.tree.testing = testBuild(session)
    loader.tree.buildTarget = targetTriple(session)
    loader.tree.release = releaseBuild(session)
    loader.tree.framework = frameworkBuild(session)
    // A format run lays out the file's own tokens, so the file is parsed
    // alone, without its package and imports.
    let formatting = formatRun(session)
    match findPackage(session, directoryOf(entry)) {
        Some(package) -> {
            if !formatting {
                loader.deferPackageDependencies = true
                let started = loader
                // The packages built apart are read without their bodies:
                // compile-time code runs them only for a macro no earlier
                // build answered.
                loader.tree.compileTimeBodies = false
                try loader.loadPackage(package.directory, package.manifest)
                try loader.loadSplitFoundation(package.manifest)
                try loader.loadQueuedPackages()
                try loader.loadProgramPackages(program, package)
                try loader.loadPendingPackages()
                let extensionBodies = loader.extendsTemplateElsewhere()
                if !extensionBodies {
                    if !loader.readWithoutCompileTimeBodies() {
                        loader.tree.compileTimeBodies = true
                        return loader.expandAndPlaceTrailSites(unit)
                    }
                    match loader.expandAndPlaceTrailSites(unit) {
                        Ok(expanded) -> return .Ok(expanded)
                        Error -> {}
                    }
                }
                // A macro had to run, expanding failed, or a block on a
                // generic template was read without its bodies: the program
                // is read again with the bodies compile-time code imports,
                // and the blocks' when one needs them, and what expanding it
                // says is the build's answer.
                let known = loader.compileTime
                let packageSources = loader.packageSources
                loader = started
                loader.tree.compileTimeBodies = true
                loader.tree.extensionBodies = extensionBodies
                loader.compileTime = known
                loader.packageSources = packageSources
                try loader.loadPackage(package.directory, package.manifest)
                try loader.loadSplitFoundation(package.manifest)
                try loader.loadQueuedPackages()
                try loader.loadProgramPackages(program, package)
                try loader.loadPendingPackages()
                return loader.expandAndPlaceTrailSites(unit)
            }
        }
        None -> {}
    }
    let file = readFile(session, entry)
    loader.tree.modules.append(Module {
        name = "", root = directoryOf(entry), manifest = .None, package = "", library = false, loading = false, libraries = []
    })
    loader.tree = try parseFile(move loader.tree, fileText(session, file as SourceFile), file, 0)
    if formatting { return .Ok(loader.tree) }
    var imports: [Import] = []
    for imported in loader.tree.sources[0].imports {
        imports.append(Import {
            name = imported.name, alias = imported.alias,
            module = .Some(try loader.resolveImport(imported, []))
        })
    }
    loader.tree.sources[0].imports = imports
    return loader.expandAndPlaceTrailSites(unit)
}

// The packages of the program's files, each once.
function programPackages(session: Session, program: [SourceFile], own: PackageRoot) -> [PackageRoot] {
    var packages: [PackageRoot] = [own]
    var roots = emptyNameSet()
    roots.insert(normalizedPath(own.directory))
    var cache = emptyPackageRootCache()
    let ownFiles = joinPath(normalizedPath(own.directory), "")
    for entry in program {
        let file = fileName(session, entry)
        if startsWithText(normalizedPath(file), ownFiles) { continue }
        let directory = directoryOf(file)
        let top = packageSearchTop(directory)
        match packageRootDirectoryOf(session, directory, top, cache) {
            Some(package) -> {
                let normalized = normalizedPath(package.directory)
                if !roots.contains(normalized) {
                    roots.insert(normalized)
                    packages.append(package)
                }
            }
            None -> {}
        }
    }
    return packages
}

// Whether `directory` is a library the toolchain bundles.
function bundledRoot(session: Session, directory: String) -> Bool {
    let std = stdRoot(session)
    if utf8Count(std) == 0 { return false }
    return directoryOf(normalizedPath(directory)) == normalizedPath(std)
}

// Whether the driver runs the `format` hook (framework KLF-FORMAT.md section 3).
function formatRun(session: Session) -> Bool {
    match session.flag("emit") {
        Boolean(value) -> return false
        Integer(value) -> return false
        String(value) -> return value == "format"
    }
}

// Whether the program is built as a framework: `--framework`, `--emit
// shared`, or its contract with `--emit ridl`.
function frameworkBuild(session: Session) -> Bool {
    match session.flag("framework") {
        Boolean(value) -> if value { return true }
        Integer(value) -> {}
        String(value) -> {}
    }
    match session.flag("emit") {
        Boolean(value) -> return false
        Integer(value) -> return false
        String(value) -> return value == "shared" || value == "ridl"
    }
}

// Whether the driver was asked for the test build: `--test`.
function releaseBuild(session: Session) -> Bool {
    match session.flag("release") {
        Boolean(value) -> return value
        Integer(value) -> return false
        String(value) -> return false
    }
}

// The `.kira` files under the `tests/` directory when the directory is read
// (a test build of the package at the root), else nothing read.
function testDirectoryCount(session: Session, directory: String, enabled: Bool) -> Int {
    if !enabled { return 0 }
    return readDirectory(session, directory, "kira")
}

function testBuild(session: Session) -> Bool {
    match session.flag("test") {
        Boolean(value) -> return value
        Integer(value) -> return false
        String(value) -> return false
    }
}

extend Loader {
    // Whether a package built apart that compile-time code imports was read
    // without its bodies.
    function readWithoutCompileTimeBodies(borrow self) -> Bool {
        for module in tree.modules {
            if module.separate && listsText(compileTime, module.name) && !(module.compileTime && tree.compileTimeBodies) { return true }
        }
        return false
    }

    // Whether an `extend` block read without its methods' bodies names a
    // generic template, or an alias that can name an instance, which take
    // them.
    function extendsTemplateElsewhere(borrow self) -> Bool {
        for extension in tree.extensions {
            if !extension.bodiesElsewhere { continue }
            if namesTemplate(tree, extension.owner) { return true }
            for alias in tree.aliases {
                if alias.name.text == extension.owner.name.text { return true }
            }
        }
        return false
    }

    function expandAndPlaceTrailSites(borrow mut self, unit: Unit) -> Result<SyntaxTree, Failure> {
        tree = try expandProceduralMacros(session, unit, tree)
        try placeTrailSites()
        return .Ok(tree)
    }
}

struct PendingPackage {
    let root: String
    let manifestFile: Int
    let manifest: Manifest
    let module: Int
}

struct Loader {
    let session: Session
    var tree: SyntaxTree
    // The roots of the packages units of their own build, normalized.
    var separate: [String]
    // Package roots already in the graph, indexed for constant-time lookup.
    var loadedRoots: NameSet
    // Manifest file identity to graph module index, including modules loading
    // through dependency cycles.
    var loadedModules: PackageModuleIndex
    // Native libraries already installed in this graph, indexed by name.
    var nativeLibraryNames: NameSet
    // Source tokens discovered while indexing package imports, reused by the
    // parser when those packages join this compilation graph.
    var packageSources: PackageSourceIndex
    // Package dependencies are reserved and parsed from this queue while a
    // package graph is active, avoiding recursive package-load call depth.
    var pendingPackages: [PendingPackage]
    var deferPackageDependencies: Bool
    // The names of the modules compile-time code may import, as far as the
    // sources read so far tell: Foundation, which carries the macro ABI,
    // what a file declaring a macro or a compile-time function imports, and
    // what those modules import in turn (`macroEvaluationLibraries`). A
    // package is read after the packages depending on it, so its own name is
    // known by the time it is.
    var compileTime: [String]
    // The sources `library`'s `autobind` makes from its C headers, none when
    // the package keeps the bindings in `app/bindings/<module>.kira`. A header
    // is found under the package, else under one of the library's include
    // directories; one that is in neither is 4036.
    function autobound(borrow mut self, root: String, manifestFile: Int, library: NativeLibrary) -> Result<[Int], Failure> {
        var files: [Int] = []
        match library.autobind {
            None -> return .Ok(files)
            Some(autobind) -> {
                if pathExists(session, joinPath(root, joinText(["app/bindings/", autobind.module, ".kira"]))) {
                    return .Ok(files)
                }
                var selection = ""
                for named in autobind.functions {
                    if utf8Count(selection) > 0 { selection = joinText([selection, ","]) }
                    selection = joinText([selection, named])
                }
                var shared = ""
                for name in autobind.sharedPointerAliases {
                    if utf8Count(shared) > 0 { shared = joinText([shared, "\n"]) }
                    shared = joinText([shared, name])
                }
                var includes = ""
                for directory in library.includeDirs {
                    if utf8Count(includes) > 0 { includes = joinText([includes, "\n"]) }
                    includes = joinText([includes, joinPath(root, directory)])
                }
                for header in autobind.headers {
                    var path = joinPath(root, header)
                    for directory in library.includeDirs {
                        let included = joinPath(joinPath(root, directory), header)
                        if !pathExists(session, path) && pathExists(session, included) { path = included }
                    }
                    let file = readHeader(session, manifestFile, path, library.name.text, selection, includes, shared)
                    if file < 0 {
                        return .Error(Failure { diagnostic = .NativeDeclarationsUnreadable, span = library.headerSpan })
                    }
                    files.append(file)
                }
                return .Ok(files)
            }
        }
    }

    // The native libraries `manifest` declares, as a program built for the
    // session's target links them. Every package's share one namespace, as
    // the `@FFI` declarations naming them do.
    // A program asks for an asset by the path its package declares, and
    // finds it under `.kira-build/<package>.klbundle/resources/` beside the
    // entry package, as a Kira build lays it out. A declared file that is not
    // there is left out, as Kira leaves it.
    function addAssets(borrow mut self, root: String, manifest: Manifest) {
        let bundle = joinPath(tree.modules[0].root, joinText([".kira-build/", manifest.name.text, ".klbundle/resources"]))
        for asset in manifest.assets {
            let source = joinPath(root, asset)
            if utf8Count(asset) > 0 && pathExists(session, source) {
                tree.resources.append(joinText([source, "\t", joinPath(bundle, asset)]))
            }
        }
    }

    // A row naming a library twice, or a declarations file that is not
    // there, is what is wrong with it before any file it links is looked for.
    function addNativeLibraries(borrow mut self, root: String, manifest: Manifest) -> Result<Bool, Failure> {
        for library in manifest.nativeLibraries {
            if nativeLibraryNames.contains(library.name.text) {
                return .Error(Failure { diagnostic = .DuplicateNativeLibrary, span = library.name.span })
            }
            nativeLibraryNames.insert(library.name.text)
            if utf8Count(library.klffi) > 0 && !pathExists(session, joinPath(root, library.klffi)) {
                return .Error(Failure { diagnostic = .NativeDeclarationsUnreadable, span = library.klffiSpan })
            }
        }
        for library in manifest.nativeLibraries {
            tree.nativeLibraries.append(try linkNativeLibrary(root, library))
        }
        return .Ok(true)
    }

    // The module each dependency of `manifest` loads as, in manifest order.
    function loadDependencies(borrow mut self, root: String, manifest: Manifest, first: Int, last: Int) -> Result<[Int], Failure> {
        var modules: [Int] = []
        var moduleSet = emptyModuleSet()
        var dependencyNames = emptyDependencyNameSet()
        let imported = packageSourceImports(tree, first, last)
        for index in 0..manifest.dependencies.count {
            let dependency = manifest.dependencies[index]
            if dependencyNames.contains(dependency.name.text) {
                return .Error(Failure { diagnostic = .DuplicateDependency, span = dependency.name.span })
            }
            dependencyNames.insert(dependency.name.text)
            if !importsDependency(session, root, imported, dependency, packageSources) { continue }
            // A checkout the launcher fetched for this dependency, which stands
            // in for its manifest source (`--dependency`, knvm-core `Sdk.kira`).
            let fetched = dependencyOverride(session, dependency.name.text)
            if utf8Count(fetched) == 0 && dependency.source == .Registry {
                return .Error(Failure { diagnostic = .RegistryDependency, span = dependency.name.span })
            }
            if utf8Count(fetched) == 0 && dependency.source == .Git {
                return .Error(Failure { diagnostic = .GitDependency, span = dependency.name.span })
            }
            // A framework the SDK holds answers before the package the
            // dependency names (KLF-RIDL section 27.7 rule 3): the system's
            // copy of a library is the one every program on it links, and
            // the package is never compiled in beside it.
            match try loadFramework(Import { name = dependency.name, alias = dependency.name, module = .None }) {
                Some(framework) -> {
                    if !moduleSet.contains(framework) {
                        moduleSet.insert(framework)
                        modules.append(framework)
                    }
                    continue
                }
                None -> {}
            }
            var named = joinPath(root, dependency.path)
            if utf8Count(fetched) > 0 { named = fetched }
            named = normalizedPath(named)
            match resolvePackagePath(session, named, packageSources) {
                Some(package) -> {
                    var loaded = 0
                    if deferPackageDependencies {
                        loaded = try queuePackage(package.directory, package.manifest)
                    } else {
                        loaded = try loadModule(package.directory, package.manifest, dependency.name.span)
                    }
                    if !moduleSet.contains(loaded) {
                        moduleSet.insert(loaded)
                        modules.append(loaded)
                    }
                }
                None -> return .Error(Failure { diagnostic = .DependencyUnreadable, span = dependency.pathSpan })
            }
        }
        return .Ok(modules)
    }

    // Load the related package graph into the root unit. Package sources keep
    // their module namespaces while sharing this unit's semantic and backend
    // work.
    function loadProgramPackages(borrow mut self, program: [SourceFile], own: PackageRoot) -> Result<Bool, Failure> {
        if frameworkBuild(session) || testBuild(session) || utf8Count(sdkRoot(session)) > 0 { return .Ok(false) }
        // The program's packages related to this one are read: those it
        // depends on, and its consumers, since a consumer may conform one of
        // its traits and a trait's existential has a case per conformer. A
        // package that shares only a bundled library is another program's.
        let packages = programPackages(session, program, own)
        if packages.count <= 1 { return .Ok(false) }
        var sources = packageSources
        seedPackageSourceIndex(tree, sources)
        packageSources = sources
        // All input roots share this unit, so load them directly. Imports
        // still load their declared dependencies, and unrelated inputs can
        // contribute cross-package conformers without a second graph walk.
        let ownDirectory = normalizedPath(own.directory)
        var loadedAny = false
        for package in packages {
            let directory = normalizedPath(package.directory)
            if directory == ownDirectory { continue }
            if rootRead(directory) { continue }
            try loadPackage(package.directory, package.manifest)
            loadedAny = true
        }
        return .Ok(loadedAny)
    }

    // Whether a module of this tree was read from the package root `directory`
    // (a normalized path). Compared by root, since one package has one root
    // however its manifest file was reached.
    function rootRead(borrow self, directory: String) -> Bool {
        return loadedRoots.contains(directory)
    }

    // The package whose manifest is `file`, loaded once. A loading module
    // already has its declarations in the shared graph, so cycles can refer
    // to it before its imports are resolved.
    function loadModule(borrow mut self, directory: String, file: Int, span: Span) -> Result<Int, Failure> {
        match loadedModules.value(file) {
            Some(module) -> return .Ok(module)
            None -> return loadPackage(directory, file)
        }
    }

    function resolveImport(borrow mut self, imported: Import, libraries: [Int]) -> Result<Int, Failure> {
        for module in libraries {
            if tree.modules[module].name == imported.name.text { return .Ok(module) }
        }
        match try loadBundled(imported) {
            Some(module) -> return .Ok(module)
            None -> {}
        }
        match try loadFramework(imported) {
            Some(module) -> return .Ok(module)
            None -> return .Error(Failure { diagnostic = .UnknownImport, span = imported.name.span })
        }
    }

    // Foundation's declarations, when the build is split into units and no
    // file imported it. Foundation is always a unit of a split build
    // (`separate-packages.klfd`), and the program unit defines `Any`'s
    // helpers for every unit, Foundation's own `Optional<Any>`s included, so
    // it has to know `Any`. A package's own unit needs it as much, for the
    // descriptors its boxes carry (`TypeDescriptor`), unless the package is
    // one the toolchain bundles, which Foundation is built from. No source
    // sees the module without the import.
    function loadSplitFoundation(borrow mut self, manifest: Int) -> Result<Bool, Failure> {
        if frameworkBuild(session) || testBuild(session) || utf8Count(sdkRoot(session)) > 0 { return .Ok(false) }
        if tree.dependencyUnit {
            let std = stdRoot(session)
            if utf8Count(std) == 0 || tree.modules.count == 0 { return .Ok(false) }
            if startsWithText(normalizedPath(tree.modules[0].root), normalizedPath(std)) { return .Ok(false) }
        }
        for module in tree.modules {
            if module.name == "Foundation" { return .Ok(false) }
        }
        let name = Identifier { text = "Foundation", span = Span { file = manifest, start = 0, end = 0 } }
        match try loadBundled(Import { name = name, alias = name, module = .None }) {
            Some(module) -> return .Ok(true)
            None -> return .Ok(false)
        }
    }

    // The package the toolchain bundles under the name `imported` gives,
    // loaded once, or none when the toolchain bundles no such package.
    function loadBundled(borrow mut self, imported: Import) -> Result<Optional<Int>, Failure> {
        let std = stdRoot(session)
        if utf8Count(std) == 0 { return .Ok(.None) }
        let name = imported.name.text
        let directory = joinPath(std, name)
        match bundledManifestFile(name, directory) {
            Some(file) -> {
                let manifest = try readCachedManifest(session, file, packageSources)
                if manifest.moduleRoot != imported.name.text { return .Ok(.None) }
                return .Ok(.Some(try loadModule(directory, file, imported.name.span)))
            }
            None -> return .Ok(.None)
        }
    }

    function bundledManifestFile(borrow mut self, name: String, directory: String) -> Optional<Int> {
        return packageBundleManifestFile(session, name, directory, packageSources)
    }

    // The SDK framework `imported` names, loaded once as a module of the
    // declarations its contract makes, or none when the SDK has no such
    // framework. The contract's own imports reach the packages the toolchain
    // bundles and the frameworks, never a manifest's dependencies.
    function loadFramework(borrow mut self, imported: Import) -> Result<Optional<Int>, Failure> {
        let sdk = sdkRoot(session)
        if utf8Count(sdk) == 0 { return .Ok(.None) }
        let name = imported.name.text
        for index in 0..tree.modules.count {
            if tree.modules[index].framework && tree.modules[index].name == name {
                if tree.modules[index].loading {
                    return .Error(Failure { diagnostic = .DependencyCycle, span = imported.name.span })
                }
                return .Ok(.Some(index))
            }
        }
        var placement = ""
        for candidate in ["System/Library/Frameworks", "System/Library/PrivateFrameworks"] {
            if utf8Count(placement) == 0 && pathExists(session, joinPath(sdk, joinText([candidate, "/", name, ".framework"]))) {
                placement = candidate
            }
        }
        if utf8Count(placement) == 0 { return .Ok(.None) }
        // Where the framework is installed: its path in the SDK without the
        // SDK's own prefix, which the program finds it through as it runs.
        let installed = joinText(["/", placement, "/", name, ".framework"])
        let directory = joinPath(sdk, joinText([placement, "/", name, ".framework"]))
        let module = tree.modules.count
        tree.modules.append(Module {
            name = name, root = directory, manifest = .None, package = joinText([name, ".framework#", normalizedPath(directory)]),
            library = true, loading = true, libraries = [], framework = true
        })
        let file = readRidl(session, imported.name.span.file, joinPath(directory, "Resources"), name)
        if file < 0 { return .Error(Failure { diagnostic = .FrameworkContractUnreadable, span = imported.name.span }) }
        let first = tree.sources.count
        tree = try parseFile(tree, fileText(session, file as SourceFile), file, module)
        var libraries: [Int] = []
        for index in first..tree.sources.count {
            var imports: [Import] = []
            for contracted in tree.sources[index].imports {
                match try loadContracted(contracted) {
                    Some(provider) -> {
                        if !contains(libraries, provider) { libraries.append(provider) }
                        imports.append(Import { name = contracted.name, alias = contracted.alias, module = .Some(provider) })
                    }
                    None -> return .Error(Failure { diagnostic = .FrameworkContractUnreadable, span = imported.name.span })
                }
            }
            tree.sources[index].imports = imports
        }
        tree.modules[module].libraries = libraries
        tree.nativeLibraries.append(NativeLink {
            name = imported.name, header = "", artifact = "",
            linkerFlags = [joinText(["-L", directory]), joinText(["-l:", name]), joinText(["-Wl,-rpath,", installed])],
            sources = [], excluded = false, runtime = false
        })
        tree.modules[module].loading = false
        return .Ok(.Some(module))
    }

    // What an import in a framework's contract names: a package the toolchain
    // bundles, else a framework of the SDK (KLF-RIDL section 27.7 rule 4).
    function loadContracted(borrow mut self, contracted: Import) -> Result<Optional<Int>, Failure> {
        match try loadBundled(contracted) {
            Some(provider) -> return .Ok(.Some(provider))
            None -> return loadFramework(contracted)
        }
    }
}

// The checkout the launcher fetched for the dependency `name`, from the
// driver's `--dependency Name=<directory>;...`, or empty.
function dependencyOverride(session: Session, name: borrow String) -> String {
    var given = ""
    match session.flag("dependency") {
        Boolean(value) -> return ""
        Integer(value) -> return ""
        String(value) -> given = value
    }
    let entries = splitText(given, 59)
    for index in 0..entries.count {
        let pair = splitText(entries[index], 61)
        if pair.count == 2 && pair[0] == name { return pair[1] }
    }
    return ""
}

// The SDK the driver was given with `--sdk`, or empty.
function sdkRoot(session: Session) -> String {
    match session.flag("sdk") {
        Boolean(value) -> return ""
        Integer(value) -> return ""
        String(value) -> return value
    }
}

// Whether the declarations read since `macros` procedural macros and
// `functions` functions declare a macro or a compile-time function.
function declaresCompileTime(tree: borrow SyntaxTree, macros: Int, functions: Int) -> Bool {
    if tree.proceduralMacros.count > macros { return true }
    for index in functions..tree.functions.count {
        if hasAttribute(tree.functions[index].annotations, .Comptime) { return true }
    }
    return false
}
                                                                                                                                                                                         
