function floatOperator(operator: ArithmeticOperator) -> Int {
    match operator {
        Add -> return 0
        Subtract -> return 1
        Multiply -> return 2
        Divide -> return 3
        Remainder -> return 4
        BitAnd -> { abort() }
        BitOr -> { abort() }
        BitXor -> { abort() }
        ShiftLeft -> { abort() }
        ShiftRight -> { abort() }
    }
    abort()
    return 0
}
