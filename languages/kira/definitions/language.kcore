// Kira, the language profile of KLF-RIDL section 27: the one declaration
// extending `Language`, with the metadata of section 27.1, the codes the
// compiler reports, and the four phases.
//
// `parse` loads the package and the libraries it imports into one syntax
// tree, `elaborate` resolves and type-checks it into a checked program, and
// `lower` builds KIR from that program alone. Each result travels to the next phase as a definition-owned
// artifact.

construct Kira() extends Language<Tree, Program> {
    let name: String = "kira"
    let driver: String = "kira"
    let version: String = "26.10.4"
    let extensions: [String] = ["kira"]
    let memory: MemoryModel = .Affine
    let exclusivity: Exclusivity = .Static
    let convention: DefaultConvention = .Ridl
    let stdRoot: String = "std"
    // `main`'s value is the exit status, and a trap fails the program with
    // status 1, as Kira's own runtime does.
    let entry: EntryConvention = .ProcessExit
    let flags: [DriverFlag] = [
        DriverFlag { name = "test", default_value = .Boolean(false) },
        // `--release`: `Build.release()` is true and `klist!` writes literals.
        DriverFlag { name = "release", default_value = .Boolean(false) },
        // `--optimize`: the framework's KIR optimizer (KLF-RIDL section 14.1)
        // runs before the backend.
        DriverFlag { name = "optimize", default_value = .Boolean(false) },
        // `--sdk <path>`: the SDK whose frameworks `import` reaches (KLF-RIDL
        // section 27.7). None by default.
        DriverFlag { name = "sdk", default_value = .String("") },
        // `--dependency Name=<directory>;...`: the checkouts the launcher
        // fetched for dependencies with a `url` (knvm-core `Sdk.kira`).
        DriverFlag { name = "dependency", default_value = .String("") },
        // `--framework`: checks or builds the package as the framework it
        // is shipped as, whose process state lives at the top level (6001
        // does not apply), as `--emit shared` and `--emit ridl` build it.
        DriverFlag { name = "framework", default_value = .Boolean(false) },
        // `kira doc`: the package's documentation as Markdown, or with
        // `doc-check` its undocumented public API as errors (`driver/documentation.klfd`).
        DriverFlag { name = "doc", default_value = .Boolean(false) },
        DriverFlag { name = "doc-check", default_value = .Boolean(false) },
        // `kira doc --format json`: the documentation as JSON (docs/documentation.md).
        DriverFlag { name = "doc-format", default_value = .String("markdown") }
    ]

    // KLF-EDITOR section 20.1. The words, operators and number forms are the
    // lexer's (`syntax/token.klfd` and `syntax/lexer.klfd`).
    let editor: EditorSpec = EditorSpec {
        displayName = "Kira", scope = "source.kira", rootMarkers = ["package.kira"],
        lineComments = ["//"],
        blockComments = [BlockComment { open = "/*", close = "*/", nests = true }],
        strings = [StringForm { open = "\"", close = "\"", escape = .Some("\\\\."), multiline = false,
            raw = false, interpolation = .None, class = .String }],
        numbers = ["0[xX][0-9A-Fa-f]+", "\\d+(?:\\.\\d+)?"],
        identifier = "[A-Za-z_][A-Za-z0-9_]*",
        keywords = [
            KeywordGroup { class = .Keyword, modifiers = [.Control], words = ["if", "else", "while",
                "for", "in", "match", "attempt", "try", "return", "break", "continue"] },
            KeywordGroup { class = .Boolean, modifiers = [], words = ["true", "false"] },
            KeywordGroup { class = .Keyword, modifiers = [], words = ["function", "let", "var", "import",
                "as", "is", "struct", "enum", "class", "construct", "trait", "extends", "override",
                "type", "distinct"] },
            KeywordGroup { class = .Keyword, modifiers = [.Contextual], words = ["handle", "borrow",
                "mut", "move", "copy", "self"] }
        ],
        operators = ["->", "==", "!=", "<=", ">=", "&&", "||", "<<", ">>", "..", "=", "+", "-", "*",
            "/", "%", "<", ">", "&", "|", "^", "~", "!", "?", ".", ":", ",", "#"],
        brackets = [BracketPair { open = "{", close = "}" }, BracketPair { open = "(", close = ")" },
            BracketPair { open = "[", close = "]" }],
        autoClose = [AutoClosePair { open = "{", close = "}", notIn = [] },
            AutoClosePair { open = "(", close = ")", notIn = [] },
            AutoClosePair { open = "[", close = "]", notIn = [] },
            AutoClosePair { open = "\"", close = "\"", notIn = [.String, .Comment] }],
        indent = IndentRules { unit = "    ", increase = .Some("[{(\\[]\\s*$"),
            decrease = .Some("^\\s*[})\\]]") },
        annotation = .Some("@[A-Za-z_][A-Za-z0-9_]*")
    }

    // Every code kira reports. docs/diagnostics.md maps each to Kira's
    // family spelling.
    let diagnostics: [DiagnosticSpec] = [
        DiagnosticSpec { code = 1001, severity = .Error, title = "unexpected character",
            explanation = "this byte is not a valid Kira token", help = "remove the character, or replace it with the token it was meant to be, such as an operator or a quote" },
        DiagnosticSpec { code = 1002, severity = .Error, title = "unterminated string literal",
            explanation = "the string is not closed before the end of the line", help = "close the string with a `\"` before the end of the line, or write a line break inside it as `\\n`" },
        DiagnosticSpec { code = 1003, severity = .Error, title = "unknown string escape",
            explanation = "the escapes are \\n \\t \\r \\e \\0 \\\" \\\\ and a line break, which continues the string", help = "write one of the escapes `\\n`, `\\t`, `\\r`, `\\e`, `\\0`, `\\\"` or `\\\\`, or end the line to continue the string" },
        DiagnosticSpec { code = 1004, severity = .Error, title = "unterminated block comment",
            explanation = "this `/*` is never closed, and block comments nest", help = "close the comment with `*/`; a `/*` inside it opens a nested comment that needs its own `*/`" },
        DiagnosticSpec { code = 1005, severity = .Error, title = "`;` is not Kira syntax",
            explanation = "a statement ends where its grammar ends", help = "remove the `;`; each statement ends where its line ends, and `;` separates nothing in Kira" },
        DiagnosticSpec { code = 2001, severity = .Error, title = "unexpected token",
            explanation = "the parser expected a different token here", help = "check the token before this one: a missing `)`, `}` or `,` before it is the usual cause" },
        DiagnosticSpec { code = 2002, severity = .Error, title = "expected a declaration",
            explanation = "a file holds functions, structs and enums", help = "write the declaration as `function`, `struct`, `enum`, `construct`, `trait` or `extend` at the top level of the file" },
        DiagnosticSpec { code = 2003, severity = .Error, title = "expected an annotation name",
            explanation = "an annotation is `@` and a name", help = "write the annotation as `@Name` with the name of a built-in attribute or a declared macro" },
        DiagnosticSpec { code = 2004, severity = .Error, title = "expected a function name",
            explanation = "`function` is followed by the function's name", help = "write the function's name after `function`, as `function name(...)`" },
        DiagnosticSpec { code = 2005, severity = .Error, title = "expected a parameter name",
            explanation = "a parameter is written `name: Type`", help = "write each parameter as `name: Type`, the name first and its type after the colon" },
        DiagnosticSpec { code = 2006, severity = .Error, title = "expected a type name",
            explanation = "a type is written by its name", help = "write the name of a type after the colon, such as `Number`, `String`, `Bool` or a declared struct" },
        DiagnosticSpec { code = 2007, severity = .Error, title = "expected a struct name",
            explanation = "`struct` is followed by the struct's name", help = "write the struct's name after `struct`, as `struct Name { ... }`" },
        DiagnosticSpec { code = 2009, severity = .Error, title = "expected a struct member",
            explanation = "a struct member starts with `let`, `var` or `function`", help = "start each member with `let`, `var` or `function`, as in `let count: Number = 0`" },
        DiagnosticSpec { code = 2010, severity = .Error, title = "expected a name",
            explanation = "a binding or member needs a name", help = "write a name after `let`, `var` or `function`, before anything else" },
        DiagnosticSpec { code = 2011, severity = .Error, title = "a binding needs an `=` initializer",
            explanation = "definite initialization begins at the declaration", help = "add `= value` after the type, so the binding has a value from its declaration" },
        DiagnosticSpec { code = 2065, severity = .Error, title = "expected a builder body",
            explanation = "`For(name in source)` is followed by the `{ ... }` of children it produces", help = "give the builder its `{ ... }` body of child declarations after the `For(name in source)` header" },
        DiagnosticSpec { code = 3229, severity = .Error, title = "no child slot",
            explanation = "trailing child content fills a `some Family` or `[some Family]` slot, and this callee declares none", help = "remove the trailing content, or give the callee a `some Family` or `[some Family]` parameter to take it" },
        DiagnosticSpec { code = 3231, severity = .Error, title = "child slot holds one child",
            explanation = "a `some Family` slot takes exactly one child; a list of them is written `[some Family]`", help = "pass one child to this slot, or change its parameter to `[some Family]` to take a list" },
        DiagnosticSpec { code = 3242, severity = .Error, title = "builder in a single child slot",
            explanation = "a `For` or `if` builder produces any number of children, so it fills only a list slot", help = "pass a single child to this single-child slot, or declare the slot as `[some Family]` to take a list" },
        DiagnosticSpec { code = 3274, severity = .Error, title = "child slot filled twice",
            explanation = "a slot is filled by the trailing block or by a named fill, not both", help = "fill the slot once: keep either the trailing block or the named argument, and remove the other" },
        DiagnosticSpec { code = 2012, severity = .Error, title = "expected a loop variable",
            explanation = "`for` is followed by the name each iteration binds", help = "write the loop variable after `for`, as in `for item in items { ... }`" },
        DiagnosticSpec { code = 2014, severity = .Error, title = "expected an enum variant name",
            explanation = "a `match` arm starts with the variant it handles", help = "start the arm with a variant of the subject's enum, as `Case -> ...`" },
        DiagnosticSpec { code = 2016, severity = .Error, title = "expected a module name after `import`",
            explanation = "`import` is followed by the name of a library the package depends on", help = "write the name of a library the package depends on after `import`, as `import Foundation`" },
        DiagnosticSpec { code = 2015, severity = .Error, title = "expected a payload binding",
            explanation = "the parentheses of an arm name the variant's payload", help = "name the payload inside the arm's parentheses, as `Case(value) -> ...`, or drop the parentheses if it carries none" },
        DiagnosticSpec { code = 2020, severity = .Error, title = "expected an expression",
            explanation = "this token cannot start an expression", help = "write an expression here: a literal, a name, a call or a parenthesized expression" },
        DiagnosticSpec { code = 2021, severity = .Error, title = "integer literal is too large",
            explanation = "the literal is past 2^64, more than a `Number` holds", help = "write a literal that fits in 64 bits, or compute the value from smaller parts" },
        DiagnosticSpec { code = 2022, severity = .Error, title = "expected a field name",
            explanation = "`.` is followed by a field or method name", help = "write the field or method name after the `.`, as `value.name`" },
        DiagnosticSpec { code = 2023, severity = .Error, title = "expected a field name in a struct literal",
            explanation = "a struct literal lists `field = value` pairs", help = "list the struct literal's fields as `field = value` pairs, separated by commas" },
        DiagnosticSpec { code = 2024, severity = .Error, title = "expected `=` after a field name",
            explanation = "a struct literal binds a field with `=` or `:`", help = "bind the field with `=`, as `field = value`, in the struct literal" },
        DiagnosticSpec { code = 2030, severity = .Error, title = "expected an enum name",
            explanation = "`enum` is followed by the enum's name", help = "write the enum's name after `enum`, as `enum Name { ... }`" },
        DiagnosticSpec { code = 2031, severity = .Error, title = "expected an enum variant name",
            explanation = "a variant is written by its name", help = "write the variant's name, a bare identifier such as `Case`, with an optional payload in parentheses" },
        DiagnosticSpec { code = 2075, severity = .Error, title = "a bare `self` receiver",
            explanation = "write `borrow self` or `borrow mut self`; Kira has no consuming receiver", help = "write the receiver as `borrow self` to read the value or `borrow mut self` to change it" },
        DiagnosticSpec { code = 2092, severity = .Error, title = "`public` applies only to a top-level declaration",
            explanation = "`public` exports a function, type, constant or trait; extensions, imports and members take no visibility", help = "remove `public` here, or move the declaration out to top level, where `public` exports it" },
        DiagnosticSpec { code = 2093, severity = .Error, title = "`public` must be followed by a declaration",
            explanation = "write the declaration `public` exports right after it", help = "write the declaration that `public` exports right after it, such as `public struct Name { ... }`" },
        DiagnosticSpec { code = 2094, severity = .Error, title = "unknown log level",
            explanation = "a `log` level is `fault`, `warn`, `info`, `debug` or `trace`", help = "use one of the levels `fault`, `warn`, `info`, `debug` or `trace` in `log`" },
        DiagnosticSpec { code = 2095, severity = .Error, title = "log without a message",
            explanation = "a `fault` or `warn` event is read by a person, so it starts with a string literal saying what happened", help = "start the log with a string literal saying what happened, as `log(\"sent\", bytes: 4)`" },
        DiagnosticSpec { code = 2096, severity = .Error, title = "unnamed log field",
            explanation = "a field is named by its label or its source text, and a literal says nothing; label it, as in `log(\"sent\", bytes: 4)`", help = "label the value with its name, as `log(bytes: count)`, or give it a string literal of its own" },
        DiagnosticSpec { code = 2105, severity = .Error, title = "log category not written Enum.Case",
            explanation = "`category:` names the case a log is written to, as `Enum.Case` (for example `log(category: Tls.Handshake, \"sent\")`); a log has one category", help = "write the category as a declared enum case, for example `log(category: Tls.Handshake, \"sent\")`" },
        DiagnosticSpec { code = 3003, severity = .Error, title = "duplicate function",
            explanation = "a function with this name, these labels and these parameter types is already defined", help = "rename one of the functions, or give them different labels or parameter types" },
        DiagnosticSpec { code = 3004, severity = .Error, title = "duplicate type",
            explanation = "a type with this name is already defined", help = "rename one of the two declarations, or remove one, since a type's name is unique in its package" },
        DiagnosticSpec { code = 3005, severity = .Error, title = "duplicate field",
            explanation = "the struct already has a field with this name", help = "rename one of the two fields, or remove the repeated declaration of the field" },
        DiagnosticSpec { code = 3007, severity = .Error, title = "duplicate variant",
            explanation = "the enum already has a variant with this name", help = "rename one of the two variants, or remove the repeated declaration of it" },
        DiagnosticSpec { code = 3010, severity = .Error, title = "more than one `@Main`",
            explanation = "a program declares one entrypoint", help = "keep exactly one `@Main` function in the program, and remove the other" },
        DiagnosticSpec { code = 3011, severity = .Error, title = "no `@Main` function",
            explanation = "the program has no `@Main` function to run", help = "mark the function the program starts from with `@Main`, as `@Main function main() { ... }`" },
        DiagnosticSpec { code = 3012, severity = .Error, title = "an entrypoint takes no parameters",
            explanation = "`@Main` marks a function with no parameters", help = "remove the parameters from the `@Main` function, which takes none" },
        DiagnosticSpec { code = 3020, severity = .Error, title = "binding type mismatch",
            explanation = "the value does not have the type the binding is annotated with", help = "give the value the binding's annotated type, or change the annotation to the value's type" },
        DiagnosticSpec { code = 3021, severity = .Error, title = "mutation through an immutable binding",
            explanation = "declare the binding with `var` to mutate it or pass it as `borrow mut`", help = "declare the binding with `var`, or take the value as `borrow mut`" },
        DiagnosticSpec { code = 3022, severity = .Error, title = "assignment type mismatch",
            explanation = "the value does not have the type of the place it is assigned to", help = "give the value the type of the place it is assigned to, or convert it before the assignment" },
        DiagnosticSpec { code = 3023, severity = .Error, title = "assignment to an undefined name",
            explanation = "no binding with this name is in scope", help = "declare the binding with `let` or `var` before assigning it, or check the spelling of the name" },
        DiagnosticSpec { code = 3024, severity = .Error, title = "assignment to an immutable field",
            explanation = "declare the field with `var` to assign to it", help = "declare the field with `var` to assign to it" },
        DiagnosticSpec { code = 3025, severity = .Error, title = "assignment to an immutable binding",
            explanation = "declare the binding with `var` to assign to it", help = "declare the binding with `var` to assign to it" },
        DiagnosticSpec { code = 3027, severity = .Error, title = "not in scope in this file",
            explanation = "this name belongs to a library this file does not import; another file's `import` does not carry over", help = "add `import Foundation` or the package that declares this name to this file's imports" },
        DiagnosticSpec { code = 3030, severity = .Error, title = "missing return value",
            explanation = "this function must return a value of its result type", help = "return a value of the function's result type before the end of the function" },
        DiagnosticSpec { code = 3031, severity = .Error, title = "`Void` function returns a value",
            explanation = "a function without a result type returns nothing", help = "remove the value after `return`, or give the function a result type that the value has" },
        DiagnosticSpec { code = 3032, severity = .Error, title = "return type mismatch",
            explanation = "the value does not have the function's result type", help = "return a value of the function's result type, or change the function's result type" },
        DiagnosticSpec { code = 3033, severity = .Error, title = "missing return",
            explanation = "this function may finish without returning a value", help = "end every path of the function with a `return`, or an `abort` that never comes back" },
        DiagnosticSpec { code = 3040, severity = .Error, title = "condition is not `Bool`",
            explanation = "a condition must be `Bool`; Kira has no truthiness", help = "make the condition a `Bool` comparison, such as `count > 0`, since Kira has no truthy values" },
        DiagnosticSpec { code = 3042, severity = .Error, title = "`break` or `continue` outside a loop",
            explanation = "there is no loop here to leave", help = "move the `break` or `continue` inside a `for` or `while` loop" },
        DiagnosticSpec { code = 3043, severity = .Error, title = "range bound is not an integer",
            explanation = "a `for` range bound must be an integer", help = "make both bounds of the range integers, such as `for i in 0..count`" },
        DiagnosticSpec { code = 3050, severity = .Error, title = "unknown type",
            explanation = "no type with this name is declared", help = "declare the type in this package, or import the package that declares it" },
        DiagnosticSpec { code = 3052, severity = .Error, title = "struct contains itself",
            explanation = "a struct cannot hold itself by value; its fields form a cycle with no finite size", help = "break the cycle by removing the field that holds the struct by value, or hold it through a class" },
        DiagnosticSpec { code = 3059, severity = .Error, title = "override changes the field type",
            explanation = "an `override let` that restates a type must restate the inherited field's type", help = "restate the inherited field's type exactly, or drop the type and let the field keep it" },
        DiagnosticSpec { code = 3060, severity = .Error, title = "undefined name",
            explanation = "no binding with this name is in scope", help = "check the spelling; a binding is in scope only after its declaration, in its block or an enclosing one" },
        DiagnosticSpec { code = 3061, severity = .Error, title = "call to an undefined function",
            explanation = "no function with this name is declared", help = "check the spelling, or import the package that declares it; a method is called on its value, as `value.name()`" },
        DiagnosticSpec { code = 3062, severity = .Error, title = "wrong number of arguments",
            explanation = "the call passes a different number of arguments than the function takes", help = "pass the arguments the function takes, in order, or call a function with that number of parameters" },
        DiagnosticSpec { code = 3070, severity = .Error, title = "operator does not apply",
            explanation = "this operator cannot apply to a value of this type", help = "convert one operand so both sides have the same type" },
        DiagnosticSpec { code = 3071, severity = .Error, title = "operand types disagree",
            explanation = "both operands must have the same type", help = "convert one operand so both sides have the same type" },
        DiagnosticSpec { code = 3390, severity = .Error, title = "no structural equality",
            explanation = "`==` compares field by field down to the leaves; a task, native state, closure, type descriptor or C storage leaf has no equality of its own", help = "compare the struct's fields explicitly, or change the leaf to a type that supports `==`" },
        DiagnosticSpec { code = 3391, severity = .Error, title = "no structural order",
            explanation = "`<` and `compare` order field by field down to the leaves; an unsigned integer, a pointer, a handle or C storage leaf has no order the walk can read", help = "order the struct by a field that supports `<`, such as a `Number` or a `String`" },
        DiagnosticSpec { code = 3392, severity = .Error, title = "no structural hash",
            explanation = "`hash` folds the leaves' bits, which must be their value; a float, a pointer, a handle or C storage leaf has none", help = "hash a field that supports hashing, such as an integer, a `String` or a `Bool`, instead" },
        DiagnosticSpec { code = 3393, severity = .Error, title = "exit function signature",
            explanation = "an `@AtExit` function is a top-level `function name(reason: Int, detail: Int)` with a body and no result", help = "declare the exit function as `function name(reason: Int, detail: Int) { ... }` with no result" },
        DiagnosticSpec { code = 3394, severity = .Error, title = "discarded failure",
            explanation = "handle the failure, propagate with `try`, or deliberately absorb it; bare Result expressions, `let _` on a Result and unbound Error arms discard it", help = "handle the failure with `handle`, or propagate it with `try`; `let _` and an unbound Error arm discard it" },
        DiagnosticSpec { code = 3395, severity = .Error, title = "binding in a multi-pattern arm",
            explanation = "an arm with several patterns, `A, B ->`, binds no payload: give each payload its own arm", help = "give each payload its own arm, as `Case(value) -> ...`, instead of one arm for several patterns" },
        DiagnosticSpec { code = 3399, severity = .Error, title = "payload with a drop bound from a named value",
            explanation = "an arm binding a payload whose type runs `drop` takes it from the value matched, which would then drop it again: write `match move name` to give the value to the match", help = "write `match move name` to hand the value to the match, so its payload is not dropped twice" },
        DiagnosticSpec { code = 3396, severity = .Error, title = "typed memory without a type",
            explanation = "`heapLoad` reads the type it is given, `heapLoad<U32>(pointer, offset)`, or the one its position expects; here there is neither", help = "name the type to read, as `heapLoad<U32>(pointer, offset)`, or give the position an expected type" },
        DiagnosticSpec { code = 3398, severity = .Error, title = "value with a drop copied",
            explanation = "a value whose type runs `drop`, itself, through a field or through a case payload, is dropped once, by whoever holds it last: hand it over with `move` or lend it with `borrow`", help = "hand the value over with `move`, or lend it with `borrow`, so it is dropped once" },
        DiagnosticSpec { code = 3397, severity = .Error, title = "type has no C memory shape",
            explanation = "typed memory holds what C can: an integer, a float, a `Bool`, a `RawPtr`, an enum without payloads, a distinct over one of those, or an `@FFI.Struct`, `@FFI.Union` or `@FFI.Array`", help = "use a type C can hold, such as an integer, a float, a `Bool`, a `RawPtr`, or an `@FFI.Struct` or `@FFI.Union`" },
        DiagnosticSpec { code = 3107, severity = .Error, title = "use after move",
            explanation = "this binding was moved and is no longer available", help = "pass a copy of the value before the move, or use the binding only before it is moved" },
        DiagnosticSpec { code = 3111, severity = .Error, title = "cannot move a borrowed value",
            explanation = "the borrowed parameter belongs to its caller", help = "take a copy with `copy`, or pass the value to a `borrow` parameter instead" },
        DiagnosticSpec { code = 3108, severity = .Error, title = "passing a named value to an owned parameter transfers ownership",
            explanation = "write `move name` to give the value away, or declare the parameter `borrow` to lend it", help = "write `move name` to transfer the value, or `copy name` to pass a copy" },
        DiagnosticSpec { code = 3113, severity = .Error, title = "passing a named value to a `copy` parameter copies a non-trivial value",
            explanation = "a string, struct, array, enum or `Any` owns what it holds; pass a temporary, or borrow it", help = "pass a temporary value, or declare the parameter `borrow` so it lends the value instead of copying it" },
        DiagnosticSpec { code = 3117, severity = .Error, title = "cannot move a captured variable",
            explanation = "this variable is shared through a closure capture cell", help = "use the captured variable inside the closure without moving it out of the capture" },
        DiagnosticSpec { code = 2032, severity = .Error, title = "expected a type alias name",
            explanation = "a type declaration needs a name", help = "write the alias's name after `type`, as `type Name = Target`" },
        DiagnosticSpec { code = 3130, severity = .Error, title = "duplicate alias name",
            explanation = "this alias claims a name another declaration already has", help = "rename one of the two aliases or declarations, since a name is declared once in a package" },
        DiagnosticSpec { code = 3157, severity = .Error, title = "type alias cycle",
            explanation = "this alias resolves back to itself", help = "break the alias cycle by making one of the aliases name a concrete type" },
        DiagnosticSpec { code = 3106, severity = .Error, title = "value is not iterable",
            explanation = "a for loop takes an array or an integer range", help = "iterate an array, a range, or `enumerated()` of one" },
        DiagnosticSpec { code = 2057, severity = .Error, title = "expected a construct name",
            explanation = "construct is followed by its name", help = "write the construct's name after `construct`, as `construct Name extends Family { ... }`" },
        DiagnosticSpec { code = 2077, severity = .Error, title = "construct parameters without a family",
            explanation = "a construct with a parameter list is a declaration, and extends the family backing it", help = "remove the parameter list, or write the parameters on a declaration that extends a family" },
        DiagnosticSpec { code = 2078, severity = .Error, title = "construct declaration names two families",
            explanation = "a construct declaration is backed by exactly one family", help = "back the construct declaration with exactly one family, as `construct Name extends Family`" },
        DiagnosticSpec { code = 2103, severity = .Error, title = "public declaration without documentation",
            explanation = "`kira doc --check` needs a `///` doc comment on every public declaration and on each field, method and case of a public type (docs/documentation.md)", help = "write a `///` doc comment on the declaration, its fields and its cases, as the API page reads them" },
        DiagnosticSpec { code = 2101, severity = .Error, title = "doc comment without a declaration",
            explanation = "a `///` doc comment documents the declaration written right after it; move it onto one, or change it to `//` when it explains code rather than the API (docs/documentation.md)", help = "move the `///` comment onto the declaration it documents, or change it to `//` when it explains code" },
        DiagnosticSpec { code = 2102, severity = .Error, title = "inner doc comment after the first token",
            explanation = "a `//!` doc comment documents the file and must come before the file's first token; write it at the top of the file", help = "move the `//!` comment to the top of the file, before its first token" },
        DiagnosticSpec { code = 2107, severity = .Error, title = "doc example does not compile",
            explanation = "a fenced code block under `# Examples` is checked by `kira doc --check`, which compiles it as Kira in a package that imports the documented one (docs/documentation.md)", help = "fix the example so it compiles, mark it `ignore` if it is not Kira, or `compile_fail` if it must not compile; a `# ` line is hidden in the docs and still compiled" },
        DiagnosticSpec { code = 2108, severity = .Error, title = "compile_fail doc example compiles",
            explanation = "an example marked `compile_fail` must fail to compile, and this one compiled", help = "remove the `compile_fail` mark, or change the example so that it does not compile" },
        DiagnosticSpec { code = 2106, severity = .Error, title = "unresolved intra-doc link",
            explanation = "a `[`name`]` link in a doc comment names no item of the package, so `kira doc` cannot link it (docs/documentation.md)", help = "write the name of a declaration or member of this package between the backticks, as [`Name`], [`Type.member`] or [`package::Item`]; the `did you mean` line under the error names the nearest name the package has" },
        DiagnosticSpec { code = 2104, severity = .Error, title = "unknown documentation format",
            explanation = "`kira doc --format` takes `markdown` (the default) or `json` (docs/documentation.md)", help = "pass `--format markdown` or `--format json` to `kira doc`" },
        DiagnosticSpec { code = 2100, severity = .Error, title = "generic family",
            explanation = "a family takes no type parameters; a declaration backed by it may, as `construct TabView<Selection>(selection: Binding<Selection>) extends Widget`", help = "give the family no type parameters, and put them on the declaration that is backed by it, as `construct Tab<Selection>(...) extends Widget`" },
        DiagnosticSpec { code = 2066, severity = .Error, title = "computed member without a type",
            explanation = "a computed `let` member states its result type, and a stored one without a type has an initializer to take it from", help = "give the member its type after the colon, as `let count: Number` with `= value` or a computed body" },
        DiagnosticSpec { code = 2097, severity = .Error, title = "setter on a `let` member",
            explanation = "a computed member with a `set` accessor is assigned to, so it is declared with `var`", help = "declare the computed member with `var` so it can be assigned to, or drop the setter" },
        DiagnosticSpec { code = 3200, severity = .Error, title = "unknown parent construct",
            explanation = "extends must name a declared construct family", help = "name a declared construct family after `extends`, and check its spelling" },
        DiagnosticSpec { code = 3080, severity = .Error, title = "builtin takes a different number of arguments",
            explanation = "`print`, `abort`, `code`, `fromCode` and `hash` take one value, and `compare` takes two", help = "pass the argument count the builtin takes: one for `print`, `abort`, `code` and `fromCode`, and two for `compare`" },
        DiagnosticSpec { code = 3081, severity = .Error, title = "builtin argument has the wrong type",
            explanation = "`print` renders a `String`, an integer, a `Float` or a `Bool`; `code` takes an enum value; `fromCode<E>` takes an `Int` and an enum `E` whose variants carry no payload; `compare` takes two values of one type and answers Foundation's `Ordering`", help = "pass a value of the type the builtin takes, such as a `String` or an integer for `print`, or an enum for `code`" },
        DiagnosticSpec { code = 3301, severity = .Error, title = "`Drop` without `drop(borrow mut self)`",
            explanation = "a type claiming `Drop` writes `function drop(borrow mut self)` with no parameters or result", help = "write `function drop(borrow mut self)` with no parameters and no result" },
        DiagnosticSpec { code = 3288, severity = .Error, title = "compiler-known trait declared",
            explanation = "`Copyable`, `Drop`, `Send` and `Sync` exist without a declaration", help = "remove the declaration of `Copyable`, `Drop`, `Send` or `Sync`; the compiler already knows them" },
        DiagnosticSpec { code = 3289, severity = .Error, title = "not a trait",
            explanation = "a conformance or bound names something that is not a trait", help = "name a trait after `:` or `extends`, not a struct, enum or family" },
        DiagnosticSpec { code = 3290, severity = .Error, title = "conformance written twice",
            explanation = "a type conforms to a trait in exactly one place", help = "keep one conformance of the type to the trait, and remove the other" },
        DiagnosticSpec { code = 3291, severity = .Error, title = "associated type unbound",
            explanation = "nothing the conforming type presents says what this associated type is", help = "give the type the member whose requirement is written with the associated type, or give the associated type a default with `= Type`" },
        DiagnosticSpec { code = 3292, severity = .Error, title = "trait requirement missing",
            explanation = "the conforming type presents no member for this requirement", help = "write the member the trait requires, with the receiver, parameters and result the trait declares" },
        DiagnosticSpec { code = 3293, severity = .Error, title = "member disagrees with its requirement",
            explanation = "the member's receiver, parameters and result must match the trait's", help = "match the trait's requirement: the same receiver, the same parameters and the same result type" },
        DiagnosticSpec { code = 3294, severity = .Error, title = "member outside the trait",
            explanation = "an `extend Type: Trait` block carries only members the trait declares", help = "move the member into the `extend` block of its own type, or remove it, since the trait does not declare it" },
        DiagnosticSpec { code = 3298, severity = .Error, title = "family claims a compiler-known trait",
            explanation = "a construct family has no members of its own to state that fact about", help = "remove the trait from the construct family, and conform the declarations backed by it instead" },
        DiagnosticSpec { code = 3308, severity = .Error, title = "supertrait is not a trait",
            explanation = "a supertrait clause names a trait", help = "name a trait after the supertrait clause's `:`, not a struct or enum" },
        DiagnosticSpec { code = 3309, severity = .Error, title = "supertrait cycle",
            explanation = "these supertraits require one another in a loop", help = "break the loop by removing one of the supertrait clauses that names the cycle" },
        DiagnosticSpec { code = 3310, severity = .Error, title = "supertrait not conformed",
            explanation = "the type conforms to a trait without conforming to what that trait requires", help = "conform the type to every supertrait the trait requires, as well as to the trait" },
        DiagnosticSpec { code = 3315, severity = .Error, title = "bound not satisfied",
            explanation = "the type argument does not conform to the parameter's bound", help = "pass a type argument that conforms to the parameter's bound, or change the bound" },
        DiagnosticSpec { code = 2047, severity = .Error, title = "generic member",
            explanation = "a member cannot declare its own type parameters; write the concrete types out", help = "write the concrete types out instead of declaring type parameters on the member" },
        DiagnosticSpec { code = 3330, severity = .Error, title = "main-thread function called directly",
            explanation = "a `@MainThread` function is called through `MainThread.invoke`, `MainThread.spawn`, or `MainThread.post`", help = "call the `@MainThread` function through `MainThread.invoke`, `MainThread.spawn` or `MainThread.post`" },
        DiagnosticSpec { code = 3331, severity = .Error, title = "main-thread request shape",
            explanation = "a main-thread request takes one call in its trailing block and no parenthesized arguments", help = "pass the call as the one trailing block of the request, and no parenthesized arguments" },
        DiagnosticSpec { code = 3332, severity = .Error, title = "main-thread request needs a direct call",
            explanation = "the trailing block holds one direct call to a named function, with no nested trailing block", help = "give the trailing block one direct call to a named function, with no nested trailing block" },
        DiagnosticSpec { code = 3333, severity = .Error, title = "main-thread request with a mutable borrow",
            explanation = "the call's `borrow mut` parameters would reach storage that stays on the requesting context", help = "pass the value by `move` or `copy` instead of `borrow mut`, since the storage stays on the requesting context" },
        DiagnosticSpec { code = 3334, severity = .Error, title = "main-thread spawn result",
            explanation = "a spawned main-thread call returns an owned `Send` value or nothing", help = "return an owned `Send` value, or nothing, from the function that is spawned on the main thread" },
        DiagnosticSpec { code = 3335, severity = .Error, title = "value cannot cross to the main thread",
            explanation = "an argument of a main-thread request is not `Send`", help = "pass only `Send` values to the main-thread call, such as scalars, strings and structs of them" },
        DiagnosticSpec { code = 3336, severity = .Error, title = "main-thread task handle is opaque",
            explanation = "`.await` is the only operation a main-thread task handle has", help = "await the handle with `.await`, which is the only operation it has" },
        DiagnosticSpec { code = 3337, severity = .Error, title = "main-thread entrypoint",
            explanation = "the entrypoint runs on the application thread, so it cannot also be `@MainThread`", help = "remove `@MainThread` from the entrypoint, which runs on the application thread already" },
        DiagnosticSpec { code = 3368, severity = .Error, title = "kernel service signature",
            explanation = "a `@Service` function is a free, non-generic function whose parameters are owned `RawPtr`, `Int` or `U64` values and whose result is one of those or nothing", help = "declare the service as a free, non-generic function whose parameters and result are `RawPtr`, `Int` or `U64`" },
        DiagnosticSpec { code = 3275, severity = .Error, title = "ambiguous overloaded call",
            explanation = "several declarations of the name fit the call's arguments equally well, so the call has no single meaning", help = "rename one of the overloads, or pass arguments that fit only one of them" },
        DiagnosticSpec { code = 3276, severity = .Error, title = "init content not last",
            explanation = "an `init` takes content in its last parameter only: the children are written after every argument, so one `some X` parameter can hold them", help = "move the `some X` parameter to the end, since the children are written after the other arguments" },
        DiagnosticSpec { code = 3277, severity = .Error, title = "content parameter holds one child",
            explanation = "a `some X` parameter takes exactly one child; a `[some X]` parameter takes a list of them", help = "pass one child to a `some X` parameter, or declare it as `[some X]` to take a list" },
        DiagnosticSpec { code = 3278, severity = .Error, title = "init shadows the header",
            explanation = "this `init` takes what the declaration already takes between its parentheses, so a construction fits both", help = "remove this `init`, since a construction that fits both headers is ambiguous" },
        DiagnosticSpec { code = 5001, severity = .Error, title = "unknown macro",
            explanation = "no macro by this name is declared where it is used", help = "declare the macro with `comptime macro Name { ... }` in this file, or import the module that declares it" },
        DiagnosticSpec { code = 5006, severity = .Error, title = "unknown macro kind",
            explanation = "`kind { … }` names one of `function`, `attribute`, `derive`, `wrapper` or `collector`", help = "name the kind as one of `function`, `attribute`, `derive`, `wrapper` or `collector`" },
        DiagnosticSpec { code = 5007, severity = .Error, title = "macro does not apply here",
            explanation = "the macro's `appliesTo` does not list this kind of declaration", help = "list this kind of declaration in the macro's `appliesTo`, or use the macro on a declaration it applies to" },
        DiagnosticSpec { code = 5008, severity = .Error, title = "appliesTo misplaced",
            explanation = "a macro that annotates declarations lists the kinds it is legal on with `appliesTo`, and a `function` or `collector` macro lists none", help = "list the kinds of declaration the macro applies to in `appliesTo`, and leave it out of a `function` or `collector` macro" },
        DiagnosticSpec { code = 5010, severity = .Error, title = "macro expansion too deep",
            explanation = "macros kept expanding into further macro uses past the limit, which a macro that produces itself never leaves", help = "stop the macro from producing a use of itself, which is what keeps the expansion growing" },
        DiagnosticSpec { code = 5011, severity = .Error, title = "not a derive macro",
            explanation = "`@Derive(X)` names a macro that exists but is not a derive. A derive is declared `comptime macro X { kind { derive } }`; a macro declared with kind `function`, `attribute`, `wrapper` or `collector` answers a use of itself, not a position in an attribute's list. Check the `kind` on X's declaration, or use X the way it is declared.", help = "declare the macro with `kind { derive }` to use it in `@Derive`, or write it as the annotation its kind takes" },
        DiagnosticSpec { code = 5013, severity = .Error, title = "no such macro",
            explanation = "no `comptime macro` by this name is visible here at all, so nothing was rejected for being the wrong kind. A macro is visible only in the file that declares it and in files that `import` the module declaring it; another file's import does not carry over. Foundation is merged into every package, so its derives — Equatable, Clone, Hashable, Lerp, Ordered, Serializable, Tagged — need no import. `Copy` is not a macro: the compiler handles it and records an assertion. A name that was two derives once is now one: `Serializable` generates `serialize_T` and `deserialize_T` together, so listing `Deserializable` beside it is the usual way to land here.", help = "declare the `comptime macro` in this file, or import the module that declares it" },
        DiagnosticSpec { code = 5014, severity = .Error, title = "a derive macro is not used bare",
            explanation = "this name IS a derive macro — it is declared `kind { derive }` — but it was written as an annotation of its own. A derive is named inside the derive list, not applied directly: `@Derive(Exploding)`, and where a form takes several, `@Derive(Equatable, Exploding)`. A macro of kind `attribute` is the one that answers a bare `@Name`.", help = "name the derive inside the `@Derive(...)` list, not as an annotation of its own" },
        DiagnosticSpec { code = 5031, severity = .Error, title = "the macro body failed while running",
            explanation = "the macro was found, its signature matched, and its body was compiled and started — it is the RUN that failed. The body runs as a program of its own on the VM under a fixed budget (500,000,000 steps, 1 GiB), so this is a trap inside the body rather than a syntax problem in what it was handed: an unwrap of nothing, an array index out of range, a division by zero, an exhaustive match over a value the body did not expect, or the budget running out. `Diagnostics.error(...)` in the body reports 5021 with what the body said instead, which names the field or case it wanted.", help = "read the macro's diagnostics, and fix the statement in the body that failed at run time" },
        DiagnosticSpec { code = 5032, severity = .Error, title = "the macro produced unreadable syntax",
            explanation = "the body ran to completion but what it returned is not syntax the compiler can read back. A `quote` that yields nothing, a fragment that does not stand on its own, or a body that returned a value rather than quoted syntax lands here. The expansion is discarded and nothing of it is used.", help = "make the macro's `quote` return syntax the compiler can read, such as a complete declaration" },
        DiagnosticSpec { code = 5033, severity = .Error, title = "the macro body did not compile",
            explanation = "the wrapper the compiler builds around the macro body was checked and the macro's own entry point did not survive it, so nothing ran. The body is checked as a program of its own with only what its kind hands it: a `function` macro's `expand` takes the `Syntax` it was used on, a `derive` macro's takes the `Declaration` it was written on. A body referring to anything outside those — a name from the file that used it, a Foundation helper it did not import — is not in scope there, and a signature that does not match its kind is 5012.", help = "fix the macro body so it checks as a program of its own, and read its diagnostics" },
        DiagnosticSpec { code = 5034, severity = .Error, title = "a wrapped property needs a type",
            explanation = "a field a generic struct wraps is stored as that struct's instance for the field's type, `@State var count: Number = 0` as a `State<Number>`, so the field is written with its type", help = "declare the wrapped field with its type, as `@State var count: Number = 0`" },
        DiagnosticSpec { code = 5035, severity = .Error, title = "a wrapper argument needs a label",
            explanation = "an argument with no label sets a generic wrapper's next field after `wrappedValue` and `key`, and this one has none left to set: write `@Wrapper(field: value)`", help = "label the argument, as `@Wrapper(field: value)`, since no field is left for an unlabelled one" },
        DiagnosticSpec { code = 5036, severity = .Error, title = "the macro's program was read without its bodies",
            explanation = "a build first reads the packages built apart without their bodies and takes every macro's answer from an earlier build. A macro no earlier build answered needs the bodies it runs, so the build reads the program again with them and expands it anew; this code never ends a build.", help = "make the macro's package build on its own first, so its answer is ready before this build uses it" },
        DiagnosticSpec { code = 5012, severity = .Error, title = "expand signature",
            explanation = "a `comptime macro` defines `expand`, taking one value per thing its kind hands it", help = "define `expand` with one parameter per thing the macro's kind hands it" },
        DiagnosticSpec { code = 5021, severity = .Error, title = "macro reported an error",
            explanation = "the macro's body called `Diagnostics.error`, so its expansion is discarded", help = "remove the `Diagnostics.error` call, or make the macro's input valid so its expansion is kept" },
        DiagnosticSpec { code = 5025, severity = .Error, title = "no such field",
            explanation = "`Syntax.replaceField` or `Syntax.dropField` named a field the declaration does not have", help = "name a field the declaration has in `Syntax.replaceField` or `Syntax.dropField`" },
        DiagnosticSpec { code = 5028, severity = .Error, title = "two replacers",
            explanation = "two macros rewrite the same declaration, and the second would have no original left to observe", help = "rewrite the declaration with one macro, or merge the two macros into one" },
        DiagnosticSpec { code = 5029, severity = .Error, title = "trigger without replace",
            explanation = "a macro a field annotation summons rewrites the declaration carrying the field, so it declares `replace { true }`", help = "declare `replace { true }` on the macro that the field annotation summons" },
        DiagnosticSpec { code = 3370, severity = .Error, title = "move into a copy parameter",
            explanation = "a `copy` parameter takes its own copy of the argument, so the argument cannot be written `move`", help = "pass the argument without `move`, since a `copy` parameter takes its own copy" },
        DiagnosticSpec { code = 3371, severity = .Error, title = "no tests to run",
            explanation = "a test build enters the `kiraTestMain` that a test package's `TestRunner` collector generates, and this program has none", help = "add a test to the test package, or run the program without a test build" },
        DiagnosticSpec { code = 3104, severity = .Error, title = "empty array without a type",
            explanation = "`[]` holds nothing to infer an element type from; annotate what it holds, as in `let xs: [Int] = []`", help = "annotate the array's element type, as `let xs: [Int] = []`" },
        DiagnosticSpec { code = 3105, severity = .Error, title = "array elements disagree",
            explanation = "every element of an array literal has the first element's type, and numbers do not widen", help = "give every element the first element's type, or convert the elements before the literal" },
        DiagnosticSpec { code = 3362, severity = .Error, title = "no value to describe",
            explanation = "`.type` describes a value, and this expression has none", help = "apply `.type` to a value, or to a name bound to one, rather than to this expression" },
        DiagnosticSpec { code = 3363, severity = .Error, title = "not a descriptor member",
            explanation = "a runtime type descriptor answers `name`, `package`, `kind`, `arguments` and `conformances`, and nothing else", help = "read one of the descriptor's members: `name`, `package`, `kind`, `arguments` or `conformances`" },
        DiagnosticSpec { code = 3214, severity = .Error, title = "not callback state",
            explanation = "callback state holds a Kira-owned value: scalars, strings, arrays, structs and enums of them, never `Any`, a descriptor, a task or another handle", help = "store a Kira-owned value in the state: a scalar, a string, an array or a struct of them" },
        DiagnosticSpec { code = 3215, severity = .Error, title = "not a callback-state handle",
            explanation = "`nativeUserData` exports a token from the handle `nativeState` returned", help = "pass the token that `nativeUserData` exported from the handle `nativeState` returned" },
        DiagnosticSpec { code = 3216, severity = .Error, title = "recovery without one type",
            explanation = "`nativeRecover<T>` names the one type the state is recovered as", help = "name the type the state is recovered as, as `nativeRecover<Config>(token)`" },
        DiagnosticSpec { code = 3217, severity = .Error, title = "recovery from a non-token",
            explanation = "`nativeRecover` reads the state a `RawPtr` userdata token names", help = "pass the `RawPtr` userdata token the state was exported as, to `nativeRecover`" },
        DiagnosticSpec { code = 3218, severity = .Error, title = "state recovered as another type",
            explanation = "the handle this token was exported from boxes another type than the one recovered", help = "recover the state as the type its handle boxes, or box the other type in a new handle" },
        DiagnosticSpec { code = 3219, severity = .Error, title = "freeing a non-handle",
            explanation = "`nativeStateFree` releases through a callback-state handle or a `RawPtr` token", help = "release the handle with `nativeStateFree`, or the token with `nativeUserDataRelease`" },
        DiagnosticSpec { code = 3220, severity = .Error, title = "intrinsic arity",
            explanation = "a callback-state intrinsic takes exactly one value argument", help = "pass exactly one value argument to the callback-state intrinsic" },
        DiagnosticSpec { code = 3221, severity = .Error, title = "intrinsic type arguments",
            explanation = "only `nativeRecover` takes a type argument", help = "remove the type argument, since only `nativeRecover` takes one" },
        DiagnosticSpec { code = 3304, severity = .Error, title = "callback state runs a drop body",
            explanation = "boxed state outlives the frame that made it and is freed where no engine is running to enter a user `Drop` body; box what the value computes instead", help = "box the value the state computes rather than the state that runs a `drop` body" },
        DiagnosticSpec { code = 3360, severity = .Warning, title = "`nativeStateFree` is deprecated",
            explanation = "it releases one reference, not the state: let the handle go out of scope to release its reference, and pair every `nativeUserData` token with `nativeUserDataRelease`", help = "let the handle go out of scope to release it, and pair each `nativeUserData` with `nativeUserDataRelease`" },
        DiagnosticSpec { code = 3361, severity = .Error, title = "owner count of a non-token",
            explanation = "`nativeUserDataRetain` and `nativeUserDataRelease` take a `RawPtr` userdata token; a handle releases its own reference when it goes out of scope", help = "pass the `RawPtr` userdata token to `nativeUserDataRetain` or `nativeUserDataRelease`, not a handle" },
        DiagnosticSpec { code = 3369, severity = .Error, title = "kernel service body",
            explanation = "a `@Service` function names a kernel service the platform runtime implements, so it has no body", help = "remove the body, since a `@Service` function names a kernel service the platform runs" },
        DiagnosticSpec { code = 3174, severity = .Error, title = "wrong number of type arguments",
            explanation = "a generic declaration was given a different number of type arguments than it declares parameters", help = "give the generic declaration the number of type arguments it declares, as `Box<Number>`" },
        DiagnosticSpec { code = 3316, severity = .Error, title = "type arguments not inferred",
            explanation = "the call does not determine every type argument of the generic function; pass them explicitly", help = "pass the type arguments explicitly, as `make<Number>(...)`, where the call does not determine them" },
        DiagnosticSpec { code = 3175, severity = .Error, title = "instantiation without end",
            explanation = "a generic declaration instantiates ever larger versions of itself", help = "stop the generic declaration from instantiating a larger version of itself" },
        DiagnosticSpec { code = 3234, severity = .Error, title = "missing required construct member",
            explanation = "this construct does not provide a requirement of its family", help = "provide the requirement the construct's family declares, with its member written in the construct" },
        DiagnosticSpec { code = 3205, severity = .Error, title = "construct inheritance cycle",
            explanation = "the construct resolves back to itself through its parents", help = "break the construct cycle by removing one of the `extends` links that closes it" },
        DiagnosticSpec { code = 3317, severity = .Error, title = "module initialization cycle",
            explanation = "these module bindings depend on one another without an initial value", help = "give one of the module bindings an initial value, which breaks the cycle between them" },
        DiagnosticSpec { code = 3354, severity = .Error, title = "async function requires a task",
            explanation = "start this async function through Task rather than calling it directly", help = "start the async function through `Task`, as `let task = Task(run())`, rather than calling it" },
        DiagnosticSpec { code = 3353, severity = .Error, title = "task target borrows a parameter",
            explanation = "a task owns its stored arguments and cannot keep a borrowed parameter", help = "give the task an owned parameter instead of a borrowed one, since the task outlives the call" },
        DiagnosticSpec { code = 3138, severity = .Error, title = "try needs a Result",
            explanation = "try unwraps an Ok/Error enum whose Error payload is a failure enum, or the failure the function itself returns; try X otherwise Y also takes an optional value", help = "make `try` apply to a `Result` whose `Error` payload is the failure enum, or to the function's own failure" },
        DiagnosticSpec { code = 3137, severity = .Error, title = "try has no failure destination",
            explanation = "try must initialize a let directly inside an attempt body", help = "initialize a `let` directly with `try` inside the attempt body" },
        DiagnosticSpec { code = 3141, severity = .Error, title = "incompatible try failures",
            explanation = "every try in this attempt must use the same failure enum", help = "use one failure enum for every `try` in this attempt" },
        DiagnosticSpec { code = 3142, severity = .Error, title = "failure handled twice",
            explanation = "an earlier handle arm already covers this failure", help = "remove the second arm that handles this failure, since the earlier arm already covers it" },
        DiagnosticSpec { code = 3140, severity = .Error, title = "unknown failure variant",
            explanation = "this name is not a case of the failure enum", help = "write one of the failure enum's cases, or check the spelling of this one" },
        DiagnosticSpec { code = 3139, severity = .Error, title = "handle is not exhaustive",
            explanation = "handle must cover every case of the failure enum", help = "add an arm for every case of the failure enum, or an `else` that covers the rest" },
        DiagnosticSpec { code = 3143, severity = .Error, title = "attempt has no try",
            explanation = "an attempt body must contain a try initializer", help = "add a `try` initializer to the attempt body" },
        DiagnosticSpec { code = 3364, severity = .Error, title = "channel constructor takes no arguments",
            explanation = "the channel payload is selected by its type argument", help = "give the channel its payload type as the type argument, as `channel<Number>()`" },
        DiagnosticSpec { code = 3365, severity = .Error, title = "channel payload cannot be carried",
            explanation = "channels carry scalars, strings, and structs and enums built from them; a pointer, closure, task or class value cannot cross", help = "send a scalar, a string, or a struct or enum built from them, which can cross a channel" },
        DiagnosticSpec { code = 3366, severity = .Error, title = "send takes one value",
            explanation = "send requires the payload crossing the channel", help = "send the payload value the channel carries, as one value" },
        DiagnosticSpec { code = 3367, severity = .Error, title = "unknown channel operation",
            explanation = "this operation is not available on this channel end", help = "use `send`, `receive` or `close`, the operations a channel end has" },
        DiagnosticSpec { code = 2084, severity = .Error, title = "expected a distinct type name",
            explanation = "distinct is followed by its name", help = "write the distinct type's name after `distinct`, as `distinct Meters = Number`" },
        DiagnosticSpec { code = 2048, severity = .Error, title = "expected an `@FFI` block",
            explanation = "an `@FFI.*` annotation is followed by its `{ key: value, ... }` block", help = "write the `@FFI.*` annotation's fields in a `{ key: value, ... }` block" },
        DiagnosticSpec { code = 2049, severity = .Error, title = "expected an `@FFI` field name",
            explanation = "each field of an `@FFI.*` block starts with its name", help = "write each field of the `@FFI.*` block as `name: value`, starting with its name" },
        DiagnosticSpec { code = 2050, severity = .Error, title = "expected `:` after an `@FFI` field name",
            explanation = "an `@FFI.*` field is written `name: value`", help = "write the field as `name: value`, with a colon between the name and its value" },
        DiagnosticSpec { code = 2051, severity = .Error, title = "expected an `@FFI` field value",
            explanation = "a field's value is a word, a type, an element count or a `[Type, ...]` list, by its name", help = "give the field a word, a type, an element count or a `[Type, ...]` list, as its name requires" },
        DiagnosticSpec { code = 2052, severity = .Error, title = "expected `,` between `@FFI` fields",
            explanation = "the fields of an `@FFI.*` block are separated by commas", help = "separate the `@FFI.*` fields with commas" },
        DiagnosticSpec { code = 2053, severity = .Error, title = "unknown qualified annotation",
            explanation = "the qualified annotations are the `@FFI.*` family: Extern, Address, Syscall, Variadic, Struct, Union, Pointer, Array, Callback and Alias", help = "use one of the `@FFI.*` annotations: Extern, Address, Syscall, Variadic, Struct, Union, Pointer, Array, Callback or Alias" },
        DiagnosticSpec { code = 2085, severity = .Error, title = "expected a distinct representation",
            explanation = "a distinct declaration needs = Representation", help = "give the distinct declaration its representation, as `distinct Meters = Number`" },
        DiagnosticSpec { code = 3345, severity = .Error, title = "invalid distinct representation",
            explanation = "a distinct representation must resolve to one scalar word", help = "make the representation resolve to one scalar word, such as an integer or a `Number`" },
        DiagnosticSpec { code = 3346, severity = .Error, title = "distinct type cycle",
            explanation = "this distinct representation resolves back to itself", help = "break the cycle by naming a concrete representation for one of the distinct types" },
        DiagnosticSpec { code = 3347, severity = .Error, title = "distinct constructor takes one value",
            explanation = "construct the distinct type from one representation value", help = "construct the distinct type from one value of its representation type" },
        DiagnosticSpec { code = 3348, severity = .Error, title = "distinct constructor type mismatch",
            explanation = "use a representation value rather than a different nominal type", help = "pass a value of the representation type, not another nominal type" },
        DiagnosticSpec { code = 2008, severity = .Error, title = "expected a class name",
            explanation = "class is followed by its name", help = "write the class's name after `class`, as `class Name { ... }`" },
        DiagnosticSpec { code = 3051, severity = .Error, title = "class inheritance cycle",
            explanation = "this class resolves back to itself through its parents", help = "break the cycle by removing one of the `extends` links that closes it" },
        DiagnosticSpec { code = 3090, severity = .Error, title = "no fields",
            explanation = "a value of this type has no fields", help = "use a value that has fields, such as a struct, rather than this scalar or enum" },
        DiagnosticSpec { code = 3091, severity = .Error, title = "unknown field",
            explanation = "the struct has no field with this name", help = "write one of the struct's declared fields, or check the spelling of this one" },
        DiagnosticSpec { code = 3092, severity = .Error, title = "unknown struct",
            explanation = "a struct literal names a struct that is not declared", help = "declare the struct in this package, or import the package that declares it" },
        DiagnosticSpec { code = 3093, severity = .Error, title = "field initialized twice",
            explanation = "this field is already given a value in the literal", help = "give the field a value once in the literal, and remove the repeated one" },
        DiagnosticSpec { code = 3094, severity = .Error, title = "field type mismatch",
            explanation = "the value does not have the field's type", help = "pass a value of the field's declared type" },
        DiagnosticSpec { code = 3095, severity = .Error, title = "missing field",
            explanation = "a struct literal leaves out a field that declares no default", help = "give the struct literal a value for the missing field, or declare the field with a default" },
        DiagnosticSpec { code = 3186, severity = .Error, title = "no C zero value",
            explanation = "a C-layout literal leaves out a field whose type has no zero: give it a value in the literal; an `@FFI.Address` function, which answers an address, takes no parameters", help = "give the field a value in the literal, since its type has no zero" },
        DiagnosticSpec { code = 3187, severity = .Error, title = "`@FFI` form in the wrong position",
            explanation = "Extern, Address, Syscall and Variadic ride a bodyless function; Struct, Union, Pointer, Array, Callback and Alias ride a struct; an `@FFI.Address` function returns `RawPtr`", help = "move the `@FFI` annotation to the declaration its kind takes: a bodyless function, or a struct" },
        DiagnosticSpec { code = 3176, severity = .Error, title = "`CString` outside a foreign signature",
            explanation = "`CString` is the C seam's string: it is written as an `@FFI` parameter, result or C-layout field", help = "write `CString` only as an `@FFI` parameter, result or C-layout field" },
        DiagnosticSpec { code = 3177, severity = .Error, title = "`@FFI` function with an execution or export annotation",
            explanation = "a foreign function is called, not run as an entry, on the main thread, on a chosen engine or exported", help = "remove the `@MainThread`, entry or export annotation from the foreign function, which is called" },
        DiagnosticSpec { code = 3178, severity = .Error, title = "unknown `@FFI` field",
            explanation = "`@FFI.Extern` takes `library`, `symbol`, `abi` and `retains`; `@FFI.Syscall` takes `name`", help = "use only the fields `@FFI.Extern` takes: `library`, `symbol`, `abi` and `retains`; `@FFI.Syscall` takes `name`" },
        DiagnosticSpec { code = 3179, severity = .Error, title = "`@FFI` field set twice",
            explanation = "each field of an `@FFI` block but `retains` is written once", help = "write each `@FFI` field once, removing the repeated one" },
        DiagnosticSpec { code = 3180, severity = .Error, title = "missing `@FFI` field",
            explanation = "`@FFI.Extern` names its `library`, `symbol` and `abi`; `@FFI.Address` its `library` and `symbol`", help = "name the missing field: `library`, `symbol` and `abi` for `@FFI.Extern`, or `library` and `symbol` for `@FFI.Address`" },
        DiagnosticSpec { code = 3181, severity = .Error, title = "unsupported foreign ABI",
            explanation = "`@FFI.Extern` supports only the C ABI, `abi: c`", help = "write `abi: c`, the only ABI a foreign function supports" },
        DiagnosticSpec { code = 3182, severity = .Error, title = "type cannot cross the C seam",
            explanation = "a foreign signature carries scalars, `CString`, `RawPtr`, payload-less enums, distinct scalars, arrays of scalars as parameters, and `@FFI` types", help = "give the foreign signature a type C can carry: a scalar, `CString`, `RawPtr`, a payload-less enum, or a distinct scalar" },
        DiagnosticSpec { code = 3184, severity = .Error, title = "foreign name already a function",
            explanation = "an `@FFI` function shares the call namespace with every other function", help = "rename the `@FFI` function, which shares the call namespace with every other function" },
        DiagnosticSpec { code = 3185, severity = .Error, title = "foreign function declared twice",
            explanation = "an `@FFI` function name is declared once", help = "remove the second declaration, since an `@FFI` function name is declared once" },
        DiagnosticSpec { code = 3285, severity = .Error, title = "`retains` names no parameter",
            explanation = "`retains:` names a parameter of the function whose storage C keeps", help = "name a parameter of the function in `retains:`, or remove the `retains:` clause" },
        DiagnosticSpec { code = 3286, severity = .Error, title = "`retains` names a parameter twice",
            explanation = "each retained parameter is named once", help = "name each retained parameter once in `retains:`" },
        DiagnosticSpec { code = 3287, severity = .Error, title = "retained argument not moved",
            explanation = "C keeps a `retains:` argument's storage past the call, so the caller gives it up with `move`", help = "pass the retained argument with `move`, since C keeps its storage past the call" },
        DiagnosticSpec { code = 3373, severity = .Error, title = "union literal names two members",
            explanation = "an `@FFI.Union`'s members share their storage, so a literal writes at most one", help = "write one member in the `@FFI.Union` literal, since its members share their storage" },
        DiagnosticSpec { code = 3374, severity = .Error, title = "member C cannot lay out",
            explanation = "a member of an `@FFI.Struct` is a scalar, a payload-less enum, a `CString`, a distinct of one, or another `@FFI` type; a member of an `@FFI.Union` is one whose bytes C reads as they are, so not an enum or an `@FFI.Array`", help = "make the member a scalar, a payload-less enum, a `CString`, a distinct of one, or another `@FFI` type" },
        DiagnosticSpec { code = 3375, severity = .Error, title = "unknown pointer ownership",
            explanation = "an `@FFI.Pointer`'s `ownership:` is `borrowed`, `unmanaged` or `owned`, and only an owned one names a `free:` function", help = "write the `ownership:` of the `@FFI.Pointer` as `borrowed`, `unmanaged` or `owned`" },
        DiagnosticSpec { code = 3376, severity = .Error, title = "owned pointer without a free function",
            explanation = "an owned `@FFI.Pointer` names in `free:` an `@FFI.Extern` function that takes the pointer, or a `RawPtr`, and returns nothing", help = "name in `free:` an `@FFI.Extern` function that takes the pointer and returns nothing" },
        DiagnosticSpec { code = 3377, severity = .Error, title = "`@FFI.Variadic` without `@FFI.Extern`",
            explanation = "`@FFI.Variadic` marks an `@FFI.Extern` function, whose declared parameters are the fixed ones; a call passes the rest after them", help = "put `@FFI.Variadic` on an `@FFI.Extern` function, whose declared parameters are the fixed ones" },
        DiagnosticSpec { code = 3378, severity = .Error, title = "owned pointer copied",
            explanation = "an owned `@FFI.Pointer` is freed once, so it is borrowed or handed over with `move`, never copied", help = "hand the owned pointer over with `move`, or borrow it, instead of copying it" },
        DiagnosticSpec { code = 3379, severity = .Error, title = "unknown callback context",
            explanation = "an `@FFI.Callback`'s `context:` names one of its `params`, written `name: RawPtr`, which C passes back as it was given", help = "name one of the callback's `params` as `context:`, written `name: RawPtr`" },
        DiagnosticSpec { code = 3380, severity = .Error, title = "capturing lambda without a context",
            explanation = "a lambda that captures reaches its captures through the callback's `context:` parameter, which this callback does not name", help = "name a `context:` parameter on the callback, so the lambda can reach its captures" },
        DiagnosticSpec { code = 3381, severity = .Error, title = "bit-field C cannot lay out",
            explanation = "`@Bits(n)` marks an integer member of an `@FFI.Struct`, from 1 to its type's width bits wide", help = "give the `@Bits(n)` member a width from 1 to its type's width, on an integer member of an `@FFI.Struct`" },
        DiagnosticSpec { code = 3382, severity = .Error, title = "system call with too many arguments",
            explanation = "an `@FFI.Syscall` passes its arguments in registers, of which a Linux system call has six", help = "pass at most six arguments to an `@FFI.Syscall`, which a Linux system call takes in registers" },
        DiagnosticSpec { code = 3383, severity = .Error, title = "construct member type not inferred",
            explanation = "a construct member written without a type takes the type of its initializer, of the value its block ends with, or the one the wrapper taking it up gives it, and nothing gives this one a type", help = "give the construct member a type, or an initializer whose type it takes" },
        DiagnosticSpec { code = 3385, severity = .Error, title = "`match` arms disagree",
            explanation = "every arm of a `match` used as a value gives a value of one type", help = "give every arm of the `match` a value of one type, or write the match as a statement" },
        DiagnosticSpec { code = 3386, severity = .Error, title = "`match` arm without a value",
            explanation = "an arm of a `match` used as a value is an expression or ends with one, unless it cannot reach its end", help = "end the arm with an expression that gives a value, since the `match` is used as a value" },
        DiagnosticSpec { code = 3387, severity = .Error, title = "pattern of another type",
            explanation = "an enum subject is matched by its variants, an integer one by integer literals and a Bool one by `true` and `false`", help = "match an enum by its variants, an integer by integer literals, and a `Bool` by `true` and `false`" },
        DiagnosticSpec { code = 3384, severity = .Error, title = "binding prefix the value cannot take",
            explanation = "`borrow` and `copy` bind only a value that binding leaves alone, not an array, an enum, an owned C pointer or what runs a `drop`; `borrow mut` binds nothing, having no caller to write back to", help = "bind this value with `let` or `var`, or with `borrow` or `copy` only for a struct or scalar, since those prefixes refuse arrays, enums, owned C pointers and values with a `drop`" },
        DiagnosticSpec { code = 3372, severity = .Error, title = "unknown native library",
            explanation = "`library:` names a `NativeLibrary` that a package's `nativeLibraries` declares", help = "declare the library in `nativeLibraries` of `package.kira`, under the name `library:` gives" },
        DiagnosticSpec { code = 3243, severity = .Error, title = "`@FFI` storage not described",
            explanation = "an `@FFI.Array` names an `element` type and a positive `count`, an `@FFI.Alias` names a `target` type, an `@FFI.Array`, `@FFI.Alias` or `@FFI.Callback` declares no fields of its own, and a function given as a callback takes and returns what the callback names", help = "give the storage declaration its described fields, such as `element`, `count` or `target`" },
        DiagnosticSpec { code = 3119, severity = .Error, title = "variant without an enum",
            explanation = "a leading-dot variant needs a position that expects an enum", help = "write the enum before the case, as `Enum.Case`, or give the position a declared enum type" },
        DiagnosticSpec { code = 3120, severity = .Error, title = "unknown variant",
            explanation = "the enum has no variant with this name", help = "write one of the enum's variants, or check the spelling of this one" },
        DiagnosticSpec { code = 3121, severity = .Error, title = "variant takes no payload",
            explanation = "this variant carries nothing", help = "remove the payload, since this variant carries nothing" },
        DiagnosticSpec { code = 3122, severity = .Error, title = "variant takes one payload",
            explanation = "this variant carries exactly one payload value", help = "give the variant exactly one payload value, in its parentheses" },
        DiagnosticSpec { code = 3123, severity = .Error, title = "payload type mismatch",
            explanation = "the value does not have the variant's payload type", help = "pass a payload of the variant's declared type" },
        DiagnosticSpec { code = 3124, severity = .Error, title = "missing payload",
            explanation = "this variant requires a payload value", help = "give the variant the payload value its declaration requires" },
        DiagnosticSpec { code = 3125, severity = .Error, title = "`match` subject is not an enum, an integer, a Bool, a `Number` or a `String`",
            explanation = "a `match` dispatches on an enum's variant, or on the value of an integer, a `Number`, a `Bool` or a `String`", help = "match on an enum, an integer, a `Bool`, a `Number` or a `String`" },
        DiagnosticSpec { code = 3126, severity = .Error, title = "unknown variant in `match`",
            explanation = "the subject's enum has no variant with this name", help = "write one of the subject's enum variants, or check the spelling of this one" },
        DiagnosticSpec { code = 3127, severity = .Error, title = "variant matched twice",
            explanation = "an earlier arm already matches this variant", help = "remove the second arm for this variant, since the earlier arm already matches it" },
        DiagnosticSpec { code = 3128, severity = .Error, title = "nothing to bind",
            explanation = "this variant carries no payload to bind", help = "remove the binding, since this variant has no payload to bind" },
        DiagnosticSpec { code = 3129, severity = .Error, title = "`match` is not exhaustive",
            explanation = "every variant of the subject's enum, or both Bool values, needs an arm, unless an `else` arm takes the rest; an integer subject needs `else`", help = "add an arm for each missing variant, or an `else` arm that takes the rest" },
        DiagnosticSpec { code = 3131, severity = .Error, title = "`? :` condition is not `Bool`",
            explanation = "the condition of `? :` must be `Bool`", help = "make the condition of `? :` a `Bool` comparison" },
        DiagnosticSpec { code = 3132, severity = .Error, title = "`? :` branches disagree",
            explanation = "both branches of `? :` must have one type", help = "give both branches of `? :` one type" },
        DiagnosticSpec { code = 3183, severity = .Error, title = "argument type mismatch",
            explanation = "the argument does not have the parameter's type", help = "pass a value of the parameter's type, or convert it explicitly, as `Number(x)` or `String(x)`" },
        DiagnosticSpec { code = 3210, severity = .Error, title = "conversion takes one argument",
            explanation = "a numeric conversion takes exactly one argument", help = "pass exactly one argument to the numeric conversion" },
        DiagnosticSpec { code = 3255, severity = .Error, title = "`@Main` in a library",
            explanation = "a library is entered by the program that imports it and declares no `@Main`", help = "remove `@Main` from the library, which the program that imports it enters" },
        DiagnosticSpec { code = 3299, severity = .Error, title = "receiver outside a method",
            explanation = "only a function declared in a struct takes `self`", help = "declare the function inside a struct to take `self`, or remove the receiver" },
        DiagnosticSpec { code = 3350, severity = .Error, title = "literal out of range",
            explanation = "the literal does not fit the type it is written into", help = "write a value that fits the type, or change the type to one that holds it" },
        DiagnosticSpec { code = 4001, severity = .Error, title = "no package manifest",
            explanation = "several files form one program only as the `app/` sources of a package declared in `package.kira`", help = "declare the package in a `package.kira` file at its root, with the `app/` directory of its sources" },
        DiagnosticSpec { code = 4002, severity = .Error, title = "malformed package manifest",
            explanation = "`package.kira` declares `construct Name extends Package { ... }` with typed `let` members", help = "write `package.kira` as `construct Name extends Package { let ... }` with typed `let` members" },
        DiagnosticSpec { code = 4003, severity = .Error, title = "unknown package member",
            explanation = "`Package` declares `kind`, `version`, `moduleRoot`, `dependencies`, `nativeLibraries` and `systemCalls`, a dependency takes `name`, `path`, `version`, `url`, `rev` and `tag`, a native library `name`, `binary`, `header`, `klffi`, `linkerFlags`, `linkMode`, `availability`, `headers`, `sources`, `autobind` and `nativeTargets`, and a target row `triple`, `staticLib`, `dynamicLib`, `defines`, `frameworks`, `systemLibs`, `compilerFlags`, `linkerFlags` and `runtimeFiles`", help = "use only the members `Package` declares: `kind`, `version`, `moduleRoot`, `dependencies`, `nativeLibraries` and `systemCalls`" },
        DiagnosticSpec { code = 4004, severity = .Error, title = "package member has the wrong type",
            explanation = "`kind` is a `PackageKind`, `version` and `moduleRoot` are `String`s, `dependencies` is a `[Dependency]` and `nativeLibraries` a `[NativeLibrary]`", help = "give the member its declared type: a `PackageKind` for `kind`, a `String` for `version`, and so on" },
        DiagnosticSpec { code = 4010, severity = .Error, title = "no sources in `app/`",
            explanation = "a package's Kira sources live in its `app/` directory", help = "add a Kira source file in the package's `app/` directory" },
        DiagnosticSpec { code = 4020, severity = .Error, title = "dependency has no readable manifest",
            explanation = "a path dependency names a directory holding a `package.kira`", help = "add a `package.kira` to that directory, or fix the path in `dependencies` of this package" },
        DiagnosticSpec { code = 4021, severity = .Error, title = "dependency cycle",
            explanation = "this dependency leads back to a package that depends on it", help = "break the dependency cycle by removing one of the dependencies that closes it" },
        DiagnosticSpec { code = 4022, severity = .Error, title = "duplicate dependency",
            explanation = "the manifest already declares a dependency with this name", help = "remove one of the two dependencies, since a name is declared once" },
        DiagnosticSpec { code = 4034, severity = .Error, title = "malformed native library",
            explanation = "a `NativeLibrary` names its `name` and a `binary` or `nativeTargets`, each static row has something to link, and no triple has two rows", help = "name a `binary` or `nativeTargets` row, give each static row something to link, and give each triple one row" },
        DiagnosticSpec { code = 4035, severity = .Error, title = "native library declared twice",
            explanation = "every package's native libraries share one namespace", help = "rename one of the two native libraries, since every package shares one namespace for them" },
        DiagnosticSpec { code = 4038, severity = .Error, title = "shader build failed",
            explanation = "the `ksl` shader driver rejected the shader a `ksl!` call names; its diagnostics come before this one", help = "fix the shader the `ksl!` call names; its diagnostics above say which line of it failed" },
        DiagnosticSpec { code = 4039, severity = .Error, title = "shader output missing",
            explanation = "no `ksl` shader driver is on the path and `generated/shaders` holds nothing for the shader a `ksl!` call names", help = "install the `ksl` shader driver on the path, or put the shader's output in `generated/shaders`" },
        DiagnosticSpec { code = 4040, severity = .Error, title = "klist unreadable",
            explanation = "a `klist!` call names a `.klist` file relative to its package root, or to the root of the dependency module it names first; the note before this one says which file", help = "name the `.klist` file relative to the package root, or the dependency module's root, and check that it exists" },
        DiagnosticSpec { code = 4041, severity = .Error, title = "malformed klist",
            explanation = "the `.klist` file a `klist!` call reads is not klist version 1; the note before this one names the line and what is wrong", help = "make the `.klist` file version 1, the version the `klist!` call reads" },
        DiagnosticSpec { code = 4042, severity = .Error, title = "klist value missing",
            explanation = "the key path a `klist!` call names, dict keys and array indexes separated by dots, names no value in the file, or names a dict", help = "name a key path that holds a value in the file, not a dict, with dot-separated keys and indexes" },
        DiagnosticSpec { code = 4043, severity = .Error, title = "malformed klist call",
            explanation = "`klist!` takes a path and a key path, both string literals: `klist!(\"Info.klist\", \"BundleVersion\")`, with a dependency's module name first to read from that package", help = "pass `klist!` two string literals: the path to the file and the key path to read" },
        DiagnosticSpec { code = 4044, severity = .Error, title = "framework contract unreadable",
            explanation = "a framework in the SDK holds its contract as the `.ridl` files under `Resources/`; this one has none, one that does not parse, or imports a module no framework in the SDK provides", help = "give the framework a `Resources/` folder with a `.ridl` contract that parses, and import only modules a framework provides" },
        DiagnosticSpec { code = 4045, severity = .Error, title = "unknown platform",
            explanation = "`import Name on ...` names the platforms a file takes part on as `Build.platform()` spells them: `tessera`, `ios`, `macos`, `windows`, `android`, `linux`, `web` or `unknown`, separated by commas", help = "name a platform `Build.platform()` spells: `tessera`, `ios`, `macos`, `windows`, `android`, `linux`, `web` or `unknown`" },
        DiagnosticSpec { code = 4046, severity = .Error, title = "platform import after a declaration",
            explanation = "a file with an `import ... on` is left out of a build for any other platform without being read past its imports, so every import in it comes before its first declaration", help = "move the `import ... on` lines above the first declaration in the file" },
        DiagnosticSpec { code = 4037, severity = .Error, title = "native library file missing",
            explanation = "the archive, shared library or runtime file a native library's row names for this target is not there", help = "build the archive, shared library or runtime file the native library's row names, or remove the row for this target" },
        DiagnosticSpec { code = 4036, severity = .Error, title = "native declarations unreadable",
            explanation = "a native library's `klffi` names the `.klffi` file of its `@FFI` declarations, and its `autobind` the C headers to make them from, relative to the package or one of its include directories", help = "fix the `klffi` or `autobind` path in `nativeLibraries`; a path is relative to the package root or an include directory" },
        DiagnosticSpec { code = 4028, severity = .Error, title = "registry dependency",
            explanation = "only path dependencies resolve; no registry fetcher is configured", help = "replace the registry dependency with a path dependency, since no registry fetcher is configured" },
        DiagnosticSpec { code = 4029, severity = .Error, title = "git dependency",
            explanation = "only path dependencies resolve; no git fetcher is configured", help = "replace the git dependency with a path dependency, since no git fetcher is configured" },
        DiagnosticSpec { code = 4033, severity = .Error, title = "no library for this import",
            explanation = "no dependency in `package.kira`, no package the toolchain bundles and no framework in the `--sdk` SDK has this module name", help = "add a path dependency for the package in `dependencies`, or check the module name" },
        DiagnosticSpec { code = 2098, severity = .Error, title = "`@Native` is not valid on a Kira function",
            explanation = "remove `@Native`; foreign declarations use `@FFI.Extern` or `@FFI.Syscall`", help = "remove `@Native`; a foreign declaration takes `@FFI.Extern` or `@FFI.Syscall`" },
        DiagnosticSpec { code = 2099, severity = .Error, title = "declaration shadows a builtin",
            explanation = "rename the function, method or binding; `code`, `compare`, `hash`, `print` and `traceText` are builtin functions", help = "rename the function, method or binding, since `code`, `compare`, `hash`, `print` and `traceText` are builtins" },
        DiagnosticSpec { code = 3400, severity = .Error, title = "Foundation is required here",
            explanation = "add `import Foundation` to this file; text literals and value rendering require its runtime declarations", help = "add `import Foundation` to this file, which declares the runtime text and value rendering needs" },
        DiagnosticSpec { code = 3401, severity = .Error, title = "type test on a crossing family",
            explanation = "a public family of a library, or a framework's, is a RIDL trait whose values any module may declare: `is` and `as` cannot list them, so ask the value through a member of the family instead", help = "ask the value through a member the trait declares, rather than `is` or `as`, which cannot list the crossing types" },
        DiagnosticSpec { code = 3402, severity = .Error, title = "unknown annotation",
            explanation = "the name is no built-in attribute, and no macro or property wrapper in scope takes it up: declare one by that name, import the module declaring it, or remove the annotation", help = "declare a macro or property wrapper by this name, import the module that declares it, or remove the annotation" },
        DiagnosticSpec { code = 3403, severity = .Error, title = "annotation does not apply here",
            explanation = "this built-in attribute is not written on this kind of declaration; see `docs/subset.md` for where each one goes", help = "write this built-in attribute on the kind of declaration it applies to, as `docs/subset.md` lists" },
        DiagnosticSpec { code = 3404, severity = .Error, title = "private member",
            explanation = "the member is written `private`, which keeps it to the declaration writing it and to that file's extensions of its type: use it there, or drop `private`", help = "use the member only in the declaration that writes it, or drop `private` from it" },
        DiagnosticSpec { code = 3405, severity = .Error, title = "length change of a crossing array borrow",
            explanation = "a `borrow mut [T]` parameter of a public function crosses RIDL as its elements and their count, so its caller never sees a new length: write its elements in place, or pass a struct holding the array, which crosses by address", help = "write the elements the caller can see, since a `borrow mut [T]` parameter crosses RIDL without its length" },
        DiagnosticSpec { code = 3406, severity = .Error, title = "private family extended from another module",
            explanation = "a family its module does not export is an enum of that module's own declarations, so another module cannot join it: write the family `public`, which makes it a RIDL trait any module may declare members of", help = "write the family `public` so another module can join it" },
        DiagnosticSpec { code = 3407, severity = .Error, title = "atomic operand not an integer",
            explanation = "an atomic operation works on a value the hardware reads and writes whole: an integer, a sized number such as `N32`, or a `RawPtr`, which only loads, stores and exchanges take", help = "use an integer, a sized number such as `N32`, or a `RawPtr` as the operand of the atomic operation" },
        DiagnosticSpec { code = 3408, severity = .Error, title = "memory ordering not allowed here",
            explanation = "the ordering is a `MemoryOrder` case written at the call, and one the operation allows: a load is not `Release` or `AcquireRelease`, a store not `Acquire` or `AcquireRelease`, and a compare-exchange's failure ordering neither `Release` nor `AcquireRelease` nor stronger than its success ordering", help = "use an ordering the operation allows: `Relaxed` or `SeqCst` on a store, and `Acquire` or `SeqCst` on a load" },
        DiagnosticSpec { code = 3409, severity = .Error, title = "system call outside the system",
            explanation = "a program reaches the operating system through services, never through system calls of its own: call the service, or, in the package that is the system itself, write `let systemCalls: Bool = true` in its manifest", help = "call the operating system through a service, rather than a system call of the program's own" },
        DiagnosticSpec { code = 5030, severity = .Error, title = "compile-time macro evaluation failed",
            explanation = "the derive or macro could not produce syntax; inspect its reported diagnostics and ensure its input types are supported", help = "read the macro's diagnostics, and make its input types ones the macro supports" },
        DiagnosticSpec { code = 6001, severity = .Warning, title = "global mutable state",
            explanation = "put state in a value created at the entry point and pass it by mutable borrow; a framework, built with `--emit shared` or `--emit ridl`, keeps its process state in a top-level `var`, since no RIDL call carries it; a `@ThreadLocal var` is each thread's own", help = "keep the state in a value created at the entry point and pass it by `borrow mut`" },
        DiagnosticSpec { code = 6002, severity = .Warning, title = "prefixed declaration name",
            explanation = "use the package namespace, a type method or a namespaced constant instead of a short prefix", help = "use the package namespace, a type method or a namespaced constant instead of the prefix" },
        DiagnosticSpec { code = 6003, severity = .Warning, title = "integer code comparison",
            explanation = "decode the raw code into an enum at the boundary and match on its cases", help = "decode the raw code into an enum at the boundary, and match on its cases" },
        DiagnosticSpec { code = 6004, severity = .Warning, title = "comparison chain",
            explanation = "match on the value instead of comparing it in an if/else-if chain", help = "match on the value rather than comparing it in an `if`/`else if` chain" },
        DiagnosticSpec { code = 6005, severity = .Warning, title = "counted while loop",
            explanation = "use a for range or iterate over the collection", help = "write the loop as a `for` range or iterate the collection" },
        DiagnosticSpec { code = 6006, severity = .Warning, title = "flag-controlled loop",
            explanation = "use while true and leave with break or return", help = "write `while true` and leave the loop with `break` or `return`" },
        DiagnosticSpec { code = 6007, severity = .Warning, title = "fallback over an owned enum",
            explanation = "list every case of an enum this package owns so new cases require a decision", help = "list every case of the enum, so a new case forces a decision here" },
        DiagnosticSpec { code = 9001, severity = .Error, title = "outside the supported subset",
            explanation = "kira does not compile this construct yet; see docs/subset.md", help = "rewrite the construct in a supported form (docs/subset.md); a missing `String` or `Number` usually means `import Foundation` is absent" }
    ]

    // One unit per package (section 27.1): the package the first input
    // belongs to. `parse` finds the rest of it, so several inputs only make
    // sense inside one package.
    // `kira test` and `kira run` stand for uniform driver arguments.
    function compatDriver(arguments: [String]) -> Optional<DriverRequest> {
        return subcommandRequest(arguments)
    }

    // `--emit run` hands the built program here: a test build answers the
    // test protocol, and any other runs on the driver's input and output.
    function runProgram(command: [String], driverArguments: [String]) -> Int {
        if requestsTests(driverArguments) { return runTests(command) }
        return runAttached(command)
    }

    // A directory is a package: its Kira code is the files under its own
    // `app/`, never the rest of the directory, which may hold other
    // packages (examples, tests) of their own.
    // A directory of packages, such as the std the framework compiles
    // file by file (framework section 5.3), is one unit per package.
    function units(session: Session, inputs: [SourceFile]) -> [Unit] {
        if inputs.count > 1 {
            let directory = inputsDirectory(session, inputs)
            if readFile(session, joinPath(directory, "package.kira")) < 0 {
                match packageUnits(session, inputs, directory) {
                    Some(units) -> return units
                    None -> {}
                }
                // Inputs drawn from one package's `app/` have their common
                // directory there, so the package's manifest is above it.
                match packageUnits(session, inputs, enclosingPackageDirectory(session, directory)) {
                    Some(units) -> return units
                    None -> {}
                }
                let missing: Diagnostic = .MissingManifest
                diag_error_in(inputs[1], missing.code(), 0, 0)
                return [definition_unit(session, inputs[0])]
            }
            let app = joinPath(normalizedPath(joinPath(directory, "app")), "")
            for input in inputs {
                if startsWithText(normalizedPath(fileName(session, input)), app) { return programUnits(session, [input]) }
            }
            // A test build of a package without `app/` sources (its tests alone).
            let tests = joinPath(normalizedPath(joinPath(directory, "tests")), "")
            for input in inputs {
                if testBuild(session) && startsWithText(normalizedPath(fileName(session, input)), tests) { return programUnits(session, [input]) }
            }
            let empty: Diagnostic = .NoSources
            diag_error_in(inputs[0], empty.code(), 0, 0)
            return [definition_unit(session, inputs[0])]
        }
        return programUnits(session, [inputs[0]])
    }

    function parse(session: Session, unit: Unit, program: [SourceFile]) -> Tree {
        match loadProgram(session, unit, sourceName(), program) {
            Ok(tree) -> {
                // A unit named by its package manifest is a dependency built
                // apart; only the program's own unit documents its package.
                if docRequested(session) && !tree.dependencyUnit {
                    documentPackage(tree, docCheckRequested(session), docFormat(session), sourceName())
                }
                return definition_tree(session, unit, artifactHandle(tree))
            }
            Error(failure) -> {
                failure.report()
                return definition_tree(session, unit, 0)
            }
        }
    }

    function elaborate(session: Session, unit: Unit, tree: Tree) -> Program {
        let parsed: SyntaxTree = artifactValue(definition_tree_payload(session, tree))
        return definition_program(session, unit, artifactHandle(check(parsed, .None)))
    }

    function lower(session: Session, unit: Unit, program: Program) -> KirModule {
        return lowerProgram(session, unit, program)
    }

    function format(session: Session, unit: Unit, tree: Tree) -> Bool {
        return formatSource(session)
    }
}
