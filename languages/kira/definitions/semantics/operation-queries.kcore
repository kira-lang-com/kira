// Queries on a checked operation: each picks out one shape of operation and
// its operands, so callers need not match the whole enum.

extend Operation {
    // The string a `print` writes.
    function printed(borrow self) -> Optional<Int> {
        match self {
            HeapFreeRaw -> return .None
            Print(text) -> return .Some(text)
            Integer -> return .None
            FloatLiteral -> return .None
            BoxAny -> return .None
            TypeIs -> return .None
            UnboxAny -> return .None
            FunctionReference -> return .None
            IndirectCall -> return .None
            MakeClosure -> return .None
