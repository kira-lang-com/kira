extend Checker {
    function checkStyle(borrow mut self) {
        for global in tree.globals {
            if !ownSource(global.span.file) { continue }
            // A thread's own copy is no state another thread shares.
            let threadLocal = hasAttribute(global.annotations, .ThreadLocal)
            if global.binding.mutable && !tree.framework && !threadLocal { report(.GlobalMutableState, global.span) }
            lintName(global.binding.name)
        }
        var linted: [Int] = []
        for declared in tree.functions {
            if !ownSource(declared.span.file) { continue }
            // A foreign function is named by the symbol it binds, which is
            // the foreign library's name, prefix and all.
            if !hasAttribute(declared.annotations, .Foreign) { lintName(declared.name) }
            lintConstantAccessor(declared)
            lintBody(declared.body, linted)
        }
        for structure in tree.structs {
            if !ownSource(structure.name.span.file) || structure.specialized { continue }
            for method in structure.methods { lintBody(method.body, linted) }
        }
    }

    // A private free function with no inputs and a literal-only body has
    // no computation or state to hide. Keep public and attributed functions:
    // their callable identity may itself be a contract or entry point.
    function lintConstantAccessor(borrow self, declared: FunctionDeclaration) {
        if declared.receiver != .Free || declared.parameters.count != 0 || declared.typeParameters.count != 0 { return }
        if declared.body.count != 1 || declared.annotations.count != 0 { return }
        if isExportedName(tree, declared.name.span) { return }
        match tree.statements[declared.body[0]].kind {
            Return(value) -> {
                match value {
                    Some(expression) -> {
                        if isLiteralConstant(expression) { report(.ConstantAccessor, declared.name.span) }
                    }
                    None -> {}
                }
            }
            Binding -> {}
            Assignment -> {}
            CompoundAssignment -> {}
            Evaluation -> {}
            If -> {}
            While -> {}
            For -> {}
            ForEach -> {}
            Match -> {}
            Attempt -> {}
            Unsafe -> {}
            Break -> {}
            Continue -> {}
        }
    }

    function isLiteralConstant(borrow self, index: Int) -> Bool {
        match tree.expressions[index].kind {
            IntegerLiteral -> return true
            FloatLiteral -> return true
            BooleanLiteral -> return true
            StringLiteral -> return true
            ArrayLiteral -> return false
            Index -> return false
            Transfer -> return false
            Labelled -> return false
            TypeQuery -> return false
            Name -> return false
            Member -> return false
            Quote -> return false
            ExpandedMacro -> return false
            MacroCall -> return false
            Call -> return false
            GenericCall -> return false
            MethodCall -> return false
            IndirectCall -> return false
            Lambda -> return false
            KeyPath -> return false
            Task -> return false
            Try -> return false
            Variant -> return false
            StructLiteral -> return false
            Unary -> return false
            Binary -> return false
            Conditional -> return false
            MatchValue -> return false
            Content -> return false
        }
    }

    // A method can reach the tree both as a function and as a member, so
    // each body is linted once.
    function lintBody(borrow self, body: [Int], linted: borrow mut [Int]) {
        if body.count == 0 || contains(linted, body[0]) { return }
        linted.append(body[0])
        let last = tree.statements[body[body.count - 1]]
        match last.kind {
            Return(value) -> {
                match value {
                    None -> report(.RedundantVoidReturn, last.span)
                    Some -> {}
                }
            }
            Binding -> {}
            Assignment -> {}
            CompoundAssignment -> {}
            Evaluation -> {}
            If -> {}
            While -> {}
            For -> {}
            ForEach -> {}
            Match -> {}
            Attempt -> {}
            Unsafe -> {}
            Break -> {}
            Continue -> {}
        }
        lintStatements(body)
    }

    // Whether the last statement of `body` steps `name` up by one, the shape
    // of a loop a `for` range would write.
    function stepsByOne(borrow self, name: String, body: [Int]) -> Bool {
        if body.count == 0 { return false }
        for index in 0..body.count - 1 {
            if movesCounter(name, body[index]) { return false }
        }
        match tree.statements[body[body.count - 1]].kind {
            CompoundAssignment(operator, target, value) -> {
                return operator == .Add && namedAs(target, name) && isOne(value)
            }
            Assignment(target, value) -> {
                match tree.expressions[value].kind.binaryOperands(.Add) {
                    Some(sum) -> return namedAs(target, name) && namedAs(sum.left, name) && isOne(sum.right)
                    None -> return false
                }
            }
            Binding -> return false
            Evaluation -> return false
            If -> return false
            While -> return false
            For -> return false
            ForEach -> return false
            Match -> return false
            Attempt -> return false
            Unsafe -> return false
            Return -> return false
            Break -> return false
            Continue -> return false
        }
    }

    // Whether `statement` changes `name` or skips ahead with `continue`, either
    // of which a `for` range cannot say.
    function movesCounter(borrow self, name: String, statement: Int) -> Bool {
        match tree.statements[statement].kind {
            Assignment(target, value) -> return namedAs(target, name)
            CompoundAssignment(operator, target, value) -> return namedAs(target, name)
            Continue -> return true
            If(condition, yes, no) -> return anyMovesCounter(name, yes) || anyMovesCounter(name, no)
            While(condition, body) -> return anyMovesCounter(name, body)
            For(variable, low, high, body) -> return anyMovesCounter(name, body)
            ForEach(variable, source, body) -> return anyMovesCounter(name, body)
            Match(subject, arms) -> {
                for arm in arms {
                    if anyMovesCounter(name, arm.body) { return true }
                }
                return false
            }
            Attempt(body, arms) -> {
                if anyMovesCounter(name, body) { return true }
                for arm in arms {
                    if anyMovesCounter(name, arm.body) { return true }
                }
                return false
            }
            Unsafe(body) -> return anyMovesCounter(name, body)
            Binding -> return false
            Evaluation -> return false
            Return -> return false
            Break -> return false
        }
    }

    function anyMovesCounter(borrow self, name: String, body: [Int]) -> Bool {
        for statement in body {
            if movesCounter(name, statement) { return true }
        }
        return false
    }

    function namedAs(borrow self, expression: Int, name: String) -> Bool {
        match tree.expressions[expression].kind.name() {
            Some(identifier) -> return identifier.text == name
            None -> return false
        }
    }

    function isOne(borrow self, expression: Int) -> Bool {
        match tree.expressions[expression].kind.wholeIntegerLiteral() {
            Some(value) -> return value == 1
            None -> return false
        }
    }

    function ownSource(borrow self, file: Int) -> Bool {
        for source in tree.sources {
            if source.file == file { return source.module == 0 }
        }
        return false
    }

    // A two-letter lowercase lead that is no word, as in `dkSurfaces` or
    // `uiLetterFor`, is a program prefix. A longer lead is a word or an
    // acronym that is part of the name: `boxValue`, `keyName`, `kslCompiler`.
    function lintName(borrow self, name: Identifier) {
        if prefixLead(name.text) { report(.PrefixedName, name.span) }
    }

    function lintStatements(borrow self, body: [Int]) {
        for index in body {
            let statement = tree.statements[index]
            match statement.kind {
                Binding(binding) -> lintExpression(binding.value)
                Evaluation(value) -> lintExpression(value)
                Assignment(target, value) -> {
                    lintExpression(target)
                    lintExpression(value)
                }
                CompoundAssignment(operator, target, value) -> {
                    lintExpression(target)
                    lintExpression(value)
                }
                Return(value) -> { match value { Some(value) -> lintExpression(value) None -> {} } }
                If(condition, yes, no) -> {
                    lintExpression(condition)
                    if no.count == 1 {
                        match tree.statements[no[0]].kind {
                            If(next, body, otherwise) -> {
                                if sameComparedName(condition, next) { report(.ComparisonChain, statement.span) }
                            }
                            Binding -> {}
                            Assignment -> {}
                            CompoundAssignment -> {}
                            Evaluation -> {}
                            Return -> {}
                            While -> {}
                            For -> {}
                            ForEach -> {}
                            Match -> {}
                            Attempt -> {}
                            Unsafe -> {}
                            Break -> {}
                            Continue -> {}
                        }
                    }
                    lintStatements(yes)
                    lintStatements(no)
                }
                While(condition, body) -> {
                    match tree.expressions[condition].kind {
                        Name -> report(.FlagLoop, statement.span)
                        Binary(operator, left, right) -> {
                            match tree.expressions[left].kind.name() {
                                Some(counter) -> {
                                    if (operator == .Less || operator == .LessEqual) && stepsByOne(counter.text, body) {
                                        report(.CountedWhile, statement.span)
                                    }
                                }
                                None -> {}
                            }
                        }
                        IntegerLiteral -> {}
                        FloatLiteral -> {}
                        BooleanLiteral -> {}
                        StringLiteral -> {}
                        ArrayLiteral -> {}
                        Index -> {}
                        Transfer -> {}
                        Labelled -> {}
                        TypeQuery -> {}
                        Member -> {}
                        Quote -> {}
                        ExpandedMacro -> {}
                        MacroCall -> {}
                        Call -> {}
                        GenericCall -> {}
                        MethodCall -> {}
                        IndirectCall -> {}
                        Lambda -> {}
                        KeyPath -> {}
                        Task -> {}
                        Try -> {}
                        Variant -> {}
                        StructLiteral -> {}
                        Unary -> {}
                        Conditional -> {}
                        MatchValue -> {}
                        Content -> {}
                    }
                    lintExpression(condition)
                    lintStatements(body)
                }
                For(name, low, high, body) -> {
                    lintExpression(low)
                    lintExpression(high)
                    lintStatements(body)
                }
                ForEach(name, source, body) -> {
                    lintExpression(source)
                    lintStatements(body)
                }
                Match(subject, arms) -> {
                    lintExpression(subject)
                    for arm in arms { lintStatements(arm.body) }
                }
                Attempt(body, arms) -> {
                    lintStatements(body)
                    for arm in arms { lintStatements(arm.body) }
                }
                Unsafe(body) -> lintStatements(body)
                Break -> {}
                Continue -> {}
            }
        }
    }

    function sameComparedName(borrow self, first: Int, second: Int) -> Bool {
        let left = comparedName(first)
        let right = comparedName(second)
        return utf8Count(left) > 0 && left == right
    }

    function comparedName(borrow self, index: Int) -> String {
        match tree.expressions[index].kind.binaryOperands(.Equal) {
            Some(operands) -> {
                match tree.expressions[operands.left].kind.name() {
                    Some(name) -> return name.text
                    None -> {}
                }
            }
            None -> {}
        }
        return ""
    }

    function lintExpression(borrow self, index: Int) {
        let expression = tree.expressions[index]
        match expression.kind {
            Binary(operator, left, right) -> {
                if operator == .Equal || operator == .NotEqual {
                    if isBooleanLiteral(left) || isBooleanLiteral(right) {
                        report(.BooleanLiteralComparison, expression.span)
                    }
                }
                if operator == .Equal {
                    match tree.expressions[right].kind.called() {
                        Some(call) -> {
                            if call.name.text == "U32" { report(.IntegerCodeComparison, expression.span) }
                        }
                        None -> {}
                    }
                }
                lintExpression(left)
                lintExpression(right)
            }
            Unary(operator, value) -> lintExpression(value)
            Try(value) -> lintExpression(value)
            Transfer(mode, value) -> lintExpression(value)
            Labelled(name, value) -> lintExpression(value)
            Member(value, name) -> lintExpression(value)
            Index(value, position) -> {
                lintExpression(value)
                lintExpression(position)
            }
            Conditional(condition, yes, no) -> {
                lintExpression(condition)
                lintExpression(yes)
                lintExpression(no)
            }
            ArrayLiteral(values) -> { for value in values { lintExpression(value) } }
            Call(name, arguments) -> { for argument in arguments { lintExpression(argument) } }
            GenericCall(name, types, arguments) -> { for argument in arguments { lintExpression(argument) } }
            MethodCall(receiver, name, arguments) -> {
                lintExpression(receiver)
                for argument in arguments { lintExpression(argument) }
            }
            IndirectCall(callee, arguments) -> {
                lintExpression(callee)
                for argument in arguments { lintExpression(argument) }
            }
            Variant(name, payload) -> {
                match payload {
                    Some(value) -> lintExpression(value)
                    None -> {}
                }
            }
            StructLiteral(name, types, fields) -> {
                for field in fields { lintExpression(field.value) }
            }
            MatchValue(subject, arms) -> {
                lintExpression(subject)
                for arm in arms { lintStatements(arm.body) }
            }
            IntegerLiteral -> {}
            FloatLiteral -> {}
            BooleanLiteral -> {}
            StringLiteral -> {}
            Name -> {}
            Quote -> {}
            TypeQuery -> {}
            ExpandedMacro -> {}
            MacroCall -> {}
            Lambda(declaration) -> lintStatements(declaration.body)
            KeyPath -> {}
            Task(declaration) -> {
                for written in declaration.written { lintExpression(written) }
                lintStatements(declaration.body)
            }
            Content -> {}
        }
    }

    // Called only for a typed Result's `otherwise` arm, not for an Optional.
    // The parser puts one synthetic failure-trail record BEFORE the user's
    // fallback statement. That record documents absorption; it is not a
    // deliberate handler. With only that record and `return`, this error is
    // silently dropped. A direct placeholder return remains a separate warning.
    function lintFailureFallback(borrow self, arm: MatchArm) {
        if arm.body.count == 0 { return }
        if arm.body.count == 2 {
            let sole = tree.statements[arm.body[1]]
            match sole.kind {
                Return(value) -> {
                    match value {
                        None -> report(.SilentFailureReturn, sole.span)
                        Some -> {}
                    }
                }
                Binding -> {}
                Assignment -> {}
                CompoundAssignment -> {}
                Evaluation -> {}
                If -> {}
                While -> {}
                For -> {}
                ForEach -> {}
                Match -> {}
                Attempt -> {}
                Unsafe -> {}
                Break -> {}
                Continue -> {}
            }
        }
        let last = tree.statements[arm.body[arm.body.count - 1]]
        match last.kind {
            Return(value) -> {
                match value {
                    Some(returned) -> {
                        if emptyFailurePlaceholder(returned) {
                            report(.FailureFallbackPlaceholder, tree.expressions[returned].span)
                        }
                    }
                    None -> {}
                }
            }
            Binding -> {}
            Assignment -> {}
            CompoundAssignment -> {}
            Evaluation -> {}
            If -> {}
            While -> {}
            For -> {}
            ForEach -> {}
            Match -> {}
            Attempt -> {}
            Unsafe -> {}
            Break -> {}
            Continue -> {}
        }
    }

    function emptyFailurePlaceholder(borrow self, expression: Int) -> Bool {
        let syntax = tree.expressions[expression]
        match syntax.kind {
            StringLiteral(decoded) -> {
                match decoded {
                    Some(value) -> return utf8Count(value) == 0
                    None -> return syntax.span.end - syntax.span.start == 2
                }
            }
            ArrayLiteral(values) -> return values.count == 0
            BooleanLiteral(value) -> return !value
            IntegerLiteral(value, hexadecimal) -> return value == -1
            Name -> return false
            FloatLiteral -> return false
            Index -> return false
            Transfer -> return false
            Labelled -> return false
            TypeQuery -> return false
            Member -> return false
            Quote -> return false
            ExpandedMacro -> return false
            MacroCall -> return false
            Call -> return false
            GenericCall -> return false
            MethodCall -> return false
            IndirectCall -> return false
            Lambda -> return false
            KeyPath -> return false
            Task -> return false
            Try -> return false
            Variant -> return false
            StructLiteral -> return false
            Unary -> return false
            Binary -> return false
            Conditional -> return false
            MatchValue -> return false
            Content -> return false
        }
    }

    function isBooleanLiteral(borrow self, index: Int) -> Bool {
        match tree.expressions[index].kind {
            BooleanLiteral -> return true
            IntegerLiteral -> return false
            FloatLiteral -> return false
            StringLiteral -> return false
            ArrayLiteral -> return false
            Index -> return false
            Transfer -> return false
            Labelled -> return false
            TypeQuery -> return false
            Name -> return false
            Member -> return false
            Quote -> return false
            ExpandedMacro -> return false
            MacroCall -> return false
            Call -> return false
            GenericCall -> return false
            MethodCall -> return false
            IndirectCall -> return false
            Lambda -> return false
            KeyPath -> return false
            Task -> return false
            Try -> return false
            Variant -> return false
            StructLiteral -> return false
            Unary -> return false
            Binary -> return false
            Conditional -> return false
            MatchValue -> return false
            Content -> return false
        }
    }
}

// Whether `text` starts with two lowercase letters that are no word, then a
// capital.
function prefixLead(text: String) -> Bool {
    if utf8Count(text) < 4 { return false }
    for index in 0..2 {
        let letter = utf8Byte(text, index)
        if letter < 97 || letter > 122 { return false }
    }
    let next = utf8Byte(text, 2)
    if next < 65 || next > 90 { return false }
    for word in ["as", "at", "by", "do", "go", "id", "if", "in", "is", "no", "of", "on", "or", "to", "up"] {
        if startsWithText(text, word) { return false }
    }
    return true
}
