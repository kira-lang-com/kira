function isForeignPointerValue(program: CheckedProgram, valueType: Type) -> Bool {
    if valueType.kind != .Structure { return false }
    match program.structs[valueType.declaration].shape {
        CPointer -> return true
        Callback -> return true
        Plain -> return false
        CLayout -> return false
        CUnion -> return false
        CArray -> return false
    }
}
