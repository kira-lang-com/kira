            EnumCode -> return .None
            EnumFromCode -> return .None
            Order -> return .None
            Hash -> return .None
            Logical -> return .None
            Select -> return .None
            Choice -> return .None
            Bitcast -> return .None
            Convert -> return .None
            ForeignImage -> return .None
            ForeignElements -> return .None
            ForeignCallback -> return .None
            ForeignRead -> return .None
            ForeignUnion -> return .None
        }
    }

    // Whether the operation stops the program.
    function isTrap(borrow self) -> Bool {
        match self {
            FunctionReference -> return false
            IndirectCall -> return false
            MakeClosure -> return false
            GlobalRead -> return false
            TaskSpawn -> return false
            TaskReady -> return false
            TaskAwait -> return false
