// A place's last step: a field of a struct or an element of an array, or
// `Whole` for a place that is no part of another value.
enum PlacePart {
    Field(PlaceStepOperands)
    Element(PlaceStepOperands)
    Whole
}

// The value a place step is taken from, and the field number or the index
// expression that takes it.
struct PlaceStepOperands {
    let base: Int
    let part: Int
}

extend Operation {
    // The case an enum value is built as.
    function taggedVariant(borrow self) -> Optional<Int> {
        match self {
            Integer -> return .None
            FloatLiteral -> return .None
            BoxAny -> return .None
            TypeIs -> return .None
            UnboxAny -> return .None
            FunctionReference -> return .None
            IndirectCall -> return .None
            MakeClosure -> return .None
            GlobalRead -> return .None
            TaskSpawn -> return .None
