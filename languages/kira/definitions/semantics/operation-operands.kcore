            Call -> return .None
            Construct -> return .None
            Tagged(variant, payload) -> return .Some(variant)
            Unary -> return .None
            Arithmetic -> return .None
            Wrapping -> return .None
            Compare -> return .None
            EnumCode -> return .None
            EnumFromCode -> return .None
            Order -> return .None
