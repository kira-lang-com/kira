extend Operation {
    // The value a member is read from.
    function memberBase(borrow self) -> Optional<Int> {
        match self {
            FunctionReference -> return .None
            IndirectCall -> return .None
            MakeClosure -> return .None
            GlobalRead -> return .None
            TaskSpawn -> return .None
            TaskReady -> return .None
            TaskAwait -> return .None
            TaskCancel -> return .None
            TaskDetach -> return .None
            Async -> return .None
            RuntimeTrap -> return .None
            StringText -> return .None
            Sequence -> return .None
            Try -> return .None
            ChannelCreate -> return .None
            ChannelReceiver -> return .None
            ChannelSend -> return .None
            ChannelClose -> return .None
            ClassView -> return .None
            ClassCall -> return .None
            Integer -> return .None
            FloatLiteral -> return .None
            BoxAny -> return .None
            TypeIs -> return .None
            UnboxAny -> return .None
            Boolean -> return .None
            StringLiteral -> return .None
            StringConcat -> return .None
            TraceText -> return .None
            HeapAllocateRaw -> return .None
            HeapFreeRaw -> return .None
            Print -> return .None
            HeapRead -> return .None
            HeapWrite -> return .None
            Atomic -> return .None
            HeapCopy -> return .None
            HeapFill -> return .None
            HeapOffset -> return .None
            HeapLayout -> return .None
            ArrayLiteral -> return .None
            ArrayIndex -> return .None
            ArrayAppend -> return .None
            Transfer -> return .None
            Read -> return .None
            Member(base, field) -> return .Some(base)
            Call -> return .None
            Construct -> return .None
            Tagged -> return .None
            Unary -> return .None
            Arithmetic -> return .None
            Wrapping -> return .None
            Compare -> return .None
            EnumCode -> return .None
            EnumFromCode -> return .None
            Order -> return .None
            Hash -> return .None
            Logical -> return .None
            Select -> return .None
            Choice -> return .None
            Bitcast -> return .None
            Convert -> return .None
            ForeignImage -> return .None
            ForeignElements -> return .None
            ForeignCallback -> return .None
            ForeignRead -> return .None
            ForeignUnion -> return .None
        }
    }

    // The step a place takes from the value it is part of: a member or an
    // array element.
    function placePart(borrow self) -> PlacePart {
        match self {
            FunctionReference -> return .Whole
            IndirectCall -> return .Whole
            MakeClosure -> return .Whole
            GlobalRead -> return .Whole
            TaskSpawn -> return .Whole
            TaskReady -> return .Whole
            TaskAwait -> return .Whole
            TaskCancel -> return .Whole
            TaskDetach -> return .Whole
            Async -> return .Whole
            RuntimeTrap -> return .Whole
            StringText -> return .Whole
            Sequence -> return .Whole
            Try -> return .Whole
            ChannelCreate -> return .Whole
            ChannelReceiver -> return .Whole
            ChannelSend -> return .Whole
            ChannelClose -> return .Whole
            ClassView -> return .Whole
            ClassCall -> return .Whole
            Integer -> return .Whole
            FloatLiteral -> return .Whole
            BoxAny -> return .Whole
            TypeIs -> return .Whole
            UnboxAny -> return .Whole
            Boolean -> return .Whole
            StringLiteral -> return .Whole
            StringConcat -> return .Whole
            TraceText -> return .Whole
            HeapAllocateRaw -> return .Whole
            HeapFreeRaw -> return .Whole
            Print -> return .Whole
            HeapRead -> return .Whole
            HeapWrite -> return .Whole
            Atomic -> return .Whole
            HeapCopy -> return .Whole
            HeapFill -> return .Whole
            HeapOffset -> return .Whole
            HeapLayout -> return .Whole
            ArrayLiteral -> return .Whole
            ArrayIndex(base, index) -> return .Element(PlaceStepOperands { base = base, part = index })
            ArrayAppend -> return .Whole
            Transfer -> return .Whole
            Read -> return .Whole
            Member(base, field) -> return .Field(PlaceStepOperands { base = base, part = field })
            Call -> return .Whole
            Construct -> return .Whole
            Tagged -> return .Whole
            Unary -> return .Whole
            Arithmetic -> return .Whole
            Wrapping -> return .Whole
            Compare -> return .Whole
            EnumCode -> return .Whole
            EnumFromCode -> return .Whole
            Order -> return .Whole
            Hash -> return .Whole
            Logical -> return .Whole
            Select -> return .Whole
            Choice -> return .Whole
            Bitcast -> return .Whole
            Convert -> return .Whole
            ForeignImage -> return .Whole
            ForeignElements -> return .Whole
            ForeignCallback -> return .Whole
            ForeignRead -> return .Whole
            ForeignUnion -> return .Whole
        }
    }

    // The `Any` an unboxing reads.
    function unboxedOperand(borrow self) -> Optional<Int> {
        match self {
            FunctionReference -> return .None
            IndirectCall -> return .None
            MakeClosure -> return .None
            GlobalRead -> return .None
            TaskSpawn -> return .None
