import Foundation

// The categories the Network library logs under. A program turns one on with
// `KIRA_LOG=Network.NetworkLog.Session=trace` or `Log.enable` on the same path.
// Each case's threshold is its declared default: failures print, the normal
// path stays quiet.
enum NetworkLog: LogCategory {
    // A request that ended with a failure.
    Request
    // A connection that came up or went down.
    Connection
    // A session, a link or an HTTP/3 connection that ended with a failure.
    Session

    function threshold(borrow self) -> TrailThreshold {
        match self {
            Request -> return .UpTo(.Warn)
            Connection -> return .UpTo(.Warn)
            Session -> return .UpTo(.Warn)
        }
    }
}
