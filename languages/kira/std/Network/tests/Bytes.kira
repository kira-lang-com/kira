import Foundation

// RFC 9000 appendix A.1's sample variable-length integers, each in the
// length the RFC encodes it in.

// The four sample integers decode from their wire bytes, in order, and the
// reader is then at the end.
@Test
function varintsDecodeAsRfc9000Samples() {
    var reader = WireReader {
        bytes: [194, 25, 124, 94, 255, 20, 232, 140, 157, 127, 62, 125, 123, 189, 37, 64, 37]
    }
    var values: [Number] = []
    while !reader.atEnd() {
        match reader.readVarint() {
            Ok(value) -> values.append(Number(value))
            Error(failure) -> {
                expect!(traceText(failure) == "")
                return
            }
        }
    }
    expect!("\(values.count)" == "5")
    expect!("\(values[0])" == "151288809941952652")
    expect!("\(values[1])" == "494878333")
    expect!("\(values[2])" == "15293")
    expect!("\(values[3])" == "37")
    expect!("\(values[4])" == "37")
    expect!((reader.atEnd()) == (true))
}

// Each value is written in the shortest length that holds it: one, two, four
// and eight bytes.
@Test
function varintsWriteInTheirShortestLength() {
    var writer = WireWriter {}
    writer.writeVarint(37)
    expect!((Number(writer.bytes[0])) == (37))
    writer.writeVarint(15293)
    expect!((writer.bytes.count) == (3))
    writer.writeVarint(494878333)
    expect!((writer.bytes.count) == (7))
    writer.writeVarint(151288809941952652)
    expect!((writer.bytes.count) == (15))
}

// A reserved length is filled with the body's size, and a body too large for
// its reserved width is refused without writing.
@Test
function reservedLengthsAreFilledAndBounded() {
    var writer = WireWriter {}
    let mark = writer.reserveLength(2)
    writer.writeBytes([7, 8, 9])
    expect!(traceText(writer.fillLength(mark)) == "Ok")
    expect!((writer.bytes.count) == (5))
    expect!((Number(writer.bytes[0])) == (0))
    expect!((Number(writer.bytes[1])) == (3))
    expect!((Number(writer.bytes[2])) == (7))
    expect!((Number(writer.bytes[4])) == (9))
    var small = WireWriter {}
    let tight = small.reserveLength(1)
    for _ in 0..256 { small.writeByte(0) }
    expect!(traceText(small.fillLength(tight)) == "Error(WireFailure.TooLarge)")
}

// A vector or varint that runs past the end fails with Truncated and does not trap.
@Test
function truncatedVectorsFailInsteadOfTrapping() {
    var reader = WireReader { bytes: [0, 5, 1, 2] }
    expect!(traceText(reader.readVector(2)) == "Error(WireFailure.Truncated)")
    var short = WireReader { bytes: [64] }
    expect!(traceText(short.readVarint()) == "Error(WireFailure.Truncated)")
}
