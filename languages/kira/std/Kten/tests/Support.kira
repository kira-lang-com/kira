import Foundation

// The sample Kten value the cases round-trip, and the hexadecimal helper. Not tests.

function sample() -> Kten {
    return ktenObject(
        "Message",
        [
            ktenField("id", .Number(300)),
            ktenField("delta", .Number(-1)),
            ktenField("cost", .Number(0.0025)),
            ktenField("huge", .Number(18446744073709551615)),
            ktenField("text", .Text("é \"quoted\"\n")),
            ktenField("raw", .Bytes([0, 171, 255])),
            ktenField("done", .Bool(true)),
            ktenField(
                "parts",
                .List([.Null, ktenCase("Role", [.Text("user")]), ktenCase("Idle", [])])
            ),
            ktenField("extra", ktenBare([]))
        ]
    )
}

function ktenHex(bytes: borrow [UN8]) -> String {
    return ktenHexText(bytes).substring(2, ktenHexText(bytes).count)
}

