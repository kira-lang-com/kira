class RuntimeContext {
    // Fields are given up in the order they are declared. Ambient slots each
    // own a native state, and giving one up writes its slot in `nativeStates`,
    // so the store goes first, while the slots are still there.
    var ambient: AmbientStore = AmbientStore {}
    var channels: [ChannelState] = []
    var nativeStates: [NativeStateSlot] = []
    var nativeStateLocations: Map<Int, Int> = Map {}
    var nativeStateFree: Int = -1
    var nativeStateIdentity: Int = 0
    var deferredTasks: [DeferredTaskState] = []
    var deferredQueue: [Number] = []
    var deferredCursor: Number = 0
    var clock: Number = 0
    var documents: [KlistDocument] = []
    var macroReports: [Number] = []
    var traceBuffer: String = ""
    var traceNesting: Number = 0
    var trail: TrailState = TrailState {}
    // Expectations that failed in the test function this process runs.
    var testIssues: Number = 0
}

let runtimeContext = RuntimeContext {}
