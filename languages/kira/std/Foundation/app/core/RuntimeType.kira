// `value.type`: the runtime descriptor of what a value is. Two descriptors are
// equal exactly when they name one type. A descriptor answers `name`,
// `package`, `kind`, `arguments` and `conformances` from the program's table
// of types, whose rows the compiler writes as the bodies of the `@TypeTable`
// functions below.
struct Type {
    let id: Int
}

@TypeTable
function typeName(id: Int) -> String

@TypeTable
function typePackage(id: Int) -> String

@TypeTable
function typeKind(id: Int) -> String

@TypeTable
function typeArguments(id: Int) -> [Type]

@TypeTable
function typeConformances(id: Int) -> [String]

// Why `try value as T` failed: the value held another type, which the
// handler reads since the value itself is gone.
enum TypeCastError {
    Mismatch(Type)
}
