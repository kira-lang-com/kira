// `(A, B)` and its larger forms. The parser writes a tuple type as `TupleN`,
// a tuple literal as a `TupleN` literal and `.0` as `.item0`.
struct Tuple2<A, B> {
    let item0: A
    let item1: B
}

struct Tuple3<A, B, C> {
    let item0: A
    let item1: B
    let item2: C
}

struct Tuple4<A, B, C, D> {
    let item0: A
    let item1: B
    let item2: C
    let item3: D
}
