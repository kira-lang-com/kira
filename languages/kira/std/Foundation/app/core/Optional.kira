enum Optional<Value> {
    None
    Some(Value)

    function isNone(borrow self) -> Bool {
        return match self {
            None -> true
            Some -> false
        }
    }

    function isSome(borrow self) -> Bool {
        return !isNone()
    }

    function unwrap(borrow self) -> Value {
        match self {
            None -> runtimeTrap()
            Some(value) -> return value
        }
    }

    // The value, or `fallback` when there is none.
    function or(borrow self, fallback: borrow Value) -> Value {
        return match self {
            None -> fallback
            Some(value) -> value
        }
    }
}
