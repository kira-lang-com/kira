// The monotonic clock: it never jumps when the wall clock is set, so
// timers and deadlines are measured on it.

// Nanoseconds since an arbitrary start, which only moves forward.
function monotonicNanoseconds() -> Number {
    return Number(kernelMonotonicNanos())
}

// `monotonicNanoseconds` as a machine word, for deadlines compared and
// subtracted on every turn of an event loop.
function monotonicTicks() -> Number {
    return Number(kernelMonotonicNanos())
}
