// Foundation — the standard library every Kira program may import by name.
//
// This is the module `import Foundation` binds. It ships with the toolchain
// rather than with any project, so a program reaches it without a path and
// without a dependency entry.
//
// The geometry and math vocabulary below follows the reference implementation's
// `Types/Maths`: the value types use the same fields and their algebra is exposed
// through conventional methods. The compiler desugars `+`, `-`, `*`, and `/` on
// a named value to `add`, `subtract`, `multiply`, and `divide` when that method
// exists, so the source can use the reference's operator notation too.

// An RGBA colour, each channel nominally in 0.0..=1.0.
//
// Foundation's rather than a graphics package's: a colour is a value type with
// no rendering in it, and putting it here is what lets a layout package, an
// app, and a backend name *one* type. Two packages each declaring their own
// `Color` produced the error this moved to fix — structs are nominal, so two
// identical declarations are two types, and passing one where the other is
// expected reads as `expects Color, found Color`.
//
// Named for its channels rather than `Color`: every declaration shares one
// namespace, and `Color` is the name a UI toolkit gives the color it draws as
// a view, as SwiftUI does.
//
// Unclamped on purpose: a channel outside the range is a value a renderer may
// still want — an HDR highlight, or an intermediate in a blend — and clamping
// here would silently change a program's arithmetic rather than its output.
struct RGBAColor {
    var r: Number = 0.0
    var g: Number = 0.0
    var b: Number = 0.0
    var a: Number = 1.0
}

// A point in a 2D coordinate space.
struct Point {
    var x: Number = 0.0
    var y: Number = 0.0
}

// A 2D extent — a width and a height.
struct Size {
    var width: Number = 0.0
    var height: Number = 0.0
}

// An axis-aligned rectangle: an origin and an extent.
struct Rect {
    var x: Number = 0.0
    var y: Number = 0.0
    var width: Number = 0.0
    var height: Number = 0.0

    function minX() -> Number {
        return x
    }

    function minY() -> Number {
        return y
    }

    function maxX() -> Number {
        return x + width
    }

    function maxY() -> Number {
        return y + height
    }

    function contains(point: borrow Point) -> Bool {
        return point.x >= minX() && point.x <= maxX() && point.y >= minY() && point.y <= maxY()
    }
}

// A vector in 2D space.
struct Vec2 {
    var x: Number = 0.0
    var y: Number = 0.0

    function add(other: borrow Vec2) -> Vec2 {
        return Vec2(x + other.x, y + other.y)
    }

    function subtract(other: borrow Vec2) -> Vec2 {
        return Vec2(x - other.x, y - other.y)
    }

    function multiply(scale: Number) -> Vec2 {
        return Vec2(x * scale, y * scale)
    }

    function divide(scale: Number) -> Vec2 {
        return Vec2(x / scale, y / scale)
    }

    function dot(other: borrow Vec2) -> Number {
        return x * other.x + y * other.y
    }

    function length() -> Number {
        return sqrt(dot(self))
    }

    function normalize() -> Vec2 {
        let value = length()
        if value == 0.0 {
            return Vec2()
        }
        return divide(value)
    }
}

// A vector in 3D space.
struct Vec3 {
    var x: Number = 0.0
    var y: Number = 0.0
    var z: Number = 0.0

    function add(other: borrow Vec3) -> Vec3 {
        return Vec3(x + other.x, y + other.y, z + other.z)
    }

    function subtract(other: borrow Vec3) -> Vec3 {
        return Vec3(x - other.x, y - other.y, z - other.z)
    }

    function multiply(scale: Number) -> Vec3 {
        return Vec3(x * scale, y * scale, z * scale)
    }

    function divide(scale: Number) -> Vec3 {
        return Vec3(x / scale, y / scale, z / scale)
    }

    function dot(other: borrow Vec3) -> Number {
        return x * other.x + y * other.y + z * other.z
    }

    function cross(other: borrow Vec3) -> Vec3 {
        return Vec3(y * other.z - z * other.y, z * other.x - x * other.z, x * other.y - y * other.x)
    }

    function length() -> Number {
        return sqrt(dot(self))
    }

    function normalize() -> Vec3 {
        let value = length()
        if value == 0.0 {
            return Vec3()
        }
        return divide(value)
    }
}

// A vector in 4D space.
struct Vec4 {
    var x: Number = 0.0
    var y: Number = 0.0
    var z: Number = 0.0
    var w: Number = 0.0

    function add(other: borrow Vec4) -> Vec4 {
        return Vec4(x + other.x, y + other.y, z + other.z, w + other.w)
    }

    function subtract(other: borrow Vec4) -> Vec4 {
        return Vec4(x - other.x, y - other.y, z - other.z, w - other.w)
    }

    function multiply(scale: Number) -> Vec4 {
        return Vec4(x * scale, y * scale, z * scale, w * scale)
    }

    function divide(scale: Number) -> Vec4 {
        return Vec4(x / scale, y / scale, z / scale, w / scale)
    }

    function dot(other: borrow Vec4) -> Number {
        return x * other.x + y * other.y + z * other.z + w * other.w
    }

    function length() -> Number {
        return sqrt(dot(self))
    }

    function normalize() -> Vec4 {
        let value = length()
        if value == 0.0 {
            return Vec4()
        }
        return divide(value)
    }
}

// A row-major 4x4 matrix, defaulting to the identity.
struct Mat4 {
    var m00: Number = 1.0
    var m01: Number = 0.0
    var m02: Number = 0.0
    var m03: Number = 0.0
    var m10: Number = 0.0
    var m11: Number = 1.0
    var m12: Number = 0.0
    var m13: Number = 0.0
    var m20: Number = 0.0
    var m21: Number = 0.0
    var m22: Number = 1.0
    var m23: Number = 0.0
    var m30: Number = 0.0
    var m31: Number = 0.0
    var m32: Number = 0.0
    var m33: Number = 1.0

    function multiply(other: borrow Mat4) -> Mat4 {
        return Mat4 {
            m00: m00 * other.m00 + m01 * other.m10 + m02 * other.m20 + m03 * other.m30,
            m01: m00 * other.m01 + m01 * other.m11 + m02 * other.m21 + m03 * other.m31,
            m02: m00 * other.m02 + m01 * other.m12 + m02 * other.m22 + m03 * other.m32,
            m03: m00 * other.m03 + m01 * other.m13 + m02 * other.m23 + m03 * other.m33,
            m10: m10 * other.m00 + m11 * other.m10 + m12 * other.m20 + m13 * other.m30,
            m11: m10 * other.m01 + m11 * other.m11 + m12 * other.m21 + m13 * other.m31,
            m12: m10 * other.m02 + m11 * other.m12 + m12 * other.m22 + m13 * other.m32,
            m13: m10 * other.m03 + m11 * other.m13 + m12 * other.m23 + m13 * other.m33,
            m20: m20 * other.m00 + m21 * other.m10 + m22 * other.m20 + m23 * other.m30,
            m21: m20 * other.m01 + m21 * other.m11 + m22 * other.m21 + m23 * other.m31,
            m22: m20 * other.m02 + m21 * other.m12 + m22 * other.m22 + m23 * other.m32,
            m23: m20 * other.m03 + m21 * other.m13 + m22 * other.m23 + m23 * other.m33,
            m30: m30 * other.m00 + m31 * other.m10 + m32 * other.m20 + m33 * other.m30,
            m31: m30 * other.m01 + m31 * other.m11 + m32 * other.m21 + m33 * other.m31,
            m32: m30 * other.m02 + m31 * other.m12 + m32 * other.m22 + m33 * other.m32,
            m33: m30 * other.m03 + m31 * other.m13 + m32 * other.m23 + m33 * other.m33
        }
    }

    function translate(offset: borrow Vec3) -> Mat4 {
        return self * Mat4 { m03: offset.x, m13: offset.y, m23: offset.z }
    }

    function scale(amount: borrow Vec3) -> Mat4 {
        return self * Mat4 { m00: amount.x, m11: amount.y, m22: amount.z }
    }

    function rotate(axis: borrow Vec3, radians: Number) -> Mat4 {
        let rotation = quaternionFromAxisAngle(axis, radians)
        let matrix = rotation.toMat4()
        return self * matrix
    }

    // The sixteen entries, row by row.
    function rowMajor() -> [Number] {
        return [
            m00, m01, m02, m03,
            m10, m11, m12, m13,
            m20, m21, m22, m23,
            m30, m31, m32, m33
        ]
    }

    // The sixteen entries, column by column: what a shader's float4x4 reads.
    function columnMajor() -> [Number] {
        return [
            m00, m10, m20, m30,
            m01, m11, m21, m31,
            m02, m12, m22, m32,
            m03, m13, m23, m33
        ]
    }
}

// A perspective camera's lens: a vertical field of view in radians, the width
// over the height, and the near and far planes' distances.
struct Perspective {
    let fieldOfView: Number
    let aspect: Number
    let near: Number
    let far: Number
}

// The projection of a camera looking down -z, onto a depth range of zero at
// the near plane to one at the far, as Metal, Vulkan and Direct3D clip.
function mat4Perspective(lens: borrow Perspective) -> Mat4 {
    let focal = 1 / tan(lens.fieldOfView / 2)
    let depth = lens.near - lens.far
    return Mat4 {
        m00: focal / lens.aspect,
        m11: focal,
        m22: lens.far / depth,
        m23: lens.near * lens.far / depth,
        m32: -1,
        m33: 0
    }
}

// The matrix whose entries, row by row, are the sixteen `values`.
function mat4RowMajor(values: borrow [Number]) -> Mat4 {
    return Mat4 {
        m00: values[0],
        m01: values[1],
        m02: values[2],
        m03: values[3],
        m10: values[4],
        m11: values[5],
        m12: values[6],
        m13: values[7],
        m20: values[8],
        m21: values[9],
        m22: values[10],
        m23: values[11],
        m30: values[12],
        m31: values[13],
        m32: values[14],
        m33: values[15]
    }
}

// The 4x4 identity matrix.
function mat4Identity() -> Mat4 {
    return Mat4()
}

// A quaternion used for rotations. The identity is the default so a zero-field
// construction is useful as a neutral rotation and as the zero-length fallback.
struct Quaternion {
    var x: Number = 0.0
    var y: Number = 0.0
    var z: Number = 0.0
    var w: Number = 1.0

    function multiply(other: borrow Quaternion) -> Quaternion {
        return Quaternion(
            w * other.x + x * other.w + y * other.z - z * other.y,
            w * other.y - x * other.z + y * other.w + z * other.x,
            w * other.z + x * other.y - y * other.x + z * other.w,
            w * other.w - x * other.x - y * other.y - z * other.z
        )
    }

    function length() -> Number {
        return sqrt(x * x + y * y + z * z + w * w)
    }

    function normalize() -> Quaternion {
        let value = length()
        if value == 0.0 {
            return Quaternion()
        }
        return Quaternion(x / value, y / value, z / value, w / value)
    }

    function toMat4() -> Mat4 {
        let q = normalize()
        let xx = q.x * q.x
        let yy = q.y * q.y
        let zz = q.z * q.z
        let xy = q.x * q.y
        let xz = q.x * q.z
        let yz = q.y * q.z
        let wx = q.w * q.x
        let wy = q.w * q.y
        let wz = q.w * q.z

        return Mat4 {
            m00: 1.0 - 2.0 * (yy + zz),
            m01: 2.0 * (xy - wz),
            m02: 2.0 * (xz + wy),
            m10: 2.0 * (xy + wz),
            m11: 1.0 - 2.0 * (xx + zz),
            m12: 2.0 * (yz - wx),
            m20: 2.0 * (xz - wy),
            m21: 2.0 * (yz + wx),
            m22: 1.0 - 2.0 * (xx + yy)
        }
    }
}

function mat4Translate(offset: borrow Vec3) -> Mat4 {
    return mat4Identity().translate(offset)
}

function mat4Scale(amount: borrow Vec3) -> Mat4 {
    return mat4Identity().scale(amount)
}

function mat4Rotate(axis: borrow Vec3, radians: Number) -> Mat4 {
    return mat4Identity().rotate(axis, radians)
}

// A rotation about one axis, counterclockwise looking down the axis toward
// the origin.
function mat4RotateX(radians: Number) -> Mat4 {
    let c = cos(radians)
    let s = sin(radians)
    return Mat4 { m11: c, m12: 0.0 - s, m21: s, m22: c }
}

function mat4RotateY(radians: Number) -> Mat4 {
    let c = cos(radians)
    let s = sin(radians)
    return Mat4 { m00: c, m02: s, m20: 0.0 - s, m22: c }
}

function mat4RotateZ(radians: Number) -> Mat4 {
    let c = cos(radians)
    let s = sin(radians)
    return Mat4 { m00: c, m01: 0.0 - s, m10: s, m11: c }
}

// The decimal a float is written as, its shortest round-trip digits. The
// binary value's eighteen-digit expansion would carry noise that can push a
// sum like `1000 + 0.1` past the mantissa.
function geometryNumber(value: Number) -> Number { return value }

// A right-handed projection into OpenGL's clip space: depth -1 at the near
// plane, 1 at the far one.
function mat4Perspective(
    fieldOfViewY: Number,
    aspect: Number,
    nearPlane: Number,
    farPlane: Number
) -> Mat4 {
    // In decimal, so the matrix holds the nearest float to each exact term
    // rather than the sum of each step's float rounding.
    let near = geometryNumber(nearPlane)
    let far = geometryNumber(farPlane)
    let halfAngle = geometryNumber(fieldOfViewY) * Number("0.5")
    let f = Number(1) / tan(halfAngle)
    let depth = near - far
    return Mat4 {
        m00: Number(f / geometryNumber(aspect)),
        m11: Number(f),
        m22: Number((far + near) / depth),
        m23: Number((Number(2) * far * near) / depth),
        m32: -1.0,
        m33: 0.0
    }
}

// A right-handed view: the camera at `eye` looks down its -Z toward `target`.
function mat4LookAt(eye: borrow Vec3, target: borrow Vec3, up: borrow Vec3) -> Mat4 {
    let forward = eye.subtract(target).normalize()
    let right = up.cross(forward).normalize()
    let correctedUp = forward.cross(right)
    return Mat4 {
        m00: right.x,
        m01: right.y,
        m02: right.z,
        m03: 0.0 - right.dot(eye),
        m10: correctedUp.x,
        m11: correctedUp.y,
        m12: correctedUp.z,
        m13: 0.0 - correctedUp.dot(eye),
        m20: forward.x,
        m21: forward.y,
        m22: forward.z,
        m23: 0.0 - forward.dot(eye)
    }
}

function quaternionFromAxisAngle(axis: borrow Vec3, radians: Number) -> Quaternion {
    let normalizedAxis = axis.normalize()
    let halfAngle = radians * 0.5
    let s = sin(halfAngle)
    return Quaternion(
        normalizedAxis.x * s,
        normalizedAxis.y * s,
        normalizedAxis.z * s,
        cos(halfAngle)
    )
}

// These helpers are kept as small, portable Foundation implementations for
// callers that need a deterministic approximation rather than the compiler's
// full-precision floating-point primitives. The geometry above uses the exact
// functions in Math.kira: `sqrtApprox` stops after eight Newton steps, which
// is far from the root once a value is in the thousands.
function sqrtApprox(value: Number) -> Number {
    if value <= 0.0 {
        return 0.0
    }

    var estimate = value
    for index in 0..8 {
        estimate = 0.5 * (estimate + value / estimate)
    }
    return estimate
}

function sinApprox(radians: Number) -> Number {
    let x = wrapRadians(radians)
    let x2 = x * x
    let x3 = x2 * x
    let x5 = x3 * x2
    let x7 = x5 * x2
    return x - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0
}

function cosApprox(radians: Number) -> Number {
    let x = wrapRadians(radians)
    let x2 = x * x
    let x4 = x2 * x2
    let x6 = x4 * x2
    return 1.0 - x2 / 2.0 + x4 / 24.0 - x6 / 720.0
}

function tanApprox(radians: Number) -> Number {
    return sinApprox(radians) / cosApprox(radians)
}

// The angles every rotation is measured against.
namespace Angle {
    let pi = 3.141592653589793
    let fullTurn = 6.283185307179586
    // One degree in radians, for formats that author rotations in degrees.
    let degree = 0.017453292519943295
}

function wrapRadians(radians: Number) -> Number {
    var value = radians
    while value > Angle.pi { value -= Angle.fullTurn }
    while value < -Angle.pi { value += Angle.fullTurn }
    return value
}
