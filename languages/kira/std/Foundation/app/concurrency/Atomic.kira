// How an atomic operation orders the memory accesses around it, as C11
// spells it. The ordering is written at the call -- `atomicAdd(counter, 1,
// .Relaxed)` -- since the machine instruction fixes it.
//
//     Relaxed                 atomic, ordering nothing else
//     Acquire                 later accesses stay after this read
//     Release                 earlier accesses stay before this write
//     AcquireRelease          both, for a read-modify-write
//     SequentiallyConsistent  one order every thread agrees on
enum MemoryOrder {
    Relaxed
    Acquire
    Release
    AcquireRelease
    SequentiallyConsistent
}
