// Compile-time counterparts to the runtime helpers below: the macros in
// `DeriveSerde.kira` run these while expanding, so there is one place that
// knows how each shape travels, however deeply arrays nest.

// The helpers both macros generate calls to live in `SerdeText.kira`, beside
// this file: they are the same code for every derived type, and only the format
// they read and write is described here.
//
// The five functions below are the macros' own shared logic: classifying a
// type text, spelling an annotation for one, and writing or reading a value of
// one. They run at compile time, take and return plain values, and recurse for
// nested arrays — so there is one place that knows how each shape travels,
// however deeply it nests, instead of one copy per position that names it.

// The integer spelling `text` names, or `""` when it names none. The tag an
// integer writes and the check a reader applies come from here, so the eight
// spellings are listed once.
comptime function __kira_serde_int_tag(text: borrow String) -> String {
    let scalarNames: [String] = ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64"]
    for sname in scalarNames {
        if text == sname {
            return sname
        }
    }
    return ""
}

// The decimal spelling `text` names, or `""` when it names none. A `Number`
// or a sized decimal writes its spelling around its decimal text — `UN8(7)`,
// `Number(0.25)` — so a reader checks the tag and the conversion range-checks
// the value before building the field.
comptime function __kira_serde_number_tag(text: borrow String) -> String {
    let decimalNames: [String] = ["Number", "UNumber", "N8", "N16", "N32", "UN8", "UN16", "UN32"]
    for dname in decimalNames {
        if text == dname {
            return dname
        }
    }
    return ""
}

// Whether a value of the type `text` reads as can be generated: scalars,
// nested arrays of the same, and single identifiers addressed by name through
// generated `serialize_`/`deserialize_` calls. Generics, qualified names, and
// function types answer false — the generated code could not name what they
// mean — and the caller reports them with the span only it has.
comptime function __kira_serde_ok(text: borrow String) -> Bool {
    var t: String = text.trim()
    if t.startsWith("[") {
        if t.endsWith("]") == false {
            return false
        }
        return __kira_serde_ok(t.substring(1, t.count - 1).trim())
    }
    if __kira_serde_int_tag(t) != "" {
        return true
    }
    if __kira_serde_number_tag(t) != "" {
        return true
    }
    if t == "Float" {
        return true
    }
    if t == "F32" {
        return true
    }
    if t == "Bool" {
        return true
    }
    if t == "String" {
        return true
    }
    if t == "CBool" {
        return true
    }
    if t.contains("<") {
        return false
    }
    if t.contains("(") {
        return false
    }
    if t.contains(")") {
        return false
    }
    if t.contains(",") {
        return false
    }
    if t.contains(":") {
        return false
    }
    if t.contains(".") {
        return false
    }
    if t.contains(" ") {
        return false
    }
    if t.contains("[") {
        return false
    }
    if t.contains("]") {
        return false
    }
    if t == "" {
        return false
    }
    return true
}

// The annotation syntax for the type `text` reads as: a plain name splices
// directly, and an array nests. Only called on text `__kira_serde_ok`
// accepted, so every name here resolves where the annotation lands.
comptime function __kira_serde_ann(text: borrow String) -> Syntax {
    var t: String = text.trim()
    if t.startsWith("[") {
        var inner: Syntax = __kira_serde_ann(t.substring(1, t.count - 1).trim())
        return quote { [#{inner}] }
    }
    return quote { #{Identifier { text = t }} }
}

// Statements serializing the value `value` reads as — of the type `typeText`
// reads as — appended to the string `target` names. Scalars append one piece;
// an array appends its brackets around one element per turn, recursing for the
// element. Only called on text `__kira_serde_ok` accepted.
comptime function __kira_serde_write_into(
    typeText: borrow String,
    value: Syntax,
    target: borrow Syntax,
    stem: borrow String
) -> Syntax {
    var t: String = typeText.trim()
    var tag: String = __kira_serde_int_tag(t)
    if tag != "" {
        return quote { #{target} = #{target} + #{tag} + "(" + String(#{value}) + ")" }
    }
    var decimalTag: String = __kira_serde_number_tag(t)
    if decimalTag != "" {
        return quote { #{target} = #{target} + #{decimalTag} + "(" + String(#{value}) + ")" }
    }
    if t == "Float" {
        return quote { #{target} = #{target} + __kira_serde_float(#{value}) }
    }
    if t == "F32" {
        return quote { #{target} = #{target} + __kira_serde_float32(#{value}) }
    }
    if t == "Bool" {
        return quote { #{target} = #{target} + String(#{value}) }
    }
    if t == "CBool" {
        return quote { #{target} = #{target} + String(#{value}) }
    }
    if t == "String" {
        return quote { #{target} = #{target} + "\"" + __kira_serde_escape(#{value}) + "\"" }
    }
    if t.startsWith("[") {
        var inner: String = t.substring(1, t.count - 1).trim()
        var nest: String = stem + "n"
        var wrote: Syntax = __kira_serde_write_into(
            inner,
            quote { #{Identifier { text = "__e" + stem }} },
            target,
            nest
        )
        return quote {
            #{target} = #{target} + "["
            var #{Identifier { text = "__n" + stem }}: Number = 0
            for #{Identifier { text = "__e" + stem }} in #{value} {
                if #{Identifier { text = "__n" + stem }} != 0 {
                    #{target} = #{target} + ","
                }
                #{wrote}
                #{Identifier { text = "__n" + stem }} = #{Identifier { text = "__n" + stem }} + 1
            }
            #{target} = #{target} + "]"
        }
    }
    return quote { #{target} = #{target} + #{Identifier { text = "serialize_" + t }}(#{value}) }
}

// Statements reading one value of the type `typeText` reads as out of the
// string `source` reads as, binding it to the name `result` carries. Scalars
// bind one conversion; an array carves its elements out of the brackets and
// recurses for each. Only called on text `__kira_serde_ok` accepted.
comptime function __kira_serde_read_value(
    typeText: borrow String,
    source: Syntax,
    result: String,
    stem: borrow String
) -> Syntax {
    var t: String = typeText.trim()
    var ann: Syntax = __kira_serde_ann(t)
    var tag: String = __kira_serde_int_tag(t)
    if tag != "" {
        if t == "U64" {
            return quote {
                let #{Identifier { text = result }}: #{ann} = U64(
                    __kira_deser_tagged_uint(#{source}, "U64")
                )
            }
        }
        return quote {
            let #{Identifier { text = result }}: #{ann} = #{Identifier { text = t }}(
                __kira_deser_tagged_int(#{source}, #{tag})
            )
        }
    }
    var decimalTag: String = __kira_serde_number_tag(t)
    if decimalTag != "" {
        return quote {
            let #{Identifier { text = result }}: #{ann} = #{Identifier { text = t }}(
                __kira_deser_tagged_number(#{source}, #{decimalTag})
            )
        }
    }
    if t == "Float" {
        return quote { let #{Identifier { text = result }}: #{ann} = __kira_deser_float(#{source}) }
    }
    if t == "F32" {
        return quote {
            let #{Identifier { text = result }}: #{ann} = __kira_deser_float32(#{source})
        }
    }
    if t == "Bool" {
        return quote { let #{Identifier { text = result }}: #{ann} = __kira_deser_bool(#{source}) }
    }
    if t == "String" {
        return quote {
            let #{Identifier { text = result }}: #{ann} = __kira_deser_unquote(#{source})
        }
    }
    if t.startsWith("[") {
        var inner: String = t.substring(1, t.count - 1).trim()
        var nest: String = stem + "n"
        var read: Syntax = __kira_serde_read_value(
            inner,
            quote { #{Identifier { text = "__e" + stem }} },
            "__v" + nest,
            nest
        )
        return quote {
            let #{Identifier { text = "__a" + stem }} = #{source}
            var #{Identifier { text = "__o" + stem }}: #{ann} = []
            var #{Identifier { text = "__p" + stem }}: Number = 1
            while #{Identifier { text = "__p" + stem }} < #{Identifier { text = "__a" + stem }}.count - 1 {
                let #{Identifier { text = "__end" + stem }}: Number = __kira_deser_scan(
                    #{Identifier { text = "__a" + stem }},
                    #{Identifier { text = "__p" + stem }}
                )
                if #{Identifier { text = "__end" + stem }} == #{Identifier { text = "__p" + stem }} {
                    #{Identifier { text = "__p" + stem }} = __kira_deser_trap(
                        #{Identifier { text = "__a" + stem }}
                    )
                }
                let #{Identifier { text = "__e" + stem }}: String = #{Identifier { text = "__a" + stem }}.substring(
                    #{Identifier { text = "__p" + stem }},
                    #{Identifier { text = "__end" + stem }}
                )
                #{read}
                #{Identifier { text = "__o" + stem }}.append(#{Identifier { text = "__v" + nest }})
                #{Identifier { text = "__p" + stem }} = #{Identifier { text = "__end" + stem }}
                if #{Identifier { text = "__a" + stem }}.charAt(
                    #{Identifier { text = "__p" + stem }}
                ) == 44 {
                    #{Identifier { text = "__p" + stem }} = #{Identifier { text = "__p" + stem }} + 1
                    if #{Identifier { text = "__a" + stem }}.charAt(
                        #{Identifier { text = "__p" + stem }}
                    ) == 93 {
                        #{Identifier { text = "__p" + stem }} = __kira_deser_trap(
                            #{Identifier { text = "__a" + stem }}
                        )
                    }
                }
            }
            if #{Identifier { text = "__a" + stem }}.charAt(
                #{Identifier { text = "__p" + stem }}
            ) != 93 {
                #{Identifier { text = "__p" + stem }} = __kira_deser_trap(
                    #{Identifier { text = "__a" + stem }}
                )
            }
            let #{Identifier { text = result }}: #{ann} = #{Identifier { text = "__o" + stem }}
        }
    }
    return quote {
        let #{Identifier { text = result }}: #{ann} = #{Identifier { text = "deserialize_" + t }}(
            #{source}
        )
    }
}

// The reader and writer helpers Foundation's Serde derives generate calls to.
//
// Beside the macros rather than inside them: a generated function is emitted
// once per derived type, and these are the same code for every one of them. The
// wire format itself is described where the macros are, in `DeriveSerde.kira`.
//
// Every name here carries a reserved prefix — `__kira_deser_` for the reading
// half, `__kira_serde_` for the writing half — so a program that derives Serde
// cannot collide with them.
//
// Malformed input traps on every backend, naming the text it could not read.
// A value either round-trips or the program stops; there is no partial parse
// and no sentinel.

function __kira_deser_trap(s: borrow String) -> Number {
    printError("not a serialized value: " + s)
    runtimeTrap()
}

function __kira_deser_trap_str(s: borrow String) -> String {
    printError("not a serialized value: " + s)
    runtimeTrap()
}

// Where `part` first appears in `s`, trapping when it does not.
function __kira_deser_find(s: borrow String, part: borrow String) -> Number {
    match s.indexOf(part) {
        Some(at) -> return Number(at)
        None -> return __kira_deser_trap(s)
    }
}

// Scan forward from `start` over one field VALUE and return the exclusive end
// index — the position of the top-level `,` or `}` that terminates it.
// Depth-aware, so a nested value carrying its own delimiters is consumed
// whole: a struct's braces, an array's brackets, an enum payload's parentheses,
// or a quoted region. A scalar has no brackets and stops at the first
// delimiter, which is why one scanner serves every field type.
//
// One counter for all three bracket kinds rather than one each: values nest
// properly, so every opener the scan passes has its closer before the value
// ends. Malformed input still traps deterministically — just further along,
// where the structure no longer parses — because every path out of the value
// runs through a range check downstream.
function __kira_deser_scan(s: borrow String, start: Number) -> Number {
    var pos: Number = start
    var depth: Number = 0
    // Inside a quoted value every byte is content, delimiters included: a
    // `String` holding `,` or `}` is written as itself, and a scanner that read
    // it as structure would end the field early and parse the rest of the text
    // as fields. A `\` skips the byte after it, which is what makes a `\"`
    // inside a value stay inside it.
    var quoted: Bool = false
    let n: Number = s.count
    while pos < n {
        let c: Number = s.charAt(pos)
        if quoted {
            match c {
                92 -> pos = pos + 1
                34 -> quoted = false
                else -> {}
            }
        } else {
            match c {
                34 -> quoted = true
                123, 91, 40 -> depth = depth + 1
                125, 93, 41 -> {
                    // `,` and `}` end a struct field's scan and `,` and `]` an
                    // array element's; one scanner serves both because a value
                    // never holds the other's closer at depth zero — brackets
                    // are tracked, so a `]` here closes the array being read
                    // and a `}` closes the struct. A `)` at depth zero is
                    // malformed input, and falling through to keep scanning
                    // ends it at a range trap downstream rather than a wrong
                    // value here.
                    if depth > 0 {
                        depth = depth - 1
                    } else if c != 41 {
                        return pos
                    }
                }
                44 -> {
                    if depth == 0 {
                        return pos
                    }
                }
                else -> {}
            }
        }
        pos = pos + 1
    }
    return pos
}

// Parse a signed decimal integer, trapping on empty text, a lone `-`, or any
// non-digit byte. A negative value accumulates downward: the most negative
// Number has no positive counterpart to negate.
function __kira_deser_int(s: borrow String) -> Number {
    let n: Number = s.count
    if n == 0 {
        return __kira_deser_trap(s)
    }
    let neg = s.charAt(0) == 45
    let start = neg ? 1 : 0
    if start >= n {
        return __kira_deser_trap(s)
    }
    var acc: Number = 0
    for i in start..n {
        let d: Number = s.charAt(i)
        var digit: Number = 0
        if d < 48 {
            digit = __kira_deser_trap(s)
        } else {
            if d > 57 {
                digit = __kira_deser_trap(s)
            } else {
                digit = d - 48
            }
        }
        acc = neg ? acc * 10 - digit : acc * 10 + digit
    }
    return acc
}

// Parse a Bool from exactly "true" / "false"; trap on anything else.
function __kira_deser_bool(s: borrow String) -> Bool {
    if s == "true" {
        return true
    }
    if s == "false" {
        return false
    }
    return __kira_deser_trap(s) == 0
}

// Strip the surrounding `"` from a serialized String value and undo the
// escapes the writer applied; trap when the quotes are absent or an escape is
// not one this format defines.
//
// The escapes are the format's whole answer to a value that contains its own
// delimiters: without them a `String` holding `"`, `,`, or `}` ends the field
// early and the rest of the value is read as structure. That is silent
// corruption — the parse succeeds and answers something else — which is the
// one failure a wire format must not have.
function __kira_deser_unquote(s: borrow String) -> String {
    let n: Number = s.count
    if n < 2 {
        return __kira_deser_trap_str(s)
    }
    if s.charAt(0) != 34 {
        return __kira_deser_trap_str(s)
    }
    if s.charAt(n - 1) != 34 {
        return __kira_deser_trap_str(s)
    }
    return __kira_deser_unescape(s.substring(1, n - 1))
}

// Undo one escaped body: `\"`, `\\`, `\n`, `\r`, `\t`, and `\0`. Any other
// escape is malformed input and traps, because a reader that passed an unknown
// escape through would answer with text nothing wrote.
function __kira_deser_unescape(s: borrow String) -> String {
    var out: String = ""
    var i: Number = 0
    let n: Number = s.count
    while i < n {
        let c: Number = s.charAt(i)
        if c != 92 {
            out = out + s.substring(i, i + 1)
            i = i + 1
        } else {
            if i + 1 >= n {
                return __kira_deser_trap_str(s)
            }
            match s.charAt(i + 1) {
                34 -> out = out + "\""
                92 -> out = out + "\\"
                110 -> out = out + "\n"
                114 -> out = out + "\r"
                116 -> out = out + "\t"
                48 -> out = out + encodedScalar(0)
                else -> return __kira_deser_trap_str(s)
            }
            i = i + 2
        }
    }
    return out
}

// A `Float` as the exact bits it is: `Float(0x` and sixteen hex digits.
//
// Not a decimal rendering: `String(0.1)` is a reading of the value, and reading
// it back is a second rounding, so a decimal wire format loses the low bits of
// almost every float and cannot carry a signed zero, an infinity, or a NaN
// payload at all. The bits are the value, and they read back as themselves.
// The tag names which width they are the bits of, so a 32-bit float is never
// read as a 64-bit one.
function __kira_serde_float(v: Float) -> String {
    return "Float(0x" + __kira_serde_hex(floatToBits(v), 16) + ")"
}

// An `F32` the same way, in eight digits: the value narrows to 32 bits first,
// because the same bits mean a different number at the two widths.
function __kira_serde_float32(v: Float) -> String {
    return "F32(0x" + __kira_serde_hex(Number(floatToBits32(v)), 8) + ")"
}

// `digits` hex digits of `bits`, most significant first, zero-padded.
function __kira_serde_hex(bits: Number, digits: Number) -> String {
    let table: String = "0123456789abcdef"
    var out: String = ""
    for offset in 0..digits {
        let index = digits - offset - 1
        let shift: Number = Number(index * 4)
        let nibble: Number = Number((bits >> shift) & Number(15))
        out = out + table.substring(nibble, nibble + 1)
    }
    return out
}

// The `Float` a `Float(0x`-prefixed sixteen-digit body names, trapping on
// anything that is not exactly that: a missing tag, a wrong length, or a byte
// that is not a hex digit is a number nothing wrote.
function __kira_deser_float(s: borrow String) -> Float {
    if s.count != 25 {
        return bitsToFloat(Number(__kira_deser_trap(s)))
    }
    if s.substring(0, 8) != "Float(0x" {
        return bitsToFloat(Number(__kira_deser_trap(s)))
    }
    if s.charAt(24) != 41 {
        return bitsToFloat(Number(__kira_deser_trap(s)))
    }
    return bitsToFloat(__kira_deser_hex(s.substring(6, 24), 16))
}

// The `F32` a `F32(0x`-prefixed eight-digit body names, the same contract at
// the other width.
function __kira_deser_float32(s: borrow String) -> Float {
    if s.count != 15 {
        return bitsToFloat(Number(__kira_deser_trap(s)))
    }
    if s.substring(0, 6) != "F32(0x" {
        return bitsToFloat(Number(__kira_deser_trap(s)))
    }
    if s.charAt(14) != 41 {
        return bitsToFloat(Number(__kira_deser_trap(s)))
    }
    return bitsToFloat32(UN32(__kira_deser_hex(s.substring(4, 14), 8)))
}

// The unsigned integer a `tag(`-prefixed decimal body names: `Number(7)`.
//
// The unsigned path exists because the signed one cannot reach the top half of
// the `Number` range: digits past `Number`'s maximum trap a signed accumulation, and
// a `Number` holding such a value is still a value that must round-trip. Digits
// only — a `-` is not an unsigned value — and the accumulation traps past the
// maximum exactly as the signed one traps past its own.
function __kira_deser_tagged_uint(s: borrow String, tag: borrow String) -> Number {
    let open: Number = tag.count + 1
    if s.count < open + 2 {
        return Number(__kira_deser_trap(s))
    }
    if s.substring(0, tag.count) != tag {
        return Number(__kira_deser_trap(s))
    }
    if s.charAt(tag.count) != 40 {
        return Number(__kira_deser_trap(s))
    }
    if s.charAt(s.count - 1) != 41 {
        return Number(__kira_deser_trap(s))
    }
    let body: String = s.substring(open, s.count - 1)
    if body.count == 0 {
        return Number(__kira_deser_trap(s))
    }
    var acc: Number = Number(0)
    for i in 0..body.count {
        let d: Number = Number(body.charAt(i))
        if (d < 48) || (d > 57) {
            return Number(__kira_deser_trap(s))
        }
        acc = acc * Number(10) + Number(d - 48)
    }
    return acc
}

// The integer a `tag(`-prefixed decimal body names: `Number(42)`, `UN8(7)`.
//
// The tag is checked exactly, and the digits are range-checked by what the
// caller builds from the answer: a value that does not fit the caller's width
// traps in the narrowing conversion, so `UN8(300)` never becomes a `UN8`. A tag
// naming another width is a different type's value and is refused here rather
// than range-checked into this one.
function __kira_deser_tagged_int(s: borrow String, tag: borrow String) -> Number {
    let open: Number = tag.count + 1
    if s.count < open + 2 {
        return __kira_deser_trap(s)
    }
    if s.substring(0, tag.count) != tag {
        return __kira_deser_trap(s)
    }
    if s.charAt(tag.count) != 40 {
        return __kira_deser_trap(s)
    }
    if s.charAt(s.count - 1) != 41 {
        return __kira_deser_trap(s)
    }
    return __kira_deser_int(s.substring(open, s.count - 1))
}

// The decimal a tagged decimal text names: `UN8(7)` read with the tag `UN8`.
// Traps on a missing or different tag or missing parentheses; the caller's
// conversion range-checks the value for its width.
function __kira_deser_tagged_number(s: borrow String, tag: borrow String) -> Number {
    let open: Number = tag.count + 1
    if s.count < open + 2 {
        return __kira_deser_trap(s)
    }
    if s.substring(0, tag.count) != tag {
        return __kira_deser_trap(s)
    }
    if s.charAt(tag.count) != 40 {
        return __kira_deser_trap(s)
    }
    if s.charAt(s.count - 1) != 41 {
        return __kira_deser_trap(s)
    }
    return Number(s.substring(open, s.count - 1))
}

// The bits a `0x` body names. Traps on a missing prefix, a wrong length, or a
// byte that is not a hex digit: a float read from malformed text would be a
// number nothing wrote.
function __kira_deser_hex(s: borrow String, digits: Number) -> Number {
    if s.count != digits + 2 {
        return Number(__kira_deser_trap(s))
    }
    if s.charAt(0) != 48 {
        return Number(__kira_deser_trap(s))
    }
    if s.charAt(1) != 120 {
        return Number(__kira_deser_trap(s))
    }
    var bits: Number = Number(0)
    for index in 2..s.count {
        let c: Number = Number(s.charAt(index))
        var value: Number = 0
        if c >= 48 && c <= 57 {
            value = c - 48
        } else {
            if c >= 97 && c <= 102 {
                value = c - 87
            } else {
                value = __kira_deser_trap(s)
            }
        }
        bits = (bits << Number(4)) | Number(value)
    }
    return bits
}

// The escaped body of a `String` value, without its surrounding quotes.
//
// Only the bytes that would otherwise be read as structure, plus the ones no
// single line can carry: a quote, a backslash, the two line endings, a tab, and
// a NUL. Everything else is written through, so ordinary text stays readable on
// the wire.
function __kira_serde_escape(s: borrow String) -> String {
    var out: String = ""
    for i in 0..s.count {
        match s.charAt(i) {
            34 -> out = out + "\\\""
            92 -> out = out + "\\\\"
            10 -> out = out + "\\n"
            13 -> out = out + "\\r"
            9 -> out = out + "\\t"
            0 -> out = out + "\\0"
            else -> out = out + s.substring(i, i + 1)
        }
    }
    return out
}
