// Foundation's `@Derive(Serializable)` macro, written in pure Kira beside
// Derive.kira's Equatable / Clone.
//
//   @Derive(Serializable) generates both `serialize_<Type>` and
//   `deserialize_<Type>` together: one direction without the other leaves a
//   value that can be written and never read back, so the seven-derive surface
//   keeps them as one macro.
//
// WIRE FORMAT (v1, compact, deterministic, single line):
//
//   TypeName{field1:VALUE,field2:VALUE,...}
//
// An integer writes its spelling around its digits (`U8(7)`, `I32(-5)`). A
// Float is `Float(0x` and the sixteen hex digits of its exact bits, an F32 is
// `F32(0x` and eight. A Bool is `true` or `false`. A String field is its
// escaped text wrapped in `"`. An array is its elements in brackets,
// nested to any depth. A nested derived struct recurses inline, so
// `from:Point{id:TabId(U32(7))}` sits inside its parent braces. A distinct
// writes its name around its representation the same way: `TabId(U32(7))`.
//
// An ENUM is written as `TypeName.Variant`, with a payload in parentheses after
// it (`Tool.Rotate`, `Note.Rank(Int(42))`, `Slot.At(Point{x:Int(1),y:Int(2)})`).
// The variant is named, never numbered.
//
// Deserialization is the exact inverse. It validates the leading `TypeName{`,
// then for each field in declaration order locates `label:`, carves the value
// with a depth-aware scan, and converts by field type: an integer tag must name
// the field width exactly and the digits are range-checked, so `U8(300)`
// traps and `Int(5)` in a `U8` field is refused. It consumes the full input:
// trailing text after the closing `}` traps, as do a field out of order and a
// duplicate or unknown label. Malformed input traps on every backend, through
// `__kira_deser_trap`, which names the text it could not read. A value either
// round-trips or the program stops. There is no partial parse.
//
// ROUND-TRIP LAW: for every value `v` of a supported type,
// `deserialize_T(serialize_T(v))` equals `v` field-wise.
//
// A String value is escaped: `\"`, `\\`, `\n`, `\r`, `\t`, and `\0`. Everything
// else is written as itself, and the scanner that carves a field out treats a
// quoted region as content, so a value holding `,` or `}` round-trips.
//
// LIMITATIONS (v1):
//   * Generic, optional, qualified, and function field types are refused,
//     exactly as Equatable and Clone refuse them. Arrays are supported.
//   * An enum payload follows the same field rules.
//
// The helpers both macros generate calls to live in `SerdeText.kira`, beside
// this file: they are the same code for every derived type, and only the format
// they read and write is described here.

// The macros share of compile-time logic lives in `SerdeText.kira` beside the
// runtime helpers: classifying a type text, spelling an annotation, and
// writing or reading a value of one. One place knows how each shape travels.

comptime macro Serializable {
    kind { derive }
    appliesTo { struct enum distinct }
    expand(target: Declaration) -> Syntax {
        // A distinct type writes its name around the representation it is:
        // `TabId(Int(7))`, not `7` and not `TabId{raw=7}`. The outer tag is
        // the nominal identity the language keeps apart from the
        // representation, and the inner value is written exactly as it would
        // be anywhere else — including its own tag — so one reader shape
        // serves every position. A reader that wanted a `TabId` asked
        // `deserialize_TabId` for one.
        if target.kind == .Distinct {
            var rep: String = "Int"
            for field in target.fields {
                let scalarNames: [String] = ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64", "Float", "F32", "Bool", "String"]
                for sname in scalarNames {
                    if field.type == sname {
                        rep = sname
                    }
                }
                if field.type == "RawPtr" {
                    deriveUnsupported(
                        "Derive(Serializable): a distinct type over `RawPtr` has nothing to write — an opaque foreign word is an address, and it means nothing in another process or another run",
                        at: target.syntax
                    )
                }
            }
            var repValue: Syntax = quote { String(v.raw) }
            if rep == "Float" {
                repValue = quote { __kira_serde_float(v.raw) }
            }
            if rep == "F32" {
                repValue = quote { __kira_serde_float32(v.raw) }
            }
            if rep == "String" {
                repValue = quote { "\"" + __kira_serde_escape(v.raw) + "\"" }
            }
            var repIntTag: String = ""
            let scalarNames: [String] = ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64"]
            for sname in scalarNames {
                if rep == sname {
                    repIntTag = sname
                }
            }
            if repIntTag != "" {
                repValue = quote { #{repIntTag} + "(" + String(v.raw) + ")" }
            }
            var __ser: Syntax = quote {
                function serialize_#{target.name}(v: borrow #{target.name}) -> String {
                    return #{target.name.asString()} + "(" + #{repValue} + ")"
                }
            }
            return joinSyntax([__ser, __kira_serde_deserialize_fn(target)], "\n")
        }
        // An enum writes the variant it holds by NAME — `Tool.Rotate` — and a
        // payload in parentheses after it. The name is the point: an ordinal
        // would make the wire format depend on declaration ORDER, so inserting a
        // variant would silently re-read every value ever written.
        if target.kind == .Enum {
            var arms: [Syntax] = []
            for variant in target.fields {
                var head: String = target.name.asString() + "." + variant.name.asString()
                if variant.type == "" {
                    arms.append(quote { #{variant.name} -> return #{head} })
                } else {
                    // An integer payload is tagged exactly as a field is.
                    var intTag: String = ""
                    let scalarNames: [String] = ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64"]
                    for sname in scalarNames {
                        if variant.type == sname {
                            intTag = sname
                        }
                    }
                    var payloadText: String = variant.type.trim()
                    var isArrayPayload: Bool = payloadText.startsWith("[") && payloadText.endsWith(
                        "]"
                    )
                    if isArrayPayload {
                        if __kira_serde_ok(payloadText) == false {
                            deriveUnsupported(
                                "Derive(Serializable): variant `" + variant.name.asString() + "` has payload type `" + payloadText + "`, which Serde cannot generate: array elements are an integer width, a decimal, Float, F32, Bool, String, a nested array thereof, or a named type with its own `serialize_` function",
                                at: variant.syntax
                            )
                        } else {
                            var stem: String = "p" + variant.name.asString()
                            arms.append(
                                quote {
                                    #{variant.name}(payload) -> {
                                        var #{Identifier { text = "__s" + stem }}: String = ""
                                        #{__kira_serde_write_into(payloadText, quote { payload }, quote { #{Identifier { text = "__s" + stem }} }, stem)}
                                        return #{head} + "(" + #{Identifier { text = "__s" + stem }} + ")"
                                    }
                                }
                            )
                        }
                    } else if intTag != "" {
                        arms.append(
                            quote {
                                #{variant.name}(
                                    payload
                                ) -> return #{head} + "(" + #{intTag} + "(" + String(payload) + "))"
                            }
                        )
                    // A float payload writes its bits, exactly as a float field
                    // does: a decimal rendering is a second rounding on the way
                    // back.
                    } else {
                        match variant.type {
                            "Float" -> {
                                arms.append(
                                    quote {
                                        #{variant.name}(
                                            payload
                                        ) -> return #{head} + "(" + __kira_serde_float(
                                            payload
                                        ) + ")"
                                    }
                                )
                            }
                            "F32" -> {
                                arms.append(
                                    quote {
                                        #{variant.name}(
                                            payload
                                        ) -> return #{head} + "(" + __kira_serde_float32(
                                            payload
                                        ) + ")"
                                    }
                                )
                            }
                            "Bool" -> {
                                arms.append(
                                    quote {
                                        #{variant.name}(payload) -> return #{head} + "(" + String(
                                            payload
                                        ) + ")"
                                    }
                                )
                            }
                            // `CBool` is a Foundation-level convention, not a compiler
                            // type with a tagged grammar form, so it keeps the
                            // rendering it always had: the reader takes it back through
                            // the same `deserialize_CBool` it always did.
                            "CBool" -> {
                                arms.append(
                                    quote {
                                        #{variant.name}(payload) -> return #{head} + "(" + String(
                                            payload
                                        ) + ")"
                                    }
                                )
                            }
                            "String" -> {
                                arms.append(
                                    quote {
                                        #{variant.name}(
                                            payload
                                        ) -> return #{head} + "(\"" + __kira_serde_escape(
                                            payload
                                        ) + "\")"
                                    }
                                )
                            }
                            else -> {
                                arms.append(
                                    quote {
                                        #{variant.name}(
                                            payload
                                        ) -> return #{head} + "(" + serialize_#{variant.type.asSyntax()}(
                                            payload
                                        ) + ")"
                                    }
                                )
                            }
                        }
                    }
                }
            }
            var __ser: Syntax = quote {
                function serialize_#{target.name}(v: borrow #{target.name}) -> String {
                    match v {
                        #{arms}
                    }
                }
            }
            return joinSyntax([__ser, __kira_serde_deserialize_fn(target)], "\n")
        }
        var stmts: [Syntax] = []
        stmts.append(quote { var out: String = #{target.name.asString()} })
        stmts.append(quote { out = out + "{" })
        var idx: Int = 0
        for field in target.fields {
            var joined: String = ""
            for id in field.type.asSyntax().identifiers() {
                joined = joined + id.asString()
            }
            if joined != field.type {
                var asArray: String = field.type.trim()
                if asArray.startsWith("[") == false || asArray.endsWith("]") == false {
                    deriveUnsupported(
                        "Derive(Serializable): field has an unsupported generic type; only an integer width, a decimal, Float, F32, Bool, String, an array thereof, or a nested @Derive(Serializable) struct field are supported",
                        at: target.syntax
                    )
                }
            }
            var sep: String = ""
            if idx != 0 {
                sep = ","
            }
            var fieldText: String = field.type.trim()
            var isArrayField: Bool = fieldText.startsWith("[") && fieldText.endsWith("]")
            if isArrayField {
                if __kira_serde_ok(fieldText) == false {
                    deriveUnsupported(
                        "Derive(Serializable): field `" + field.name.asString() + "` has type `" + fieldText + "`, which Serde cannot generate: array elements are an integer width, a decimal, Float, F32, Bool, String, a nested array thereof, or a named type with its own `serialize_` function",
                        at: field.syntax
                    )
                } else {
                    stmts.append(quote { out = out + #{sep} + #{field.name.asString()} + ":" })
                    stmts.append(
                        __kira_serde_write_into(
                            fieldText,
                            quote { v.#{field.name} },
                            quote { out },
                            "f" + field.name.asString()
                        )
                    )
                }
                idx = idx + 1
            } else {
                // An integer writes its spelling around its digits — `U8(7)`, not
                // `7` — so the value carries its width and a reader range-checks
                // it before building the field.
                var intTag: String = ""
                let scalarNames: [String] = ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64"]
                for sname in scalarNames {
                    if field.type == sname {
                        intTag = sname
                    }
                }
                if intTag == "" {
                    intTag = __kira_serde_number_tag(field.type)
                }
                if intTag != "" {
                    stmts.append(
                        quote {
                            out = out + #{sep} + #{field.name.asString()} + ":" + #{intTag} + "(" + String(
                                v.#{field.name}
                            ) + ")"
                        }
                    )
                // A float writes its bits, not a rendering of them: see
                // `__kira_serde_float`.
                } else {
                    match field.type {
                        "Float" -> {
                            stmts.append(
                                quote {
                                    out = out + #{sep} + #{field.name.asString()} + ":" + __kira_serde_float(
                                        v.#{field.name}
                                    )
                                }
                            )
                        }
                        "F32" -> {
                            stmts.append(
                                quote {
                                    out = out + #{sep} + #{field.name.asString()} + ":" + __kira_serde_float32(
                                        v.#{field.name}
                                    )
                                }
                            )
                        }
                        "Bool" -> {
                            stmts.append(
                                quote {
                                    out = out + #{sep} + #{field.name.asString()} + ":" + String(
                                        v.#{field.name}
                                    )
                                }
                            )
                        }
                        "String" -> {
                            stmts.append(
                                quote {
                                    out = out + #{sep} + #{field.name.asString()} + ":" + "\"" + __kira_serde_escape(
                                        v.#{field.name}
                                    ) + "\""
                                }
                            )
                        }
                        else -> {
                            stmts.append(
                                quote {
                                    out = out + #{sep} + #{field.name.asString()} + ":" + serialize_#{field.type.asSyntax()}(
                                        v.#{field.name}
                                    )
                                }
                            )
                        }
                    }
                }
            }
            idx = idx + 1
        }
        stmts.append(quote { out = out + "}" })
        stmts.append(quote { return out })
        var __ser: Syntax = quote {
            function serialize_#{target.name}(v: borrow #{target.name}) -> String {
                #{stmts}
            }
        }
        return joinSyntax([__ser, __kira_serde_deserialize_fn(target)], "\n")
    }
}
