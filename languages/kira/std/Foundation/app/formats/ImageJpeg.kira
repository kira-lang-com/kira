// JPEG.
//
// A JPEG is a list of segments — quantisation tables, Huffman tables, a frame
// header, then one or more scans — and the scans hold the picture as 8x8 blocks
// of frequency coefficients rather than pixels. Reading one is four stages, and
// this file is the first: walking the segments and remembering what they say.
// `JpegScan.kira` reads the entropy-coded blocks, and `JpegPixels.kira` turns
// coefficients into samples and samples into RGBA.
//
// What is read: sequential Huffman frames, `SOF0` and `SOF1`, at eight bits per
// sample, one component or three, with any sampling factors and any restart
// interval. That is what every camera, phone and exporter writes by default.
// A progressive frame, an arithmetic-coded one, a lossless one, or twelve-bit
// samples are `UnknownFormat`: those are different encodings that happen to
// share a container, not damage.

// One colour channel of the frame, at its own resolution.
//
// A JPEG subsamples: the two chroma channels are usually stored at half width
// and half height, because vision resolves colour more coarsely than
// brightness. So a component carries both the size it was stored at (`width`,
// `height`) and the size its storage was rounded up to (`stride`, `rows`), and
// the last stage stretches it back to the frame's size.
struct JpegComponent {
    var identifier: Number = 0
    var horizontal: Number = 1
    var vertical: Number = 1
    var quantTable: Number = 0
    // Absolute places in the decoder's one table array: DC tables occupy 0..3
    // and AC tables 4..7, so a decode step needs no second array to pick from.
    var dcTable: Number = 0
    var acTable: Number = 4
    var width: Number = 0
    var height: Number = 0
    var stride: Number = 0
    var rows: Number = 0
    var samples: [UN8] = []
    // The DC coefficient is stored as a difference from the previous block's,
    // so decoding is stateful across a whole scan.
    var predictor: Number = 0
    // How much wider and taller the frame is than this component, and where the
    // stretch has got to. `line0` and `line1` are the two source rows the
    // current output row is a blend of, `step` how far between them it lies,
    // and `sourceRow` how many source rows have been passed.
    var horizontalScale: Number = 1
    var verticalScale: Number = 1
    var loresWidth: Number = 0
    var step: Number = 0
    var sourceRow: Number = 0
    var line0: Number = 0
    var line1: Number = 0
    // The stretched row, reused for every output row.
    var line: [UN8] = []
}

class JpegDecoder {
    var data: [UN8] = []
    var pos: Number = 0
    var width: Number = 0
    var height: Number = 0
    var components: [JpegComponent] = []
    // Four tables of 64 entries each, held in natural order rather than the
    // zigzag order they arrive in, so a coefficient and its divisor are found
    // by the same index.
    var quantTables: [[Number]] = []
    // DC tables at 0..3, AC tables at 4..7.
    var huffmanTables: [HuffmanCode] = []
    var zigzag: [Number] = []
    var restartInterval: Number = 0
    var todo: Number = 0
    // The entropy reader: bits taken most significant first, and what stopped
    // it. A marker inside the scan ends the data, and everything after it reads
    // as zero bits.
    var bitBuffer: Number = 0
    var bitCount: Number = 0
    var pendingMarker: Number = 0
    var noMoreData: Bool = false
    // One block's coefficients and one block's intermediate transform, held on
    // the decoder so that decoding a block allocates nothing.
    var block: [Number] = []
    var workspace: [Number] = []
    var scanComponents: [Number] = []
    var maxHorizontal: Number = 1
    var maxVertical: Number = 1
    var mcusX: Number = 0
    var mcusY: Number = 0
    // Three components named R, G and B rather than 1, 2 and 3 are already
    // colour, and converting them as if they were luma and chroma would be
    // wrong twice.
    var directRgb: Bool = false
    // The RGBA the components' stretched rows are folded into.
    var output: [UN8] = []
    var stopped: Bool = false
    var failure: ImageFailure = .Malformed

    function fail(reason: ImageFailure) {
        self.stopped = true
        self.failure = reason
    }

    function bigEndian16(at: Number) -> Number {
        return (Number(self.data[at]) << 8) | Number(self.data[at + 1])
    }

    // The next segment marker, skipping any fill bytes before it. Zero means
    // the bytes ran out.
    function nextMarker() -> Number {
        while self.pos < self.data.count && Number(self.data[self.pos]) != 255 {
            self.pos = self.pos + 1
        }
        while self.pos < self.data.count && Number(self.data[self.pos]) == 255 {
            self.pos = self.pos + 1
        }
        if self.pos >= self.data.count {
            return 0
        }
        let marker = Number(self.data[self.pos])
        self.pos = self.pos + 1
        return marker
    }

    // A frame header this decoder does not read: progressive, lossless,
    // hierarchical, or arithmetic-coded.
    function namesAnotherEncoding(marker: Number) -> Bool {
        if marker == 194 || marker == 195 || marker == 204 {
            return true
        }
        if marker >= 197 && marker <= 199 {
            return true
        }
        if marker >= 201 && marker <= 203 {
            return true
        }
        return marker >= 205 && marker <= 207
    }

    function prepare() {
        for table in 0..4 {
            self.quantTables.append(filled(64, 0))
        }
        for slot in 0..8 {
            self.huffmanTables.append(HuffmanCode { counts: filled(16, 0), symbols: [] })
        }
        self.zigzag = jpegZigzagOrder()
        self.block = filled(64, 0)
        self.workspace = filled(64, 0)
    }

    // The segment list, from the start-of-image to the end of the last scan.
    function readSegments() {
        if self.data.count < 2 || Number(self.data[0]) != 255 || Number(self.data[1]) != 216 {
            self.fail(.UnknownFormat)
            return
        }
        self.prepare()
        self.pos = 2
        while !self.stopped {
            let marker = self.nextMarker()
            if marker == 0 || marker == 217 {
                return
            }
            if marker == 216 || marker == 1 || (marker >= 208 && marker <= 215) {
                continue
            }
            if self.namesAnotherEncoding(marker) {
                self.fail(.UnknownFormat)
                return
            }
            if self.pos + 2 > self.data.count {
                self.fail(.Malformed)
                return
            }
            let length = self.bigEndian16(self.pos) - 2
            let body = self.pos + 2
            if length < 0 || body + length > self.data.count {
                self.fail(.Malformed)
                return
            }
            self.pos = body + length
            match marker {
                219 -> self.readQuantTables(body, length)
                196 -> self.readHuffmanTables(body, length)
                192, 193 -> self.readFrame(body, length)
                221 -> {
                    if length >= 2 {
                        self.restartInterval = self.bigEndian16(body)
                    }
                }
                218 -> self.readScan(body, length)
                else -> {}
            }
        }
    }

    function readQuantTables(body: Number, length: Number) {
        var at = body
        let end = body + length
        while at < end {
            let specifier = Number(self.data[at])
            at = at + 1
            let wide = (specifier >> 4) != 0
            let slot = specifier & 15
            let needed = wide ? 128 : 64
            if slot > 3 || at + needed > end {
                self.fail(.Malformed)
                return
            }
            for index in 0..64 {
                var value: Number = 0
                if wide {
                    value = self.bigEndian16(at)
                    at = at + 2
                } else {
                    value = Number(self.data[at])
                    at = at + 1
                }
                self.quantTables[slot][self.zigzag[index]] = value
            }
        }
    }

    function readHuffmanTables(body: Number, length: Number) {
        var at = body
        let end = body + length
        while at < end {
            let specifier = Number(self.data[at])
            at = at + 1
            let alternating = (specifier >> 4) != 0
            let slot = specifier & 15
            if slot > 3 || at + 16 > end {
                self.fail(.Malformed)
                return
            }
            var counts: [Number] = filled(16, 0)
            var total: Number = 0
            for index in 0..16 {
                counts[index] = Number(self.data[at + index])
                total = total + counts[index]
            }
            at = at + 16
            if at + total > end {
                self.fail(.Malformed)
                return
            }
            var symbols: [Number] = filled(total, 0)
            for index in 0..total {
                symbols[index] = Number(self.data[at + index])
            }
            at = at + total
            let place = alternating ? slot + 4 : slot
            self.huffmanTables[place] = HuffmanCode { counts: move counts, symbols: move symbols }
        }
    }

    // The frame header: the picture's size, and one entry per colour channel
    // saying how finely that channel was sampled.
    function readFrame(body: Number, length: Number) {
        if length < 6 {
            self.fail(.Malformed)
            return
        }
        if Number(self.data[body]) != 8 {
            self.fail(.UnknownFormat)
            return
        }
        self.height = self.bigEndian16(body + 1)
        self.width = self.bigEndian16(body + 3)
        let count = Number(self.data[body + 5])
        if self.width <= 0 || self.height <= 0 {
            self.fail(.Malformed)
            return
        }
        if count != 1 && count != 3 {
            self.fail(.UnknownFormat)
            return
        }
        if length < 6 + (count * 3) {
            self.fail(.Malformed)
            return
        }
        self.components = []
        for index in 0..count {
            let at = body + 6 + (index * 3)
            let sampling = Number(self.data[at + 1])
            let horizontal = sampling >> 4
            let vertical = sampling & 15
            let quantTable = Number(self.data[at + 2])
            if horizontal < 1 || horizontal > 4 || vertical < 1 || vertical > 4 || quantTable > 3 {
                self.fail(.Malformed)
                return
            }
            self.components.append(
                JpegComponent {
                    identifier: Number(self.data[at]),
                    horizontal: horizontal,
                    vertical: vertical,
                    quantTable: quantTable
                }
            )
        }
        self.directRgb = count == 3
            && self.components[0].identifier == 82
            && self.components[1].identifier == 71
            && self.components[2].identifier == 66
        self.allocatePlanes()
    }

    // How big each component's storage has to be: the frame in whole minimum
    // coded units, at the component's own sampling.
    function allocatePlanes() {
        self.maxHorizontal = 1
        self.maxVertical = 1
        for component in self.components {
            if component.horizontal > self.maxHorizontal {
                self.maxHorizontal = component.horizontal
            }
            if component.vertical > self.maxVertical {
                self.maxVertical = component.vertical
            }
        }
        self.mcusX = trunc((self.width + (8 * self.maxHorizontal) - 1) / (8 * self.maxHorizontal))
        self.mcusY = trunc((self.height + (8 * self.maxVertical) - 1) / (8 * self.maxVertical))
        for index in 0..self.components.count {
            let horizontal = self.components[index].horizontal
            let vertical = self.components[index].vertical
            self.components[index].width =
                trunc(((self.width * horizontal) + self.maxHorizontal - 1) / self.maxHorizontal)
            self.components[index].height =
                trunc(((self.height * vertical) + self.maxVertical - 1) / self.maxVertical)
            self.components[index].stride = self.mcusX * horizontal * 8
            self.components[index].rows = self.mcusY * vertical * 8
            self.components[index].samples = filled(
                self.components[index].stride * self.components[index].rows,
                0
            )
        }
    }
}

// The order a block's 64 coefficients are written in: out from the top-left
// corner along diagonals, so that the coefficients most often zero come last
// and a run of them can be ended with one symbol.
function jpegZigzagOrder() -> [Number] {
    return [
        0, 1, 8, 16, 9, 2, 3, 10,
        17, 24, 32, 25, 18, 11, 4, 5,
        12, 19, 26, 33, 40, 48, 41, 34,
        27, 20, 13, 6, 7, 14, 21, 28,
        35, 42, 49, 56, 57, 50, 43, 36,
        29, 22, 15, 23, 30, 37, 44, 51,
        58, 59, 52, 45, 38, 31, 39, 46,
        53, 60, 61, 54, 47, 55, 62, 63,
    ]
}

// The image a JPEG's bytes hold.
function decodeJpeg(bytes: [UN8]) -> Result<Image, ImageFailure> {
    var decoder = JpegDecoder()
    decoder.data = move bytes
    decoder.readSegments()
    if decoder.stopped {
        return .Error(decoder.failure)
    }
    if decoder.width <= 0 || decoder.components.count == 0 {
        return .Error(.Malformed)
    }
    return .Ok(decoder.assemble())
}
