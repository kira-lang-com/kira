// Building an array whose size is known before its contents are.
//
// An array grows through `append` and has no other constructor, so code that
// writes its result out of order — a PNG's interlace passes land every eighth
// pixel, a JPEG's coefficients arrive in zigzag order — has to have the whole
// array in hand before the first write. Writing that loop again at every such
// site is what this replaces.

// `count` copies of `value`. A negative count is an empty array, because a
// count is usually computed and a caller asking for fewer than none wants the
// none rather than a trap.
function filled<Element>(count: Number, value: Element) -> [Element] {
    var elements: [Element] = []
    for index in 0..Number(count) {
        elements.append(value)
    }
    return elements
}
