// Whether `scalar` is Cased and not Case_Ignorable: the letter a final
// sigma follows.
function isCasedScalar(scalar: Number) -> Bool {
    match scalar {
        0x41..0x5B, 0x61..0x7B, 0xAA, 0xB5, 0xBA, 0xC0..0xD7 -> return true
