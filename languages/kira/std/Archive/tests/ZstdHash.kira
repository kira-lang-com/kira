import Foundation

// xxHash64, the checksum Zstandard frames end with, against known values.

@Test
function xxh64OfTheEmptyInput() {
    let empty: [UN8] = []
    expect!("\(xxh64(empty))" == "17241709254077376921")
}

@Test
function xxh64OfAbc() {
    expect!("\(xxh64("abc".utf8()))" == "4952883123889572249")
}
