import Foundation

// Huffman codes for Zstandard literals: codes follow from the code lengths
// alone, in the canonical order.

// The RFC's example: weights 4, 3, 2, 0, 1, 1.
@Test
function huffmanCodesFollowTheRfcExample() {
    let lengths: [Number] = [1, 2, 3, 0, 4, 4]
    let codes = canonicalCodes(lengths, 4)
    var parts: [String] = []
    for symbol in 0..lengths.count {
        if lengths[symbol] > 0 { parts.append("\(symbol)=\(codes[symbol])/\(lengths[symbol])") }
    }
    expect!((joined(parts, " ")) == "0=1/1 1=1/2 2=1/3 4=0/4 5=1/4")
}

// Equal lengths give consecutive codes in symbol order.
@Test
function equalLengthsGiveConsecutiveCodes() {
    let lengths: [Number] = [2, 2, 2, 2]
    let codes = canonicalCodes(lengths, 2)
    expect!((joined([String(codes[0]), String(codes[1]), String(codes[2]), String(codes[3])], ",")) == "0,1,2,3")
}

// A symbol with length zero gets no code and does not shift the others.
@Test
function unusedSymbolsDoNotShiftCodes() {
    let lengths: [Number] = [0, 1, 0, 1]
    let codes = canonicalCodes(lengths, 1)
    expect!((codes[1]) == (0))
    expect!((codes[3]) == (1))
}
