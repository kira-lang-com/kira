import Foundation

// Each failure reads as one line; malformed and unsupported input name their
// kind, and file and conflict failures are their message alone.

@Test
function failuresReadAsOneLineEach() {
    expect!((archiveFailureText(ArchiveFailure.Malformed("short header"))) == "malformed: short header")
    expect!((archiveFailureText(ArchiveFailure.Unsupported("delta filter"))) == "unsupported: delta filter")
    expect!((archiveFailureText(ArchiveFailure.Files("no such file"))) == "no such file")
    expect!((archiveFailureText(ArchiveFailure.Conflict("hunk 2 does not apply"))) == "hunk 2 does not apply")
}
