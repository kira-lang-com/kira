import Foundation

// The FSE coder a Zstandard encoder writes sequences with (RFC 8878 sections
// 4.1 and 3.1.1.3.2.2): its tables are built as the reference implementation
// builds them, so the decoder's states follow.

// What encodes the symbols of one distribution.
struct FseEncoder {
    let log: Number
    // The state each slot leads to, symbol by symbol.
    let states: [Number]
    // For each symbol, what turns a state into the bits it writes and the
    // slot of the next state.
    let deltaBits: [Number]
    let deltaFind: [Number]

    // The state that starts encoding with `symbol`, writing nothing.
    function start(borrow self, symbol: Number) -> Number {
        let bits = (deltaBits[symbol] + 32768) >> 16
        let value = (bits << 16) - deltaBits[symbol]
        return states[(value >> bits) + deltaFind[symbol]]
    }

    // Writes the bits that leave `state` for `symbol`, answering the next
    // state.
    function encode(
        borrow self,
        state: Number,
        symbol: Number,
        writer: borrow mut LowBitWriter
    ) -> Number {
        let bits = (state + deltaBits[symbol]) >> 16
        writer.add(state, bits)
        return states[(state >> bits) + deltaFind[symbol]]
    }

    // Writes the last state, which the decoder reads first.
    function flush(borrow self, state: Number, writer: borrow mut LowBitWriter) {
        writer.add(state, log)
    }
}

// The encoder of the normalized distribution `counts`, which sum to
// `1 << log` with each -1 counting 1.
function fseEncoder(counts: borrow [Number], log: Number) -> FseEncoder {
    let size: Number = 1 << log
    let mask = size - 1
    let step = (size >> 1) + (size >> 3) + 3
    var symbols: [Number] = []
    for slot in 0..size { symbols.append(0) }
    // Symbols below probability one take the last slots.
    var high = size - 1
    var cumulative: [Number] = [0]
    for symbol in 0..counts.count {
        if counts[symbol] == -1 {
            cumulative.append(cumulative[symbol] + 1)
            symbols[high] = symbol
            high -= 1
        } else {
            cumulative.append(cumulative[symbol] + counts[symbol])
        }
    }
    var position: Number = 0
    for symbol in 0..counts.count {
        if counts[symbol] <= 0 { continue }
        for each in 0..counts[symbol] {
            symbols[position] = symbol
            position = (position + step) & mask
            while position > high { position = (position + step) & mask }
        }
    }
    var states: [Number] = []
    for slot in 0..size { states.append(0) }
    var next = copy cumulative
    for slot in 0..size {
        let symbol = symbols[slot]
        states[next[symbol]] = size + slot
        next[symbol] += 1
    }
    var deltaBits: [Number] = []
    var deltaFind: [Number] = []
    var total: Number = 0
    for symbol in 0..counts.count {
        let count = counts[symbol]
        match count {
            0 -> {
                deltaBits.append(((log + 1) << 16) - size)
                deltaFind.append(0)
            }
                -1, 1 -> {
                deltaBits.append((log << 16) - size)
                deltaFind.append(total - 1)
                total += 1
            }
            else -> {
                let out = log - highBit(count - 1)
                deltaBits.append((out << 16) - (count << out))
                deltaFind.append(total - count)
                total += count
            }
        }
    }
    return FseEncoder { log: log, states: states, deltaBits: deltaBits, deltaFind: deltaFind }
}
