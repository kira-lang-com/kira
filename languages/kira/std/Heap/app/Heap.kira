function allocateRaw(byteCount: Int, alignment: Int) -> RawPtr {
    return heapAllocateRaw(byteCount, alignment)
}

function freeRaw(pointer: RawPtr) {
    heapFreeRaw(pointer)
}

function readHeapWord(pointer: RawPtr) -> Int {
    return heapReadInt(pointer)
}

function writeHeapWord(pointer: RawPtr, value: Int) {
    heapWriteInt(pointer, value)
}

function readHeapByte(pointer: RawPtr) -> U8 {
    return heapReadByte(pointer)
}

function writeHeapByte(pointer: RawPtr, value: U8) {
    heapWriteByte(pointer, value)
}

function offsetHeapBytes(pointer: RawPtr, offset: Int) -> RawPtr {
    return heapOffset(pointer, offset)
}
