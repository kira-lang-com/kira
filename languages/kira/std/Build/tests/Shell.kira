import Foundation

// Shown commands: each argument is quoted so a shell reads it back as the
// same word.

@Test
function plainWordsAreShownBare() {
    expect!((shownArgument("-o")) == "-o")
}

@Test
function wordsWithSpacesAreQuoted() {
    expect!((shownArgument("a b")) == "'a b'")
}

@Test
function singleQuotesInsideWordsAreEscaped() {
    expect!((shownArgument("it's")) == "'it'\\''s'")
}

@Test
function emptyWordIsTwoQuotes() {
    expect!((shownArgument("")) == "''")
}
